from pathlib import Path
import pandas as pd

# ================= CONFIGURATION =================

INPUT_FILE = Path(
    r"C:\Users\Sunlight\Desktop\DB\DEDU\merged_4_files.xlsx"
)

OUTPUT_FILE = Path(
    r"C:\Users\Sunlight\Desktop\DB\DEDU\deduplicated.xlsx"
)

AUDIT_FILE = Path(
    r"C:\Users\Sunlight\Desktop\NET\B2B\duplicates_audit.xlsx"
)

PHONE_COLUMNS = ["Téléphone", "Mobile"]

# ================= LOAD FILE =================

df = pd.read_excel(INPUT_FILE, dtype=str)

# Remove spaces around header names only
df.columns = df.columns.astype(str).str.strip()

# Find phone columns without changing their values
column_map = {
    col.casefold(): col
    for col in df.columns
}

phone_columns = [
    column_map[name.casefold()]
    for name in PHONE_COLUMNS
    if name.casefold() in column_map
]

if not phone_columns:
    raise ValueError(
        f"Phone columns not found. Available columns: {list(df.columns)}"
    )

print("Phone columns:", phone_columns)

# ================= SCORE ROWS =================

# Preserve original order
df["_original_order"] = range(len(df))

# Count filled cells, excluding the temporary order column
df["_info_score"] = (
    df.drop(columns=["_original_order"])
    .fillna("")
    .apply(
        lambda col: col.astype(str).str.strip().ne("")
    )
    .sum(axis=1)
)

# ================= DEDUPLICATION =================

# Most complete rows first
ranked = df.sort_values(
    by="_info_score",
    ascending=False,
    kind="stable"
)

seen_numbers = set()
kept_indices = []
duplicate_indices = []

for idx, row in ranked.iterrows():

    # Compare existing phone values exactly as stored
    numbers = {
        row[col]
        for col in phone_columns
        if pd.notna(row[col]) and row[col].strip() != ""
    }

    # Keep rows with no phone number
    if not numbers:
        kept_indices.append(idx)
        continue

    # Duplicate if either phone number already exists
    if numbers.intersection(seen_numbers):
        duplicate_indices.append(idx)
    else:
        kept_indices.append(idx)
        seen_numbers.update(numbers)

# ================= PREPARE RESULTS =================

# Restore original order in the final files
result = df.loc[sorted(kept_indices)].copy()
duplicates = df.loc[duplicate_indices].copy()

# Remove temporary columns
temporary_columns = [
    "_original_order",
    "_info_score"
]

result.drop(columns=temporary_columns, inplace=True)
duplicates.drop(columns=temporary_columns, inplace=True)

# ================= SAVE FILES =================

OUTPUT_FILE.parent.mkdir(parents=True, exist_ok=True)
AUDIT_FILE.parent.mkdir(parents=True, exist_ok=True)

result.to_excel(OUTPUT_FILE, index=False)
duplicates.to_excel(AUDIT_FILE, index=False)

# ================= REPORT =================

print("\n========== DEDUPLICATION REPORT ==========")
print(f"Rows before: {len(df):,}")
print(f"Rows after: {len(result):,}")
print(f"Duplicate rows removed: {len(duplicates):,}")
print(f"Clean file: {OUTPUT_FILE}")
print(f"Duplicate audit: {AUDIT_FILE}")
print("==========================================")
