import pandas as pd
import os

# ============================================================
# INPUT FILE
# ============================================================

input_file = r"C:\Users\Sunlight\Desktop\15-09-26\MERIAME15_9\CALLADVANCE BASE TOTAL.xlsx"

output_file = os.path.splitext(input_file)[0] + "_TELEPHONE.xlsx"


# ============================================================
# COLUMNS
# ============================================================

base_columns = [
    "STE",
    "TVA",
    "NOM",
    "ADRESSE",
    "NUMERO",
    "COMPLEMENT",
    "CP",
    "VILLE"
]

phone_columns = [
    "GSM",
    "TEL1",
    "TEL2",
    "TEL3"
]


# ============================================================
# READ EXCEL
# ============================================================

df = pd.read_excel(
    input_file,
    dtype=object
)


# ============================================================
# CHECK COLUMNS
# ============================================================

required_columns = base_columns + phone_columns

missing = [
    col for col in required_columns
    if col not in df.columns
]

if missing:
    print("Missing columns:")
    print(missing)
    raise SystemExit


# ============================================================
# CREATE ONE ROW FOR EACH TELEPHONE
# ============================================================

rows = []

for _, row in df.iterrows():

    base_data = [
        row[col]
        for col in base_columns
    ]

    for phone_col in phone_columns:

        phone = row[phone_col]

        # Only ignore empty cells
        if pd.notna(phone) and phone != "":

            rows.append(
                base_data + [phone]
            )


# ============================================================
# CREATE FINAL DATAFRAME
# ============================================================

result = pd.DataFrame(
    rows,
    columns=base_columns + ["TELEPHONE"]
)


# ============================================================
# SAVE
# ============================================================

result.to_excel(
    output_file,
    index=False
)


# ============================================================
# RESULT
# ============================================================

print("=" * 60)
print("DONE")
print("=" * 60)
print(f"Input : {input_file}")
print(f"Output: {output_file}")
print(f"Telephone rows: {len(result):,}")
print("=" * 60)
