from pathlib import Path
from openpyxl import load_workbook, Workbook


# ============================================================
# CONFIGURATION
# ============================================================

INPUT_FOLDER = Path(
    r"C:\Users\Sunlight\Desktop\01-10-26\ALL DB\excel_data-PC1_TR"
)

OUTPUT_FOLDER = Path(
    r"C:\Users\Sunlight\Desktop\01-10-26\ALL DB\excel_data-PC1_TR\GSM\MERGED_OUTPUT"
)

MAX_DATA_ROWS = 1_000_000


# ============================================================
# CREATE OUTPUT FOLDER
# ============================================================

OUTPUT_FOLDER.mkdir(parents=True, exist_ok=True)


# ============================================================
# GET EXCEL FILES
# ============================================================

excel_files = sorted(
    f for f in INPUT_FOLDER.iterdir()
    if f.is_file()
    and f.suffix.lower() == ".xlsx"
    and not f.name.startswith("~$")
    and OUTPUT_FOLDER not in f.parents
)


print("=" * 70)
print("EXACT EXCEL MERGE")
print("=" * 70)
print(f"Files found: {len(excel_files):,}")
print()


# ============================================================
# VARIABLES
# ============================================================

output_number = 0
total_data_rows = 0
rows_in_current_output = 0

output_wb = None
output_ws = None
output_path = None

header = None


# ============================================================
# CREATE OUTPUT
# ============================================================

def create_output():

    global output_number
    global rows_in_current_output
    global output_wb
    global output_ws
    global output_path

    # Save previous output
    if output_wb is not None:

        output_wb.save(output_path)
        output_wb.close()

        print(
            f"   ✓ Saved {output_path.name} "
            f"→ {rows_in_current_output:,} data rows"
        )

    output_number += 1

    output_path = (
        OUTPUT_FOLDER /
        f"merged_{output_number:03d}.xlsx"
    )

    output_wb = Workbook(write_only=True)

    output_ws = output_wb.create_sheet("Data")

    # Header only once
    output_ws.append(header)

    rows_in_current_output = 0

    print()
    print(f"📁 Creating: {output_path.name}")


# ============================================================
# PROCESS FILES
# ============================================================

for file_number, file_path in enumerate(
    excel_files,
    start=1
):

    print(
        f"[{file_number}/{len(excel_files)}] "
        f"{file_path.name}"
    )

    file_rows = 0

    try:

        wb = load_workbook(
            filename=file_path,
            read_only=True,
            data_only=False
        )

        ws = wb.active

        rows = ws.iter_rows(
            values_only=True
        )

        # ----------------------------------------------------
        # READ HEADER
        # ----------------------------------------------------

        try:
            file_header = next(rows)

        except StopIteration:
            print("   ⚠ Empty worksheet")
            wb.close()
            continue


        # ----------------------------------------------------
        # FIRST FILE
        # ----------------------------------------------------

        if header is None:

            header = file_header

            create_output()


        # ----------------------------------------------------
        # MERGE ALL DATA ROWS
        # ----------------------------------------------------

        for row in rows:

            # New output when limit reached
            if rows_in_current_output >= MAX_DATA_ROWS:

                create_output()

            # IMPORTANT:
            # No filtering
            # No deduplication
            # No cleaning
            # No empty-row removal

            output_ws.append(row)

            rows_in_current_output += 1
            total_data_rows += 1
            file_rows += 1


        wb.close()

        print(
            f"   ✓ Added: {file_rows:,} rows"
        )


    except Exception as e:

        print()
        print(f"   ❌ ERROR: {file_path.name}")
        print(f"      {e}")
        print("      Continuing...")
        print()


# ============================================================
# SAVE LAST OUTPUT
# ============================================================

if output_wb is not None:

    output_wb.save(output_path)
    output_wb.close()

    print()
    print(
        f"   ✓ Saved {output_path.name} "
        f"→ {rows_in_current_output:,} data rows"
    )


# ============================================================
# FINAL RESULT
# ============================================================

print()
print("=" * 70)
print("MERGE FINISHED")
print("=" * 70)

print(f"Input files:       {len(excel_files):,}")
print(f"Total DATA rows:   {total_data_rows:,}")
print(f"Output files:      {output_number:,}")
print()
print(f"Output folder:")
print(OUTPUT_FOLDER)
print()
print("=" * 70)
print("DONE")
print("=" * 70)
