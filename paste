import pandas as pd
import re

# =========================
# FILE PATHS
# =========================

input_file = r"C:\Users\Sunlight\Desktop\your_file.xlsx"
output_file = r"C:\Users\Sunlight\Desktop\final_merged.xlsx"

# =========================
# READ FILE
# =========================

df = pd.read_excel(input_file)

df.columns = df.columns.astype(str).str.strip().str.upper()

print("Rows before:", len(df))


# =========================
# CLEAN TVA FOR CHECKING
# =========================

def clean_tva(value):
    if pd.isna(value):
        return ""

    value = str(value).strip().upper()

    # Remove .000000
    value = re.sub(r"\.0+$", "", value)

    # Remove spaces and symbols
    value = re.sub(r"[^A-Z0-9]", "", value)

    # Remove BE
    if value.startswith("BE"):
        value = value[2:]

    # Keep digits only
    value = re.sub(r"\D", "", value)

    return value


# =========================
# CLEAN GSM FOR CHECKING
# =========================

def clean_gsm(value):
    if pd.isna(value):
        return ""

    value = str(value).strip()

    value = re.sub(r"\.0+$", "", value)

    # Keep digits only
    value = re.sub(r"\D", "", value)

    # Remove Belgium prefix
    if value.startswith("0032"):
        value = value[4:]

    elif value.startswith("32"):
        value = value[2:]

    # Remove leading 0
    if value.startswith("0"):
        value = value[1:]

    return value


# =========================
# CREATE CHECK COLUMNS
# =========================

df["_TVA"] = df["TVA"].apply(clean_tva)
df["_GSM"] = df["GSM"].apply(clean_gsm)


# =========================
# CREATE GROUP KEY
# =========================

def make_key(row):

    if row["_TVA"] != "":
        return "TVA_" + row["_TVA"]

    if row["_GSM"] != "":
        return "GSM_" + row["_GSM"]

    return "ROW_" + str(row.name)


df["_KEY"] = df.apply(make_key, axis=1)


# =========================
# MERGE DIFFERENT INFORMATION
# =========================

def merge_info(series):

    values = []

    for value in series:

        if pd.isna(value):
            continue

        value = str(value).strip()

        if value == "":
            continue

        if value not in values:
            values.append(value)

    return " | ".join(values)


# Original columns only
original_columns = [
    col for col in df.columns
    if not col.startswith("_")
]


final_df = (
    df.groupby("_KEY", sort=False)[original_columns]
    .agg(merge_info)
    .reset_index(drop=True)
)


# =========================
# SAVE
# =========================

final_df.to_excel(output_file, index=False)

print("Rows after:", len(final_df))
print("Rows merged:", len(df) - len(final_df))
print("DONE")
print(output_file)
