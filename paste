# ============================================================
# 11. MERGE ALL AGGREGATED TABLES USING KBO_KEY
# ============================================================

print("\nMerging tables by KBO_KEY...")

# First table
merged = aggregated_tables[0][1]

for source_name, table in aggregated_tables[1:]:

    print("Connecting:", source_name)

    merged = merged.join(
        table,
        on="KBO_KEY",
        how="outer"
    )


# ============================================================
# 12. REMOVE ANY POSSIBLE DUPLICATE COLUMN NAMES
# ============================================================

columns = merged.columns

seen = set()
final_columns = []

for c in columns:

    if c not in seen:

        seen.add(c)
        final_columns.append(c)

    else:

        print(
            "Duplicate column detected:",
            c
        )

merged = merged.select(final_columns)


# ============================================================
# 13. MOVE KBO_KEY TO FIRST COLUMN
# ============================================================

other_columns = [
    c for c in merged.columns
    if c != "KBO_KEY"
]

merged = merged.select(
    ["KBO_KEY"] + other_columns
)


# ============================================================
# 14. NUMBER OF FINAL KBOs
# ============================================================

print("\nCounting final KBO records...")

final_count = merged.count()

print(
    "FINAL UNIQUE KBO RECORDS:",
    f"{final_count:,}"
)


# ============================================================
# 15. WRITE SPARK DATA DIRECTLY TO XLSX
# ============================================================

print("\nStarting Excel export...")

# Repartition into reasonably sized partitions.
#
# This is NOT a join/shuffle explosion anymore because
# we already have one row per KBO.
#
# Calculate approximately 200k rows per partition.
# ============================================================

target_partitions = max(
    1,
    int(final_count / 200_000) + 1
)

print(
    "Excel partitions:",
    target_partitions
)

merged = merged.repartition(target_partitions)


# ============================================================
# 16. WRITE EACH PARTITION TO EXCEL
# ============================================================

def write_partition(partition_index, iterator):

    rows = list(iterator)

    if not rows:
        return iter([])

    # IMPORTANT:
    # This list contains only ONE Spark partition,
    # not the entire dataset.

    filename = (
        output_path
        / f"KBO_MERGED_{partition_index + 1:03d}.xlsx"
    )

    workbook = xlsxwriter.Workbook(
        str(filename),
        {
            "constant_memory": True
        }
    )

    worksheet = workbook.add_worksheet("KBO")

    headers = merged.columns

    # --------------------------------------------------------
    # Header
    # --------------------------------------------------------

    for col_index, header in enumerate(headers):

        worksheet.write(
            0,
            col_index,
            header
        )

    # --------------------------------------------------------
    # Data
    # --------------------------------------------------------

    for row_index, row in enumerate(rows, start=1):

        for col_index, value in enumerate(row):

            if value is None:

                worksheet.write(
                    row_index,
                    col_index,
                    ""
                )

            else:

                worksheet.write(
                    row_index,
                    col_index,
                    str(value)
                )

    workbook.close()

    print(
        f"Created: {filename.name} "
        f"({len(rows):,} rows)"
    )

    return iter([])


# ============================================================
# EXECUTE
# ============================================================

(
    merged
    .rdd
    .mapPartitionsWithIndex(write_partition)
    .count()
)


