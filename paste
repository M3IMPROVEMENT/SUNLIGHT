import openpyxl
import re

# ============================================================
# CONFIGURATION
# ============================================================

input_file = r"C:\Users\YourName\Desktop\input.xlsx"
output_file = r"C:\Users\YourName\Desktop\TELE_SPLIT.xlsx"

TELE_COLUMN_NAME = "TELE"


# ============================================================
# SPLIT ONLY
# ============================================================

def split_tele(value):

    # Empty cell -> keep empty
    if value is None:
        return [""]

    text = str(value)

    if text.strip() == "":
        return [""]

    # --------------------------------------------------------
    # ONLY SPLIT
    # We do NOT modify the phone numbers.
    # --------------------------------------------------------

    # Common separators between separate phone numbers
    parts = re.split(
        r"\s+[\/;|,]\s*"
        r"|\s*\/\s*"
        r"|\s*;\s*"
        r"|\s*\|\s*"
        r"|\s*,\s*"
        r"(?<=\d)\s+(?=\+?\d)",
        text
    )

    # Remove only empty pieces created by separators
    parts = [p for p in parts if p != ""]

    if not parts:
        return [text]

    return parts


# ============================================================
# OPEN INPUT
# ============================================================

print("Opening Excel...")

wb_in = openpyxl.load_workbook(
    input_file,
    read_only=True,
    data_only=False
)

# ============================================================
# OUTPUT
# ============================================================

wb_out = openpyxl.Workbook(write_only=True)

total_original_rows = 0
total_output_rows = 0
total_split_rows = 0


for ws_in in wb_in.worksheets:

    print()
    print("Processing:", ws_in.title)

    ws_out = wb_out.create_sheet(title=ws_in.title)

    rows = ws_in.iter_rows()

    # Header
    header = next(rows)
    header_values = [cell.value for cell in header]

    # Find TELE column
    tele_index = None

    for i, value in enumerate(header_values):

        if value is not None and str(value).strip().upper() == "TELE":
            tele_index = i
            break

    if tele_index is None:

        print("TELE column not found.")

        ws_out.append(header_values)

        for row in rows:
            ws_out.append([cell.value for cell in row])

        continue

    print("TELE column found.")

    # Write header
    ws_out.append(header_values)

    # ========================================================
    # PROCESS ROWS
    # ========================================================

    for row in rows:

        total_original_rows += 1

        values = [cell.value for cell in row]

        tele_value = values[tele_index]

        numbers = split_tele(tele_value)

        # ----------------------------------------------------
        # ONE NUMBER / EMPTY
        # ----------------------------------------------------

        if len(numbers) == 1:

            values[tele_index] = numbers[0]

            ws_out.append(values)

            total_output_rows += 1

        # ----------------------------------------------------
        # MULTIPLE NUMBERS
        # ----------------------------------------------------

        else:

            total_split_rows += 1

            for number in numbers:

                new_row = values.copy()

                # IMPORTANT:
                # Put the ORIGINAL number here.
                # No cleaning whatsoever.
                new_row[tele_index] = number

                ws_out.append(new_row)

                total_output_rows += 1

        if total_original_rows % 10000 == 0:

            print(
                f"Processed: {total_original_rows:,} | "
                f"Output: {total_output_rows:,}"
            )


# ============================================================
# SAVE
# ============================================================

print()
print("Saving...")

wb_out.save(output_file)

wb_in.close()

print()
print("==========================================")
print("FINISHED")
print("==========================================")
print(f"Original rows : {total_original_rows:,}")
print(f"Output rows   : {total_output_rows:,}")
print(f"Rows split    : {total_split_rows:,}")
print()
print("NO CLEANING")
print("NO DEDUPLICATION")
print("NO NUMBER MODIFICATION")
print("NO DIGITS REMOVED")
print()
print(output_file)
