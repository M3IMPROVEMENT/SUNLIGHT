import pandas as pd
import re

# ============================================================
# SETTINGS
# ============================================================

INPUT_FILE = r"C:\Users\YourName\Desktop\input.xlsx"
OUTPUT_FILE = r"C:\Users\YourName\Desktop\tele_cleaned.xlsx"

TELE_COLUMN = "TELE"


# ============================================================
# CLEAN ONE PHONE NUMBER
# ============================================================

def clean_phone(phone):
    if pd.isna(phone):
        return ""

    phone = str(phone).strip()

    # Remove Excel decimal artifact
    phone = re.sub(r"\.0$", "", phone)

    # Keep digits only
    digits = re.sub(r"\D", "", phone)

    if not digits:
        return ""

    # Belgium international formats
    # 0032XXXXXXXXX -> 0XXXXXXXXX
    if digits.startswith("0032"):
        digits = "0" + digits[4:]

    # 32XXXXXXXXX -> 0XXXXXXXXX
    elif digits.startswith("32") and len(digits) in (10, 11):
        digits = "0" + digits[2:]

    return digits


# ============================================================
# EXTRACT MULTIPLE PHONES FROM ONE CELL
# ============================================================

def extract_phones(value):

    if pd.isna(value):
        return []

    text = str(value).strip()

    if not text:
        return [""]

    # Remove Excel .0
    text = re.sub(r"\.0\b", "", text)

    # Normalize separators
    text = text.replace("\n", " ")
    text = text.replace("\r", " ")
    text = text.replace("\t", " ")

    phones = []

    # --------------------------------------------------------
    # 1. Find international Belgian numbers
    # --------------------------------------------------------

    pattern_international = (
        r"(?:\+32|0032|32)"
        r"[\s./-]*"
        r"4"
        r"(?:[\s./-]*\d){8}"
    )

    matches = re.findall(pattern_international, text)

    for match in matches:
        cleaned = clean_phone(match)

        if cleaned:
            phones.append(cleaned)

    # --------------------------------------------------------
    # 2. Find local Belgian mobile numbers
    # --------------------------------------------------------

    pattern_local = (
        r"\b04"
        r"(?:[\s./-]*\d){8}"
        r"\b"
    )

    matches = re.findall(pattern_local, text)

    for match in matches:
        cleaned = clean_phone(match)

        if cleaned:
            phones.append(cleaned)

    # --------------------------------------------------------
    # Remove duplicates inside SAME cell
    # --------------------------------------------------------

    phones = list(dict.fromkeys(phones))

    # --------------------------------------------------------
    # If nothing found, try treating entire cell as one phone
    # --------------------------------------------------------

    if not phones:

        cleaned = clean_phone(text)

        if cleaned:
            phones.append(cleaned)

    return phones


# ============================================================
# READ FILE
# ============================================================

print("Reading file...")

df = pd.read_excel(
    INPUT_FILE,
    dtype={TELE_COLUMN: "string"}
)

print(f"Rows before processing: {len(df):,}")


# ============================================================
# CHECK TELE COLUMN
# ============================================================

if TELE_COLUMN not in df.columns:
    raise ValueError(
        f"Column '{TELE_COLUMN}' does not exist.\n\n"
        f"Available columns:\n{list(df.columns)}"
    )


# ============================================================
# SPLIT ROWS
# ============================================================

new_rows = []

split_count = 0

for index, row in df.iterrows():

    value = row[TELE_COLUMN]

    # Empty TELE -> KEEP ROW
    if pd.isna(value) or str(value).strip() == "":
        new_rows.append(row.copy())
        continue

    phones = extract_phones(value)

    # Nothing detected -> KEEP ORIGINAL ROW
    if not phones:
        new_rows.append(row.copy())
        continue

    # --------------------------------------------------------
    # ONE PHONE
    # --------------------------------------------------------

    if len(phones) == 1:

        new_row = row.copy()
        new_row[TELE_COLUMN] = phones[0]

        new_rows.append(new_row)

    # --------------------------------------------------------
    # MULTIPLE PHONES
    # --------------------------------------------------------

    else:

        split_count += 1

        print(
            f"Row {index + 2} split: "
            f"{phones}"
        )

        for phone in phones:

            new_row = row.copy()
            new_row[TELE_COLUMN] = phone

            new_rows.append(new_row)


# ============================================================
# CREATE NEW DATAFRAME
# ============================================================

result = pd.DataFrame(
    new_rows,
    columns=df.columns
)

# Reset index
result.reset_index(drop=True, inplace=True)


# ============================================================
# SAVE
# ============================================================

result.to_excel(
    OUTPUT_FILE,
    index=False,
    engine="openpyxl"
)


# ============================================================
# SUMMARY
# ============================================================

print()
print("=" * 60)
print("DONE")
print("=" * 60)

print(f"Original rows       : {len(df):,}")
print(f"Final rows           : {len(result):,}")
print(f"Rows containing 2+   : {split_count:,}")
print(f"Rows added by split  : {len(result) - len(df):,}")
print(f"Output file          : {OUTPUT_FILE}")

print("=" * 60)
