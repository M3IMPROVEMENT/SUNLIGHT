import pandas as pd
import re

# ============================================================
# SETTINGS
# ============================================================

INPUT_FILE = r"C:\Users\YourName\Desktop\input.xlsx"
OUTPUT_FILE = r"C:\Users\YourName\Desktop\TELE_split.xlsx"

TELE_COLUMN = "TELE"


# ============================================================
# FIND BELGIAN PHONE NUMBERS
# ============================================================

def find_phone_numbers(value):

    if pd.isna(value):
        return [""]

    text = str(value).strip()

    if not text:
        return [""]

    # --------------------------------------------------------
    # Belgian GSM / telephone patterns
    #
    # We allow spaces, dots, hyphens and parentheses
    # INSIDE the number.
    #
    # Examples:
    # +32 476 12 34 56
    # 0032 476 12 34 56
    # 32 476 12 34 56
    # 0476 12 34 56
    # 0476123456
    # --------------------------------------------------------

    phone_pattern = re.compile(
        r"""
        (?<!\d)

        (?:
            # International format
            (?:\+|00)?32
            [\s.\-()]*
            \d
            (?:[\s.\-()]*\d){8}

            |

            # Belgian national format
            0
            [\s.\-()]*
            \d
            (?:[\s.\-()]*\d){8}
        )

        (?!\d)
        """,
        re.VERBOSE
    )

    matches = list(phone_pattern.finditer(text))

    # --------------------------------------------------------
    # No multiple numbers detected
    # Keep original value EXACTLY.
    # --------------------------------------------------------

    if len(matches) == 0:
        return [text]

    # --------------------------------------------------------
    # Extract matches
    # --------------------------------------------------------

    phones = []

    for match in matches:

        phone = match.group(0).strip()

        if phone and phone not in phones:
            phones.append(phone)

    # --------------------------------------------------------
    # IMPORTANT:
    #
    # If only ONE number was detected, keep the ORIGINAL CELL.
    # We don't clean or modify it.
    # --------------------------------------------------------

    if len(phones) == 1:
        return [text]

    # --------------------------------------------------------
    # Multiple numbers detected.
    #
    # Return each number as its own row.
    # --------------------------------------------------------

    return phones


# ============================================================
# READ EXCEL
# ============================================================

print("Reading Excel file...")

df = pd.read_excel(
    INPUT_FILE,
    dtype={TELE_COLUMN: str}
)

print(f"Original rows: {len(df):,}")


# ============================================================
# CHECK COLUMN
# ============================================================

if TELE_COLUMN not in df.columns:
    raise ValueError(
        f"Column '{TELE_COLUMN}' was not found."
    )


# ============================================================
# SPLIT ROWS
# ============================================================

new_rows = []

multiple_phone_rows = 0
total_new_phone_rows = 0

for _, row in df.iterrows():

    phones = find_phone_numbers(row[TELE_COLUMN])

    # --------------------------------------------------------
    # Multiple phones found
    # --------------------------------------------------------

    if len(phones) > 1:

        multiple_phone_rows += 1

        for phone in phones:

            new_row = row.copy()

            # ONLY change TELE
            new_row[TELE_COLUMN] = phone

            new_rows.append(new_row)

            total_new_phone_rows += 1

    # --------------------------------------------------------
    # One or zero phone
    # Keep original row unchanged
    # --------------------------------------------------------

    else:

        new_rows.append(row.copy())


# ============================================================
# CREATE RESULT
# ============================================================

result = pd.DataFrame(
    new_rows,
    columns=df.columns
)


# ============================================================
# SAVE
# ============================================================

result.to_excel(
    OUTPUT_FILE,
    index=False,
    engine="openpyxl"
)


# ============================================================
# SUMMARY
# ============================================================

print()
print("=" * 60)
print("DONE")
print("=" * 60)

print(f"Original rows              : {len(df):,}")
print(f"Rows containing multiple   : {multiple_phone_rows:,}")
print(f"Final rows                 : {len(result):,}")

print()
print("Nothing deleted.")
print("No deduplication.")
print("No TELE normalization.")
print("No TYPE column.")
print()
print(f"Output: {OUTPUT_FILE}")
