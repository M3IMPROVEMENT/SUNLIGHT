# ============================================================
# 9. DENOMINATION
# ============================================================

print("Reading DENOMINATION...")

count = 0

for row in read_csv_rows(DENOMINATION_FILE):

    kbo = normalize_kbo(
        row.get("EntityNumber", "")
    )

    name = clean_text(
        row.get("Denomination", "")
    )

    if not kbo or not name:
        continue

    type_name = clean_text(
        row.get("TypeOfDenomination", "")
    )

    # Prefer Type 001
    if type_name == "001":

        cur.execute("""
            INSERT INTO denomination
            (kbo, denomination)
            VALUES (?, ?)

            ON CONFLICT(kbo)
            DO UPDATE SET
                denomination = excluded.denomination
        """, (
            kbo,
            name
        ))

    else:

        cur.execute("""
            INSERT OR IGNORE INTO denomination
            (kbo, denomination)
            VALUES (?, ?)
        """, (
            kbo,
            name
        ))

    count += 1

    if count % 100000 == 0:

        conn.commit()

        print(
            f"  {count:,} denomination records processed"
        )


conn.commit()

print(f"Denomination done: {count:,}")
print()


# ============================================================
# 10. ADDRESS
# ============================================================

print("Reading ADDRESS...")

count = 0

for row in read_csv_rows(ADDRESS_FILE):

    kbo = normalize_kbo(
        row.get("EntityNumber", "")
    )

    if not kbo:
        continue


    # --------------------------------------------------------
    # STREET
    # --------------------------------------------------------

    street = clean_text(
        row.get("StreetFR", "")
    )

    if not street:

        street = clean_text(
            row.get("StreetNL", "")
        )


    # --------------------------------------------------------
    # MUNICIPALITY
    # --------------------------------------------------------

    municipality = clean_text(
        row.get("MunicipalityFR", "")
    )

    if not municipality:

        municipality = clean_text(
            row.get("MunicipalityNL", "")
        )


    # --------------------------------------------------------
    # POSTAL CODE
    # --------------------------------------------------------

    postal_code = clean_text(
        row.get("PostCode", "")
    )

    if not postal_code:

        postal_code = clean_text(
            row.get("PostalCode", "")
        )


    # --------------------------------------------------------
    # HOUSE NUMBER
    # --------------------------------------------------------

    house_number = clean_text(
        row.get("HouseNumber", "")
    )


    # --------------------------------------------------------
    # BOX
    # --------------------------------------------------------

    box = clean_text(
        row.get("Box", "")
    )


    # --------------------------------------------------------
    # CP EXTRACTION
    #
    # If the official CP field is empty,
    # try to find a 4-digit CP inside the address.
    # --------------------------------------------------------

    postal_code = extract_cp(
        postal_code,
        street,
        municipality
    )


    # --------------------------------------------------------
    # KEEP FIRST ADDRESS
    # --------------------------------------------------------

