import pandas as pd
from pathlib import Path


# ============================================================
# 1. YOUR TWO EXCEL FILES
# ============================================================

file1 = Path(
    r"C:\Users\Sunlight\Desktop\15-09-26\MERIAME15_9\Nouveau dossier\FILE1.xlsx"
)

file2 = Path(
    r"C:\Users\Sunlight\Desktop\15-09-26\MERIAME15_9\Nouveau dossier\FILE2.xlsx"
)


# ============================================================
# 2. OUTPUT FILE
# ============================================================

output_file = file1.parent / "MERGED_WITH_SOURCE.xlsx"


# ============================================================
# 3. READ THE TWO FILES
# ============================================================

df1 = pd.read_excel(file1, dtype=object)
df2 = pd.read_excel(file2, dtype=object)


# ============================================================
# 4. ADD SOURCE COLUMN
# ============================================================

df1["SOURCE"] = file1.name
df2["SOURCE"] = file2.name


# ============================================================
# 5. MERGE THE TWO FILES
# ============================================================

result = pd.concat(
    [df1, df2],
    ignore_index=True
)


# ============================================================
# 6. SAVE
# ============================================================

result.to_excel(
    output_file,
    index=False
)


# ============================================================
# 7. REPORT
# ============================================================

print("=" * 60)
print("DONE")
print("=" * 60)

print(f"File 1 rows : {len(df1):,}")
print(f"File 2 rows : {len(df2):,}")
print(f"Total rows  : {len(result):,}")

print()
print(f"Output file : {output_file}")

print("=" * 60)
