import pandas as pd
from pathlib import Path

# ==============================
# INPUT FILE
# ==============================
input_file = Path(r"C:\Users\YOUR_NAME\Desktop\OUTPUT\TELE_cleaned.xlsx")

# ==============================
# OUTPUT FOLDER
# ==============================
output_folder = Path(r"C:\Users\YOUR_NAME\Desktop\DEDUPLICATED")

output_folder.mkdir(parents=True, exist_ok=True)

# ==============================
# READ FILE
# ==============================
df = pd.read_excel(input_file, dtype=str)

before = len(df)

# Make sure TELE is treated as text
df["TELE"] = df["TELE"].fillna("").astype(str).str.strip()

# ==============================
# DEDUPLICATION
# ==============================

# Keep empty TELE rows
empty_tele = df[df["TELE"] == ""]

# Deduplicate only non-empty TELE
non_empty_tele = df[df["TELE"] != ""]

non_empty_tele = non_empty_tele.drop_duplicates(
    subset=["TELE"],
    keep="first"
)

# Put everything back together
df_final = pd.concat(
    [non_empty_tele, empty_tele],
    ignore_index=True
)

after = len(df_final)
duplicates_removed = before - after

# ==============================
# SAVE
# ==============================
output_file = output_folder / "TELE_cleaned_deduplicated.xlsx"

df_final.to_excel(output_file, index=False)

# ==============================
# RESULTS
# ==============================
print("================================")
print("DEDUPLICATION FINISHED")
print("================================")

print(f"Rows before       : {before:,}")
print(f"Rows after        : {after:,}")
print(f"Duplicates removed: {duplicates_removed:,}")

print(f"\n📁 Output:")
print(output_file)
