import pandas as pd
import re

# ============================================================
# FILE PATHS
# ============================================================

input_file = r"C:\Users\Sunlight\Desktop\your_file.xlsx"

output_clean = r"C:\Users\Sunlight\Desktop\FINAL_WITHOUT_DUPLICATE_TVA.xlsx"

output_no_tva = r"C:\Users\Sunlight\Desktop\ROWS_WITHOUT_TVA.xlsx"


# ============================================================
# READ EXCEL
# ============================================================

df = pd.read_excel(
    input_file,
    dtype=str
)

# Clean column names ONLY
df.columns = (
    df.columns
    .astype(str)
    .str.strip()
    .str.upper()
)

# Handle possible TEL column names
df = df.rename(columns={
    "TEL 1": "TEL1",
    "TEL 2": "TEL2",
    "TEL 3": "TEL3"
})

# Make sure expected columns exist
for col in ["TVA", "GSM", "TEL1", "TEL2", "TEL3"]:
    if col not in df.columns:
        df[col] = ""

print("=" * 60)
print("START")
print("=" * 60)

print("Rows before cleaning:", len(df))


# ============================================================
# TVA NORMALIZATION
#
# ONLY TVA is normalized.
# PHONE COLUMNS ARE NOT TOUCHED.
# ============================================================

def clean_tva(value):

    if pd.isna(value):
        return ""

    value = str(value).strip().upper()

    if value in ["", "NAN", "NONE", "NULL"]:
        return ""

    # Remove Excel decimal
    value = re.sub(r"\.0+$", "", value)

    # Remove BE prefix
    if value.startswith("BE"):
        value = value[2:]

    # Remove spaces, dots, hyphens, etc.
    value = re.sub(r"\D", "", value)

    # Belgian enterprise number
    if len(value) == 9:
        value = "0" + value

    return value


df["_TVA_CHECK"] = df["TVA"].apply(clean_tva)


# ============================================================
# SEPARATE ROWS WITHOUT TVA
# ============================================================

no_tva = df[
    df["_TVA_CHECK"] == ""
].copy()

# Remove temporary column
no_tva = no_tva.drop(
    columns=["_TVA_CHECK"],
    errors="ignore"
)

# Save
no_tva.to_excel(
    output_no_tva,
    index=False
)

print("Rows without TVA:", len(no_tva))


# ============================================================
# KEEP ONLY ROWS WITH TVA
# ============================================================

with_tva = df[
    df["_TVA_CHECK"] != ""
].copy()


# ============================================================
# COMPLETENESS SCORE
#
# This is ONLY used to decide which duplicate row
# becomes the base row.
# ============================================================

important_columns = [
    "STE",
    "TVA",
    "NOM",
    "ADRESSE",
    "NUMERO",
    "COMPLEMENT",
    "CP",
    "VILLE",
    "GSM",
    "TEL1",
    "TEL2",
    "TEL3"
]

important_columns = [
    col
    for col in important_columns
    if col in with_tva.columns
]


def completeness_score(row):

    score = 0

    for col in important_columns:

        value = row.get(col, "")

        if pd.isna(value):
            continue

        value = str(value).strip()

        if value.lower() not in [
            "",
            "nan",
            "none",
            "null"
        ]:
            score += 1

    return score


with_tva["_SCORE"] = with_tva.apply(
    completeness_score,
    axis=1
)


# ============================================================
# PROCESS EACH TVA
#
# TVA IS THE ONLY DUPLICATE KEY
# ============================================================

final_rows = []


for tva, group in with_tva.groupby(
    "_TVA_CHECK",
    sort=False
):

    # --------------------------------------------------------
    # CHOOSE THE MOST COMPLETE ROW
    # --------------------------------------------------------

    best_index = group["_SCORE"].idxmax()

    best_row = group.loc[
        best_index
    ].copy()


    # --------------------------------------------------------
    # PRESERVE DIFFERENT INFORMATION
    #
    # We do NOT clean phone numbers.
    # We do NOT normalize phone numbers.
    # We simply preserve the original values.
    # --------------------------------------------------------

    phone_columns = [
        "GSM",
        "TEL1",
        "TEL2",
        "TEL3"
    ]


    for col in phone_columns:

        if col not in group.columns:
            continue

        values = []

        for value in group[col]:

            if pd.isna(value):
                continue

            value = str(value).strip()

            if value == "":
                continue

            # Preserve exact original value
            if value not in values:
                values.append(value)


        # Put all unique original values back
        if values:

            best_row[col] = " | ".join(values)


        else:

            best_row[col] = ""


    # --------------------------------------------------------
    # ADD FINAL ROW
    # --------------------------------------------------------

    final_rows.append(
        best_row
    )


# ============================================================
# CREATE FINAL DATAFRAME
# ============================================================

final_df = pd.DataFrame(
    final_rows
)


# ============================================================
# REMOVE TEMPORARY COLUMNS
# ============================================================

final_df = final_df.drop(
    columns=[
        "_TVA_CHECK",
        "_SCORE"
    ],
    errors="ignore"
)


# ============================================================
# SAVE FINAL CLEAN FILE
# ============================================================

final_df.to_excel(
    output_clean,
    index=False
)


# ============================================================
# FINAL REPORT
# ============================================================

print()
print("=" * 60)
print("FINAL RESULT")
print("=" * 60)

print(
    "Original rows:",
    len(df)
)

print(
    "Rows with TVA:",
    len(with_tva)
)

print(
    "Rows without TVA:",
    len(no_tva)
)

print(
    "Final rows with unique TVA:",
    len(final_df)
)

print(
    "Duplicate TVA rows removed:",
    len(with_tva) - len(final_df)
)

print()
print("✅ FILE 1 — CLEAN, NO DUPLICATE TVA:")
print(output_clean)

print()
print("✅ FILE 2 — ROWS WITHOUT TVA:")
print(output_no_tva)

print()
print("DONE")
