import pandas as pd
from pathlib import Path
from datetime import datetime

# ============================================================
# SETTINGS
# ============================================================

input_file = Path(r"C:\YOUR_PATH\master_file.xlsx")

output_dir = input_file.parent / "GSM_DEDUP_SPLIT"
output_dir.mkdir(exist_ok=True)

# ============================================================
# READ FILE
# ============================================================

df = pd.read_excel(input_file, dtype=str)

# Clean column names
df.columns = df.columns.str.strip()

# Check required columns
required_columns = ["GSM", "TVA"]

for col in required_columns:
    if col not in df.columns:
        raise ValueError(f"Column '{col}' was not found in the file.")

# ============================================================
# CLEAN GSM
# ============================================================

df["GSM"] = (
    df["GSM"]
    .fillna("")
    .astype(str)
    .str.strip()
)

# Remove Excel artifacts such as "0.0"
df["GSM"] = df["GSM"].str.replace(r"\.0$", "", regex=True)

# ============================================================
# REMOVE EMPTY GSM
# ============================================================

df = df[df["GSM"] != ""].copy()

# ============================================================
# REMOVE DUPLICATE GSM
# ============================================================

before_duplicates = len(df)

df = df.drop_duplicates(
    subset=["GSM"],
    keep="first"
).copy()

after_duplicates = len(df)

duplicates_removed = before_duplicates - after_duplicates

print(f"Rows before GSM deduplication : {before_duplicates:,}")
print(f"Rows after GSM deduplication  : {after_duplicates:,}")
print(f"Duplicate GSM removed         : {duplicates_removed:,}")

# ============================================================
# CLEAN TVA
# ============================================================

df["TVA"] = (
    df["TVA"]
    .fillna("")
    .astype(str)
    .str.strip()
)

# Treat NaN / empty / Excel artifacts as missing
df["TVA"] = df["TVA"].replace(
    ["nan", "NaN", "None", "NONE", "0.0"],
    ""
)

# ============================================================
# SPLIT WITH TVA / WITHOUT TVA
# ============================================================

with_tva = df[df["TVA"] != ""].copy()

without_tva = df[df["TVA"] == ""].copy()

# ============================================================
# OUTPUT FILES
# ============================================================

timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")

with_tva_file = output_dir / f"GSM_unique_WITH_TVA_{timestamp}.xlsx"
without_tva_file = output_dir / f"GSM_unique_WITHOUT_TVA_{timestamp}.xlsx"

with_tva.to_excel(with_tva_file, index=False)
without_tva.to_excel(without_tva_file, index=False)

# ============================================================
# RESULTS
# ============================================================

print("\n========== FINAL RESULTS ==========")

print(f"Unique GSM total       : {len(df):,}")
print(f"With TVA               : {len(with_tva):,}")
print(f"Without TVA            : {len(without_tva):,}")

print("\nFiles created:")
print(with_tva_file)
print(without_tva_file)
