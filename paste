from pathlib import Path
from openpyxl import load_workbook, Workbook
from datetime import datetime


# ============================================================
# SETTINGS
# ============================================================

# CHANGE THIS
INPUT_FOLDER = Path(r"C:\YOUR_FOLDER_HERE")

# Target maximum number of DATA rows
MAX_ROWS_PER_MASTER = 700_000


# ============================================================
# COLUMNS TO KEEP
# ============================================================

KEEP_COLUMNS = [
    "STE",
    "TVA",
    "NOM",
    "ADRESSE",
    "NUMERO",
    "COMPLEMENT",
    "CP",
    "VILLE",
    "GSM",
    "TEL1",
    "TEL2",
    "TEL3"
]


# ============================================================
# FIND EXCEL FILES
# ============================================================

files = sorted([
    f
    for f in INPUT_FOLDER.iterdir()
    if f.is_file()
    and f.suffix.lower() in [".xlsx", ".xlsm"]
    and not f.name.startswith("~$")
])


print("=" * 70)
print("SMART EXCEL MERGE")
print("=" * 70)

print(f"Excel files found: {len(files)}")


if not files:
    raise Exception("No Excel files found.")


# ============================================================
# OUTPUT FOLDER
# ============================================================

timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")

OUTPUT_FOLDER = (
    INPUT_FOLDER /
    f"MASTER_OUTPUT_{timestamp}"
)

OUTPUT_FOLDER.mkdir(exist_ok=True)

print(f"Output folder: {OUTPUT_FOLDER}")


# ============================================================
# VARIABLES
# ============================================================

master_number = 0
current_master_rows = 0
total_rows = 0
processed_files = 0

errors = []

wb_out = None
ws_out = None
current_output_path = None


# ============================================================
# FUNCTION TO CREATE A NEW MASTER
# ============================================================

def create_new_master(
    old_workbook,
    old_output_path,
    new_master_number
):

    # Save previous Master
    if old_workbook is not None:

        print(
            f"Saving: {old_output_path.name}"
        )

        old_workbook.save(
            old_output_path
        )

        old_workbook.close()


    # New filename
    filename = (
        f"MASTER_{new_master_number:03d}.xlsx"
    )

    new_output_path = (
        OUTPUT_FOLDER / filename
    )


    # Create write-only workbook
    new_workbook = Workbook(
        write_only=True
    )

    new_sheet = new_workbook.create_sheet(
        title="Master"
    )


    # Header
    new_sheet.append(
        KEEP_COLUMNS + ["SOURCE"]
    )


    print(
        f"\n>>> NEW MASTER: {filename}"
    )


    return (
        new_workbook,
        new_sheet,
        new_output_path
    )


# ============================================================
# CREATE FIRST MASTER
# ============================================================

master_number = 1

wb_out, ws_out, current_output_path = (
    create_new_master(
        None,
        None,
        master_number
    )
)


# ============================================================
# PROCESS FILES
# ============================================================

for file_number, file_path in enumerate(
    files,
    start=1
):

    print("\n" + "-" * 70)

    print(
        f"[{file_number}/{len(files)}] "
        f"{file_path.name}"
    )


    try:

        # ====================================================
        # OPEN INPUT EXCEL
        # ====================================================

        wb_in = load_workbook(
            filename=file_path,
            read_only=True,
            data_only=False
        )

        ws_in = wb_in[
            wb_in.sheetnames[0]
        ]

        rows = ws_in.iter_rows(
            values_only=True
        )


        # ====================================================
        # READ HEADER
        # ====================================================

        try:

            original_header = next(rows)

        except StopIteration:

            print("⚠ Empty file")

            wb_in.close()

            continue


        # ====================================================
        # MAP COLUMNS
        # ====================================================

        header_map = {}

        for index, column in enumerate(
            original_header
        ):

            if column is not None:

                column_name = (
                    str(column)
                    .strip()
                    .upper()
                )

                header_map[column_name] = index


        # ====================================================
        # CHECK COLUMNS
        # ====================================================

        missing = [
            col
            for col in KEEP_COLUMNS
            if col.upper() not in header_map
        ]

        if missing:

            print(
                f"⚠ Missing columns: {missing}"
            )


        # ====================================================
        # COPY ROWS
        # ====================================================

        file_rows = 0

        for row in rows:

            # ------------------------------------------------
            # If Master reaches 700,000,
            # create a new Master.
            # ------------------------------------------------

            if (
                current_master_rows
                >= MAX_ROWS_PER_MASTER
            ):

                master_number += 1

                current_master_rows = 0

                (
                    wb_out,
                    ws_out,
                    current_output_path
                ) = create_new_master(
                    wb_out,
                    current_output_path,
                    master_number
                )


            # ------------------------------------------------
            # CREATE OUTPUT ROW
            # ------------------------------------------------

            output_row = []

            for column in KEEP_COLUMNS:

                index = header_map.get(
                    column.upper()
                )

                if (
                    index is not None
                    and index < len(row)
                ):

                    value = row[index]

                else:

                    value = None

                output_row.append(value)


            # ------------------------------------------------
            # SOURCE
            # ------------------------------------------------

            output_row.append(
                file_path.name
            )


            # ------------------------------------------------
            # WRITE
            # ------------------------------------------------

            ws_out.append(
                output_row
            )

            current_master_rows += 1
            total_rows += 1
            file_rows += 1


        wb_in.close()

        processed_files += 1

        print(
            f"✓ {file_rows:,} rows copied"
        )

        print(
            f"Current Master: "
            f"{current_master_rows:,} rows"
        )


    except Exception as error:

        errors.append(
            f"{file_path.name}: {error}"
        )

        print(
            f"❌ ERROR: {error}"
        )


# ============================================================
# SAVE LAST MASTER
# ============================================================

if wb_out is not None:

    print(
        f"\nSaving final: "
        f"{current_output_path.name}"
    )

    wb_out.save(
        current_output_path
    )

    wb_out.close()


# ============================================================
# FINAL REPORT
# ============================================================

print("\n")
print("=" * 70)
print("MERGE FINISHED")
print("=" * 70)

print(
    f"Excel files found     : {len(files):,}"
)

print(
    f"Files processed       : {processed_files:,}"
)

print(
    f"Master files created  : {master_number:,}"
)

print(
    f"Total rows copied     : {total_rows:,}"
)

print(
    f"Errors                : {len(errors):,}"
)

print(
    f"\nOutput folder:"
)

print(
    OUTPUT_FOLDER
)


# ============================================================
# ERRORS
# ============================================================

if errors:

    print("\nERRORS:")

    for error in errors:

        print(" -", error)

else:

    print(
        "\n✓ ALL FILES PROCESSED SUCCESSFULLY"
    )


print("\nNothing was deleted.")
print("Nothing was deduplicated.")
print("Nothing was cleaned.")
print("Nothing was filtered.")
print("SOURCE is the last column.")
