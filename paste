# ============================================================
# 14. EXCEL WRITER FUNCTION
# ============================================================

headers = [
    "STE",
    "TVA",
    "NOM",
    "ADRESSE",
    "NUMERO",
    "COMPLEMENT",
    "CP",
    "VILLE",
    "GSM",
    "TEL1",
    "TEL2",
    "TEL3"
]


part_number = 0
rows_in_current_file = 0
total_companies = 0
workbook = None
worksheet = None


def create_new_excel():

    global part_number
    global rows_in_current_file
    global workbook
    global worksheet

    # Close previous workbook
    if workbook is not None:

        workbook.close()

    part_number += 1

    rows_in_current_file = 0

    output_file = Path(
        f"{OUTPUT_BASE}_PART{part_number}.xlsx"
    )

    print()
    print(
        f"Creating Excel file:"
    )
    print(output_file)

    workbook = xlsxwriter.Workbook(
        str(output_file)
    )

    worksheet = workbook.add_worksheet(
        "Companies"
    )

    # Header format
    header_format = workbook.add_format({
        "bold": True
    })

    for col, header in enumerate(headers):

        worksheet.write(
            0,
            col,
            header,
            header_format
        )

    return output_file


# ============================================================
# 15. GENERATE EXCEL
# ============================================================

print("Creating final Excel files...")

create_new_excel()


cur.execute("""
SELECT
    e.kbo,
    d.denomination,
    a.street,
    a.house_number,
    a.box,
    a.postal_code,
    a.municipality

FROM enterprise e

LEFT JOIN denomination d
    ON e.kbo = d.kbo

LEFT JOIN address a
    ON e.kbo = a.kbo

ORDER BY e.kbo
""")


for row in cur:

    (
        kbo,
        name,
        street,
        house_number,
        box,
        postal_code,
        municipality
    ) = row


    # --------------------------------------------------------
    # CHECK EXCEL LIMIT
    # --------------------------------------------------------

    if rows_in_current_file >= MAX_DATA_ROWS:

        create_new_excel()


    # --------------------------------------------------------
    # PHONES
    # --------------------------------------------------------

    phones = phone_dict.get(
        kbo,
        []
    )


    # --------------------------------------------------------
    # SEPARATE GSM / LANDLINE
    # --------------------------------------------------------

    gsm = ""

    landlines = []


    for phone in phones:

        if is_gsm(phone):

            # First GSM only
            if not gsm:

                gsm = phone

        else:

            if phone not in landlines:

                landlines.append(phone)


    # --------------------------------------------------------
    # TEL1 / TEL2 / TEL3
    # --------------------------------------------------------

    tel1 = (
        landlines[0]
        if len(landlines) > 0
        else ""
    )

    tel2 = (
        landlines[1]
        if len(landlines) > 1
        else ""
    )

    tel3 = (
        landlines[2]
        if len(landlines) > 2
        else ""
    )


    # --------------------------------------------------------
    # TVA
    # --------------------------------------------------------

    tva = (
        "BE" + kbo
        if kbo
        else ""
    )


    # --------------------------------------------------------
    # CP FINAL CHECK
    # --------------------------------------------------------

    cp = extract_cp(
        postal_code,
        street,
        municipality
    )


    # --------------------------------------------------------
    # DATA ROW
    # --------------------------------------------------------

    data = [
        kbo,
        tva,
        name or "",
        street or "",
        house_number or "",
        box or "",
        cp,
        municipality or "",
        gsm,
        tel1,
        tel2,
        tel3
    ]


    # --------------------------------------------------------
    # WRITE TO EXCEL
    # --------------------------------------------------------

    excel_row = rows_in_current_file + 1

    for col, value in enumerate(data):

        worksheet.write(
            excel_row,
            col,
            value
        )


    rows_in_current_file += 1
    total_companies += 1


    if total_companies % 100000 == 0:

        print(
            f"  {total_companies:,} companies written"
        )


