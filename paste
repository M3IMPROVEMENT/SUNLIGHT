import pandas as pd
import os

# ============================================================
# 1. INPUT EXCEL FILE
# ============================================================

input_file = r"C:\Users\Sunlight\Desktop\your_file.xlsx"

# Output file
output_file = os.path.splitext(input_file)[0] + "_telephone.xlsx"


# ============================================================
# 2. COLUMNS TO KEEP
# ============================================================

info_columns = [
    "STE",
    "TVA",
    "NOM",
    "ADRESSE",
    "NUMERO",
    "COMPLEMENT",
    "CP",
    "VILLE"
]

phone_columns = [
    "GSM",
    "TEL1",
    "TEL2",
    "TEL3"
]


# ============================================================
# 3. READ THE EXCEL FILE
# ============================================================

df = pd.read_excel(input_file)


# ============================================================
# 4. CREATE MISSING COLUMNS IF NECESSARY
# ============================================================

for col in info_columns + phone_columns:
    if col not in df.columns:
        df[col] = ""


# ============================================================
# 5. KEEP THE REQUIRED COLUMNS
# ============================================================

df = df[info_columns + phone_columns]


# ============================================================
# 6. GSM + TEL1 + TEL2 + TEL3 → TELEPHONE
# ============================================================

result = df.melt(
    id_vars=info_columns,
    value_vars=phone_columns,
    var_name="SOURCE",
    value_name="TELEPHONE"
)


# ============================================================
# 7. REMOVE ONLY COMPLETELY EMPTY PHONE CELLS
# ============================================================
# IMPORTANT:
# No cleaning or modification of telephone numbers.
# The actual values are kept as they were in Excel.

result = result[
    result["TELEPHONE"].notna() &
    (result["TELEPHONE"].astype(str).str.strip() != "")
]


# ============================================================
# 8. REMOVE SOURCE COLUMN
# ============================================================

result = result.drop(columns=["SOURCE"])


# ============================================================
# 9. FINAL COLUMN ORDER
# ============================================================

result = result[
    [
        "STE",
        "TVA",
        "NOM",
        "ADRESSE",
        "NUMERO",
        "COMPLEMENT",
        "CP",
        "VILLE",
        "TELEPHONE"
    ]
]


# ============================================================
# 10. SAVE
# ============================================================

result.to_excel(output_file, index=False)


print("======================================")
print("DONE!")
print("======================================")
print("Output:", output_file)
print("Total telephone rows:", len(result))
print("======================================")
