import openpyxl
import re
from pathlib import Path

# ============================================================
# CONFIGURATION
# ============================================================

input_file = r"C:\Users\YourName\Desktop\YOUR_FILE.xlsx"

output_file = r"C:\Users\YourName\Desktop\TELE_CHECK.xlsx"

TELE_COLUMN_NAME = "TELE"


# ============================================================
# PHONE PATTERN
# ============================================================

# Belgian number can appear as:
# 02 229 41 11
# 0438 22 77 4
# 0478 719 289
# +32 478 71 92 89
# 0032 478 71 92 89
# 32 478 71 92 89

PHONE_PATTERN = re.compile(
    r"""
    (?:
        \+32
        |
        0032
        |
        32
        |
        0
    )
    [\s./-]*
    \d
    (?:[\s./-]*\d){7,11}
    """,
    re.VERBOSE
)


# ============================================================
# NORMALIZE FOR CHECKING ONLY
# ============================================================

def digits(value):

    if value is None:
        return ""

    text = str(value).strip()

    if text.endswith(".0"):
        text = text[:-2]

    return re.sub(r"\D", "", text)


# ============================================================
# FIND POSSIBLE NUMBERS
# ============================================================

def find_numbers(value):

    if value is None:
        return []

    text = str(value).strip()

    if not text:
        return []

    matches = PHONE_PATTERN.findall(text)

    numbers = []

    for match in matches:

        d = digits(match)

        if d:
            numbers.append(d)

    return numbers


# ============================================================
# CHECK ONE TELE CELL
# ============================================================

def check_tele(value):

    if value is None or str(value).strip() == "":
        return None

    text = str(value).strip()

    # --------------------------------------------------------
    # Find phone-like groups
    # --------------------------------------------------------

    numbers = find_numbers(text)

    # --------------------------------------------------------
    # Count obvious separators
    # --------------------------------------------------------

    slash_count = text.count("/")
    semicolon_count = text.count(";")
    pipe_count = text.count("|")

    # --------------------------------------------------------
    # Count groups separated by spaces
    # --------------------------------------------------------

    space_groups = [
        x for x in re.split(r"\s+", text)
        if re.search(r"\d", x)
    ]

    # --------------------------------------------------------
    # Determine suspicion
    # --------------------------------------------------------

    reasons = []

    # Clearly more than one detected number
    if len(numbers) >= 2:
        reasons.append("2+ phone numbers detected")

    # 3 or more
    if len(numbers) >= 3:
        reasons.append("3+ phone numbers")

    # Multiple semicolon / pipe separated values
    if semicolon_count > 0:
        reasons.append("semicolon separator")

    if pipe_count > 0:
        reasons.append("pipe separator")

    # Slash needs manual attention
    if slash_count > 0:
        reasons.append("slash '/' - manual check")

    # Several number-like groups
    if len(space_groups) >= 2:
        # Don't automatically call it multiple numbers
        # because formatted numbers can contain spaces.
        reasons.append("multiple numeric groups")

    if not reasons:
        return None

    # --------------------------------------------------------
    # Confidence
    # --------------------------------------------------------

    if len(numbers) >= 2:
        confidence = "HIGH"

    elif semicolon_count or pipe_count:
        confidence = "HIGH"

    elif slash_count:
        confidence = "CHECK"

    else:
        confidence = "CHECK"

    return {
        "numbers_detected": len(numbers),
        "detected_numbers": " | ".join(numbers),
        "confidence": confidence,
        "reason": " ; ".join(reasons)
    }


# ============================================================
# OPEN FILE
# ============================================================

print("Opening Excel...")
print(input_file)

wb = openpyxl.load_workbook(
    input_file,
    read_only=True,
    data_only=False
)

# ============================================================
# CREATE REPORT
# ============================================================

report_wb = openpyxl.Workbook()
report_ws = report_wb.active
report_ws.title = "TELE_CHECK"

report_ws.append([
    "Sheet",
    "Excel Row",
    "TELE Original",
    "Numbers Detected",
    "Detected Numbers",
    "Confidence",
    "Reason"
])


# ============================================================
# PROCESS
# ============================================================

total_rows = 0
suspicious_rows = 0
high_confidence = 0
check_rows = 0

for ws in wb.worksheets:

    print()
    print("Checking:", ws.title)

    # Find TELE column
    header = next(
        ws.iter_rows(
            min_row=1,
            max_row=1,
            values_only=True
        )
    )

    tele_index = None

    for i, value in enumerate(header):

        if value is not None:

            if str(value).strip().upper() == TELE_COLUMN_NAME:

                tele_index = i
                break

    if tele_index is None:

        print("TELE column not found.")
        continue

    print("TELE column:", tele_index + 1)

    # --------------------------------------------------------
    # Process rows
    # --------------------------------------------------------

    for excel_row, row in enumerate(
        ws.iter_rows(
            min_row=2,
            values_only=True
        ),
        start=2
    ):

        total_rows += 1

        value = row[tele_index]

        result = check_tele(value)

        if result is None:
            continue

        suspicious_rows += 1

        if result["confidence"] == "HIGH":
            high_confidence += 1
        else:
            check_rows += 1

        report_ws.append([
            ws.title,
            excel_row,
            value,
            result["numbers_detected"],
            result["detected_numbers"],
            result["confidence"],
            result["reason"]
        ])

        if suspicious_rows % 1000 == 0:
            print(
                f"Suspicious rows found: "
                f"{suspicious_rows:,}"
            )


# ============================================================
# SAVE REPORT
# ============================================================

report_wb.save(output_file)

wb.close()

# ============================================================
# RESULTS
# ============================================================

print()
print("==============================================")
print("CHECK FINISHED")
print("==============================================")
print(f"Rows checked       : {total_rows:,}")
print(f"Suspicious rows    : {suspicious_rows:,}")
print(f"HIGH confidence    : {high_confidence:,}")
print(f"Manual CHECK       : {check_rows:,}")
print()
print("Original Excel was NOT modified.")
print()
print("Report:")
print(output_file)
print("==============================================")
