import pandas as pd
from pathlib import Path

# ==============================
# DOSSIER CONTENANT LES FICHIERS
# ==============================
folder = Path(r"C:\Users\YOUR_NAME\Desktop\FILES")

# ==============================
# PARAMÈTRES
# ==============================
CP_COLUMN = "CP"

# ==============================
# VÉRIFICATION
# ==============================
wrong_files = []

for file in folder.glob("*.xlsx"):

    try:
        df = pd.read_excel(file, dtype=str)

        # Vérifier si la colonne CP existe
        if CP_COLUMN not in df.columns:
            print(f"⚠️ Colonne CP absente : {file.name}")
            continue

        # Nettoyage léger uniquement pour le contrôle
        cp = (
            df[CP_COLUMN]
            .fillna("")
            .astype(str)
            .str.strip()
            .str.replace(r"\.0$", "", regex=True)
        )

        # CP valide = exactement 4 chiffres
        wrong_mask = (cp != "") & (~cp.str.fullmatch(r"\d{4}"))

        wrong_count = wrong_mask.sum()

        if wrong_count > 0:
            wrong_files.append({
                "Fichier": file.name,
                "Chemin": str(file),
                "CP incorrects": wrong_count
            })

            print(
                f"❌ {file.name} → "
                f"{wrong_count} CP incorrect(s)"
            )

        else:
            print(f"✅ {file.name} → CP OK")

    except Exception as e:
        print(f"⚠️ Erreur avec {file.name}: {e}")


# ==============================
# RÉSULTAT
# ==============================
if wrong_files:

    result = pd.DataFrame(wrong_files)

    output = folder / "files_with_wrong_CP.xlsx"
    result.to_excel(output, index=False)

    print("\n================================")
    print("FICHIERS AVEC CP INCORRECTS")
    print("================================")
    print(result.to_string(index=False))

    print(f"\n📁 Résultat sauvegardé ici :")
    print(output)

else:
    print("\n✅ Aucun fichier avec un CP incorrect.")
