import pandas as pd
from pathlib import Path
from datetime import datetime

# ============================================================
# SETTINGS
# ============================================================

INPUT_FILE = "master_final_table.xlsx"

OUTPUT_DIR = Path("phone_split_output")
OUTPUT_DIR.mkdir(exist_ok=True)

PHONE_COLS = ["GSM", "TEL1", "TEL2", "TEL3"]

# ============================================================
# READ FILE
# ============================================================

print("Reading file...")

df = pd.read_excel(INPUT_FILE, dtype=str)

# Clean column names
df.columns = df.columns.astype(str).str.strip()

# Make sure all phone columns exist
for col in PHONE_COLS:
    if col not in df.columns:
        df[col] = ""

# Replace NaN
df = df.fillna("")

print(f"Original rows: {len(df):,}")

# ============================================================
# CREATE ONE ROW PER PHONE NUMBER
# ============================================================

new_rows = []

for _, row in df.iterrows():

    # Collect every number from GSM, TEL1, TEL2 and TEL3
    phones = []

    for col in PHONE_COLS:

        value = str(row[col]).strip()

        if value != "":
            phones.append(value)

    # --------------------------------------------------------
    # NO PHONE NUMBER
    # Keep the original row
    # --------------------------------------------------------

    if not phones:

        new_row = row.to_dict()

        # Make sure phone columns are empty
        new_row["GSM"] = ""
        new_row["TEL1"] = ""
        new_row["TEL2"] = ""
        new_row["TEL3"] = ""

        new_rows.append(new_row)

    # --------------------------------------------------------
    # ONE ROW FOR EACH PHONE
    # ALL PHONES GO INTO GSM
    # --------------------------------------------------------

    else:

        for phone in phones:

            new_row = row.to_dict()

            # Empty all phone columns
            new_row["GSM"] = ""
            new_row["TEL1"] = ""
            new_row["TEL2"] = ""
            new_row["TEL3"] = ""

            # Put the number in GSM
            new_row["GSM"] = phone

            new_rows.append(new_row)

# ============================================================
# CREATE RESULT
# ============================================================

result = pd.DataFrame(new_rows)

# Keep original column order
result = result[df.columns]

# ============================================================
# SAVE
# ============================================================

timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")

output_file = OUTPUT_DIR / f"phone_one_per_line_{timestamp}.xlsx"

result.to_excel(output_file, index=False)

# ============================================================
# STATISTICS
# ============================================================

original_numbers = (
    df[PHONE_COLS]
    .apply(lambda x: x.astype(str).str.strip().ne("").sum())
    .sum()
)

result_numbers = (
    result["GSM"]
    .astype(str)
    .str.strip()
    .ne("")
    .sum()
)

print()
print("=" * 60)
print("DONE")
print("=" * 60)

print(f"Original rows       : {len(df):,}")
print(f"Phone numbers found : {original_numbers:,}")
print(f"Output rows         : {len(result):,}")
print(f"Numbers in GSM      : {result_numbers:,}")

print()
print("Output file:")
print(output_file)
