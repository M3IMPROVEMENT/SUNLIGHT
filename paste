
import pandas as pd
import re
from pathlib import Path

# ============================================================
# CONFIGURATION
# ============================================================

INPUT_FILE = Path(
    r"C:\Users\Sunlight\Desktop\01-10-26\output_TELE_CLEANED.xlsx"
)

OUTPUT_FILE = Path(
    r"C:\Users\Sunlight\Desktop\01-10-26\output_TELE_DEDUPLICATED.xlsx"
)


# ============================================================
# 1. READ FILE
# ============================================================

if not INPUT_FILE.exists():
    raise FileNotFoundError(f"File not found: {INPUT_FILE}")

df = pd.read_excel(INPUT_FILE, dtype=object)

def normalize_header(value):
    return re.sub(r"\s+", " ", str(value).strip()).upper()

# Find columns regardless of capitalization or surrounding spaces.
columns = {
    normalize_header(col): col
    for col in df.columns
}

if "TELE" not in columns:
    raise ValueError("Required column TELE was not found.")

tele_col = columns["TELE"]
tva_col = columns.get("TVA")

print("Input rows:", len(df))
print("TELE column:", tele_col)
print("TVA column:", tva_col if tva_col else "Not found")


# ============================================================
# 2. NORMALIZE TELE FOR MATCHING
# ============================================================

def normalize_phone(value):
    if pd.isna(value):
        return ""

    if isinstance(value, float) and value.is_integer():
        value = str(int(value))
    else:
        value = str(value).strip()

    # Compare numbers without spaces, punctuation or prefixes.
    digits = re.sub(r"\D", "", value)

    if not digits:
        return ""

    # Normalize Belgian international prefixes.
    while True:
        if digits.startswith("000032"):
            digits = digits[6:]
        elif digits.startswith("0032"):
            digits = digits[4:]
        elif digits.startswith("32"):
            digits = digits[2:]
        else:
            break

    return digits


# Temporary matching key; original TELE values remain unchanged.
df["_PHONE_KEY"] = df[tele_col].apply(normalize_phone)

# Count how many fields contain useful information.
original_columns = list(df.columns)
original_columns.remove("_PHONE_KEY")

def is_filled(value):
    if pd.isna(value):
        return False

    if isinstance(value, str):
        return bool(value.strip())

    return True

df["_INFO_SCORE"] = df[original_columns].apply(
    lambda row: sum(is_filled(v) for v in row),
    axis=1
)

# TVA is prioritized when the column exists.
if tva_col:
    df["_HAS_TVA"] = df[tva_col].apply(is_filled).astype(int)
else:
    df["_HAS_TVA"] = 0


# ============================================================
# 3. RANK DUPLICATE ROWS
# ============================================================

# Highest priority:
# 1. Has TVA
# 2. Has the most populated fields
# 3. Original row order for ties

df["_ORIGINAL_ORDER"] = range(len(df))

df = df.sort_values(
    by=["_HAS_TVA", "_INFO_SCORE", "_ORIGINAL_ORDER"],
    ascending=[False, False, True],
    kind="stable"
)


# ============================================================
# 4. MERGE INFORMATION AND DEDUPLICATE BY TELE
# ============================================================

output_records = []
removed_duplicates = 0
blank_phone_rows = 0

# Preserve rows with blank TELE separately.
blank_phone_rows = int((df["_PHONE_KEY"] == "").sum())

# Never group blank phone numbers together.
blank_rows = df[df["_PHONE_KEY"] == ""]
valid_rows = df[df["_PHONE_KEY"] != ""]

# Keep the best row as the base, then fill empty fields
# using information from the other rows with the same phone.
for phone_key, group in valid_rows.groupby(
    "_PHONE_KEY", sort=False
):
    group = group.sort_values(
        by=["_HAS_TVA", "_INFO_SCORE", "_ORIGINAL_ORDER"],
        ascending=[False, False, True],
        kind="stable"
    )

    # Best-ranked row is the main record.
    merged = group.iloc[0][original_columns].copy()

    # Fill missing values from other duplicate rows.
    # Existing non-empty values in the best row are retained.
    for _, other_row in group.iloc[1:].iterrows():
        for column in original_columns:
            if not is_filled(merged[column]) and is_filled(
                other_row[column]
            ):
                merged[column] = other_row[column]

    output_records.append(merged)
    removed_duplicates += len(group) - 1

# Keep all rows without a usable phone number unchanged.
for _, row in blank_rows.iterrows():
    output_records.append(row[original_columns].copy())

result = pd.DataFrame(
    output_records,
    columns=original_columns
)


# ============================================================
# 5. EXPORT
# ============================================================

OUTPUT_FILE.parent.mkdir(parents=True, exist_ok=True)

result.to_excel(
    OUTPUT_FILE,
    index=False,
    engine="openpyxl"
)


# ============================================================
# 6. REPORT
# ============================================================

print("\n" + "=" * 50)
print("DEDUPLICATION COMPLETED")
print("=" * 50)
print("Input rows:", len(df))
print("Output rows:", len(result))
print("Duplicates removed:", removed_duplicates)
print("Rows with blank TELE preserved:", blank_phone_rows)
print("TVA priority:", "Enabled" if tva_col else "TVA column missing")
print("Missing fields filled from duplicates: Yes")
print("Output file:", OUTPUT_FILE)
