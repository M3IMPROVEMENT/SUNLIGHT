import pandas as pd
from pathlib import Path

# ============================================================
# 1. FOLDER CONTAINING YOUR 9 FILES
# ============================================================

folder = Path(r"C:\YOUR_PATH\YOUR_FOLDER")

# ============================================================
# 2. FIND ALL EXCEL FILES
# ============================================================

files = list(folder.glob("*.xlsx"))

print(f"Excel files found: {len(files)}")

if len(files) == 0:
    raise FileNotFoundError("No Excel files found in this folder.")

# ============================================================
# 3. READ AND COMBINE ALL FILES
# ============================================================

dataframes = []

for file in files:
    print(f"Reading: {file.name}")

    df = pd.read_excel(file, dtype=str)

    # Clean column names
    df.columns = df.columns.str.strip()

    dataframes.append(df)

# Combine everything
master = pd.concat(dataframes, ignore_index=True)

print("\nTotal rows before cleaning:", len(master))

# ============================================================
# 4. CHECK GSM COLUMN
# ============================================================

if "GSM" not in master.columns:
    raise ValueError("GSM column was not found.")

# ============================================================
# 5. CLEAN GSM
# ============================================================

master["GSM"] = (
    master["GSM"]
    .fillna("")
    .astype(str)
    .str.strip()
)

# Remove Excel .0
master["GSM"] = master["GSM"].str.replace(
    r"\.0$", "", regex=True
)

# ============================================================
# 6. REMOVE ROWS WITHOUT GSM
# ============================================================

master = master[master["GSM"] != ""].copy()

print("Rows with GSM:", len(master))

# ============================================================
# 7. REMOVE DUPLICATE GSM
# ============================================================

before = len(master)

master = master.drop_duplicates(
    subset=["GSM"],
    keep="first"
).copy()

after = len(master)

duplicates_removed = before - after

# ============================================================
# 8. SAVE ONE FINAL FILE
# ============================================================

output_file = folder / "MASTER_GSM_UNIQUE.xlsx"

master.to_excel(
    output_file,
    index=False
)

# ============================================================
# 9. RESULTS
# ============================================================

print("\n======================================")
print("DONE")
print("======================================")

print(f"Files processed       : {len(files)}")
print(f"Rows before dedup     : {before:,}")
print(f"Unique GSM rows       : {after:,}")
print(f"Duplicates removed    : {duplicates_removed:,}")

print("\nFinal file:")
print(output_file)
