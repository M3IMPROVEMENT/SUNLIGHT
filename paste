
from pathlib import Path
from openpyxl import load_workbook, Workbook
import re

# ==================================================
# CONFIGURATION
# ==================================================

INPUT_FILE = Path(r"C:\Users\Sunlight\Desktop\DB\input.xlsx")
OUTPUT_FILE = Path(r"C:\Users\Sunlight\Desktop\DB\separated.xlsx")

# Exact header of the column containing values like 42251504/0495402000
PHONE_COLUMN = "TELE"

# ==================================================
# FUNCTIONS
# ==================================================

def split_values(value):
    if value is None:
        return []

    # Excel can store large numbers in scientific notation.
    # Convert numeric values without using str(float).
    if isinstance(value, int):
        text = str(value)
    elif isinstance(value, float):
        text = format(value, ".0f") if value.is_integer() else str(value)
    else:
        text = str(value).strip()

    # Split on slash, semicolon, comma, or line break
    parts = re.split(r"[/;,\r\n]+", text)
    return [p.strip() for p in parts if p.strip()]


def classify_number(value):
    digits = re.sub(r"\D", "", value)

    # Preserve Belgian international prefix conversion
    if digits.startswith("0032"):
        digits = "0" + digits[4:]
    elif digits.startswith("32") and len(digits) in (10, 11):
        digits = "0" + digits[2:]

    if re.fullmatch(r"04[6-9]\d{7}", digits):
        return digits, "GSM"

    # Common Belgian fixed-line format
    if re.fullmatch(r"0[1-9]\d{7}", digits) and not digits.startswith("04"):
        return digits, "FIX"

    return digits, "CHECK"


# ==================================================
# READ INPUT
# ==================================================

wb = load_workbook(INPUT_FILE, read_only=True, data_only=True)
ws = wb.active

headers = list(next(ws.iter_rows(min_row=1, max_row=1, values_only=True)))

if PHONE_COLUMN not in headers:
    wb.close()
    raise ValueError(
        f"Column '{PHONE_COLUMN}' not found.\nAvailable headers: {headers}"
    )

phone_index = headers.index(PHONE_COLUMN)

# ==================================================
# WRITE OUTPUT
# ==================================================

out_wb = Workbook(write_only=True)
out_ws = out_wb.create_sheet("Separated")
out_ws.append(headers + ["TYPE_NUMERO"])

input_rows = 0
output_rows = 0

for row in ws.iter_rows(min_row=2, values_only=True):
    row = list(row)
    input_rows += 1

    values = split_values(row[phone_index])

    if not values:
        out_ws.append(row + ["EMPTY"])
        output_rows += 1
        continue

    for value in values:
        number, number_type = classify_number(value)

        new_row = row.copy()
        new_row[phone_index] = number

        out_ws.append(new_row + [number_type])
        output_rows += 1

wb.close()
out_wb.save(OUTPUT_FILE)

print("Finished successfully!")
print(f"Input rows: {input_rows:,}")
print(f"Output rows: {output_rows:,}")
print(f"Saved to: {OUTPUT_FILE}")
