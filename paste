from pathlib import Path
from collections import Counter

# CHANGE THIS PATH
folder = Path(r"C:\Users\YOUR_NAME\Desktop\YOUR_REPOSITORY")

# Search recursively for all Excel files
excel_files = []

extensions = ["*.xlsx", "*.xls", "*.xlsm", "*.XLSX", "*.XLS", "*.XLSM"]

for ext in extensions:
    excel_files.extend(folder.rglob(ext))

# Remove temporary Excel files
excel_files = [
    f for f in excel_files
    if not f.name.startswith("~$")
]

print("TOTAL EXCEL FILES FOUND:", len(excel_files))

# Count extensions
extension_count = Counter(f.suffix.lower() for f in excel_files)

print("\nFILES BY EXTENSION:")
for ext, count in extension_count.items():
    print(ext, ":", count)

# Save the complete list
with open(folder / "all_excel_files_found.txt", "w", encoding="utf-8") as f:
    for file in sorted(excel_files):
        f.write(str(file) + "\n")

print("\nList saved as: all_excel_files_found.txt")
