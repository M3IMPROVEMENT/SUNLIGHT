from pathlib import Path
from openpyxl import load_workbook, Workbook


# ============================================================
# CONFIGURATION
# ============================================================

INPUT_FOLDER = Path(
    r"C:\Users\Sunlight\Desktop\01-10-26\ALL DB\excel_data-PC1_TR"
)

OUTPUT_FOLDER = Path(
    r"C:\Users\Sunlight\Desktop\01-10-26\ALL DB\excel_data-PC1_TR\GSM\MERGED_OUTPUT"
)

OUTPUT_FILE = OUTPUT_FOLDER / "merged_ALL.xlsx"


# ============================================================
# CREATE OUTPUT FOLDER
# ============================================================

OUTPUT_FOLDER.mkdir(parents=True, exist_ok=True)


# ============================================================
# GET INPUT FILES
# IMPORTANT: DO NOT READ FILES FROM OUTPUT FOLDER
# ============================================================

excel_files = sorted([
    f
    for f in INPUT_FOLDER.iterdir()
    if f.is_file()
    and f.suffix.lower() == ".xlsx"
    and not f.name.startswith("~$")
    and f.parent.resolve() != OUTPUT_FOLDER.resolve()
])


print("=" * 70)
print("EXACT EXCEL MERGE")
print("=" * 70)

print(f"Input files found: {len(excel_files):,}")
print()


# ============================================================
# CREATE OUTPUT WORKBOOK
# ============================================================

output_wb = Workbook(write_only=True)
output_ws = output_wb.create_sheet("Data")


# ============================================================
# VARIABLES
# ============================================================

header_written = False
total_rows = 0


# ============================================================
# PROCESS EVERY FILE
# ============================================================

for file_number, file_path in enumerate(excel_files, start=1):

    print(
        f"[{file_number}/{len(excel_files)}] "
        f"{file_path.name}"
    )

    file_rows = 0

    try:

        # Open source file
        wb = load_workbook(
            file_path,
            read_only=True,
            data_only=False
        )

        # Use the active sheet
        ws = wb.active

        # Read rows
        rows = ws.iter_rows(values_only=True)

        # ----------------------------------------------------
        # FIRST ROW = HEADER
        # ----------------------------------------------------

        try:
            header = next(rows)

        except StopIteration:
            print("   ⚠ Empty file - skipped")
            wb.close()
            continue


        # ----------------------------------------------------
        # WRITE HEADER ONLY ONCE
        # ----------------------------------------------------

        if not header_written:

            output_ws.append(header)

            header_written = True


        # ----------------------------------------------------
        # COPY EVERY OTHER ROW
        # ----------------------------------------------------

        for row in rows:

            # NO FILTERING
            # NO DEDUPLICATION
            # NO CLEANING
            # NO EMPTY-ROW REMOVAL

            output_ws.append(row)

            file_rows += 1
            total_rows += 1


        wb.close()


        print(
            f"   ✓ Rows copied: {file_rows:,}"
        )


    except Exception as e:

        print()
        print(f"   ❌ ERROR: {file_path.name}")
        print(f"      {e}")
        print("      Continuing...")
        print()


# ============================================================
# SAVE ONE OUTPUT FILE
# ============================================================

print()
print("Saving output file...")

output_wb.save(OUTPUT_FILE)
output_wb.close()


# ============================================================
# FINAL SUMMARY
# ============================================================

print()
print("=" * 70)
print("MERGE FINISHED")
print("=" * 70)

print(f"Input files : {len(excel_files):,}")
print(f"Data rows   : {total_rows:,}")
print(f"Output file : {OUTPUT_FILE}")

print()
print("=" * 70)
print("DONE")
print("=" * 70)
