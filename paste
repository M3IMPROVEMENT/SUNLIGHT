def clean_tva(value):
    """
    Belgian TVA normalization.

    BE0476241591
    0476.241.591
    0476241591
    be 0476241591

    all become:

    0476241591
    """

    if pd.isna(value):
        return ""

    value = str(value).strip().upper()

    if value in ["", "NAN", "NONE", "NULL"]:
        return ""

    # Excel decimals
    value = re.sub(r"\.0+$", "", value)

    # Remove BE
    if value.startswith("BE"):
        value = value[2:]

    # Digits only
    value = re.sub(r"\D", "", value)

    # Belgian enterprise number normally 10 digits
    if len(value) == 9:
        value = "0" + value

    return value


def normalize_text(value):
    """
    Normalize company names and addresses
    before comparing them.
    """

    if pd.isna(value):
        return ""

    value = str(value).strip().upper()

    if value in ["", "NAN", "NONE", "NULL"]:
        return ""

    # Remove accents
    value = unicodedata.normalize("NFKD", value)

    value = "".join(
        c for c in value
        if not unicodedata.combining(c)
    )

    # Replace punctuation by spaces
    value = re.sub(r"[^A-Z0-9]+", " ", value)

    # Remove extra spaces
    value = re.sub(r"\s+", " ", value)

    return value.strip()


def similarity(a, b):

    a = normalize_text(a)
    b = normalize_text(b)

    if not a or not b:
        return 0

    return SequenceMatcher(
        None,
        a,
        b
    ).ratio() * 100


