from pathlib import Path
import pandas as pd
import csv
import re

# ============================================================
# STEP 2
# MASTER CSV
#      ↓
# GSM + TEL1 + TEL2 + TEL3
#      ↓
# ONE TELEPHONE PER ROW
#      ↓
# SEPARATE OUTPUT FILES BY SOURCE
#
# NOTHING IS DELETED:
# - No duplicates removed
# - No phone cleaning
# - No phone validation
# - No filtering
# - Empty values are preserved
# ============================================================


# ============================================================
# 1. SELECT YOUR MASTER CSV
# ============================================================

MASTER_FILE = Path(
    r"C:\YOUR_FOLDER_HERE\MASTER_XXXXXXXX_XXXXXX.csv"
)


# ============================================================
# 2. OUTPUT FOLDER
# ============================================================

OUTPUT_FOLDER = MASTER_FILE.parent / "TELEPHONE_OUTPUT"
OUTPUT_FOLDER.mkdir(exist_ok=True)


# ============================================================
# 3. COLUMNS
# ============================================================

PHONE_COLUMNS = [
    "GSM",
    "TEL1",
    "TEL2",
    "TEL3"
]

BASE_COLUMNS = [
    "STE",
    "TVA",
    "NOM",
    "ADRESSE",
    "NUMERO",
    "COMPLEMENT",
    "CP",
    "VILLE"
]

FINAL_COLUMNS = BASE_COLUMNS + [
    "TELEPHONE",
    "SOURCE"
]


# ============================================================
# 4. MAXIMUM ROWS PER OUTPUT FILE
#
# Excel maximum = 1,048,576 rows
#
# We use 1,000,000 to leave a safety margin.
# ============================================================

MAX_ROWS_PER_FILE = 1_000_000


# ============================================================
# 5. READ MASTER CSV IN CHUNKS
# ============================================================

CHUNK_SIZE = 100_000


print("=" * 75)
print("STEP 2 - TELEPHONE SEPARATION")
print("=" * 75)

print(f"Master file: {MASTER_FILE}")
print(f"Output folder: {OUTPUT_FOLDER}")
print()


# ============================================================
# SOURCE FILE HANDLES
# ============================================================

current_source = None
current_part = 1
current_rows = 0
current_writer = None
current_file_handle = None

source_file_number = 0

total_input_rows = 0
total_output_rows = 0
total_files_created = 0


# ============================================================
# FUNCTION: MAKE SAFE FILE NAME
# ============================================================

def safe_filename(name):

    name = str(name)

    # Remove extension
    name = Path(name).stem

    # Replace characters that Windows doesn't like
    name = re.sub(r'[<>:"/\\|?*]', '_', name)

    # Avoid extremely long names
    name = name[:120]

    return name


# ============================================================
# FUNCTION: CLOSE CURRENT OUTPUT
# ============================================================

def close_output():

    global current_writer
    global current_file_handle

    if current_file_handle is not None:

        current_file_handle.close()

        current_file_handle = None
        current_writer = None


# ============================================================
# FUNCTION: OPEN NEW OUTPUT FILE
# ============================================================

def open_output(source, part):

    global current_writer
    global current_file_handle
    global total_files_created

    safe_source = safe_filename(source)

    filename = (
        f"TELEPHONE_{safe_source}_Part{part:03d}.csv"
    )

    output_path = OUTPUT_FOLDER / filename

    current_file_handle = open(
        output_path,
        "w",
        newline="",
        encoding="utf-8-sig"
    )

    current_writer = csv.writer(
        current_file_handle
    )

    # Header
    current_writer.writerow(FINAL_COLUMNS)

    total_files_created += 1

    print(f"\nCreated: {filename}")

    return output_path


# ============================================================
# READ MASTER
# ============================================================

for chunk in pd.read_csv(
    MASTER_FILE,
    dtype=str,
    keep_default_na=False,
    chunksize=CHUNK_SIZE,
    encoding="utf-8-sig"
):

    # --------------------------------------------------------
    # Make sure required columns exist
    # --------------------------------------------------------

    missing = [
        col
        for col in PHONE_COLUMNS
        if col not in chunk.columns
    ]

    if missing:

        close_output()

        raise Exception(
            f"Missing phone columns: {missing}"
        )


    if "SOURCE" not in chunk.columns:

        close_output()

        raise Exception(
            "SOURCE column is missing from the Master CSV."
        )


    total_input_rows += len(chunk)


    # ========================================================
    # PROCESS EACH ORIGINAL ROW
    # ========================================================

    for _, row in chunk.iterrows():

        source = row["SOURCE"]


        # ----------------------------------------------------
        # SOURCE CHANGED
        # ----------------------------------------------------

        if source != current_source:

            close_output()

            current_source = source
            current_part = 1
            current_rows = 0

            source_file_number += 1

            print(
                f"\nProcessing source "
                f"{source_file_number}: {source}"
            )


        # ----------------------------------------------------
        # GET THE FOUR PHONE CELLS
        #
        # IMPORTANT:
        # We DO NOT split a cell.
        #
        # If GSM contains "047111/048222",
        # it stays exactly as "047111/048222".
        # ----------------------------------------------------

        phones = []

        for phone_column in PHONE_COLUMNS:

            value = row[phone_column]

            if value != "":
                phones.append(value)


        # ----------------------------------------------------
        # IF THERE ARE PHONES
        # ONE PHONE = ONE ROW
        # ----------------------------------------------------

        if phones:

            for phone in phones:

                # Need another file?
                if current_rows >= MAX_ROWS_PER_FILE:

                    close_output()

                    current_part += 1
                    current_rows = 0

                # Open first/new file
                if current_writer is None:

                    open_output(
                        current_source,
                        current_part
                    )

                output_row = [
                    row.get("STE", ""),
                    row.get("TVA", ""),
                    row.get("NOM", ""),
                    row.get("ADRESSE", ""),
                    row.get("NUMERO", ""),
                    row.get("COMPLEMENT", ""),
                    row.get("CP", ""),
                    row.get("VILLE", ""),
                    phone,
                    source
                ]

                current_writer.writerow(output_row)

                current_rows += 1
                total_output_rows += 1


        # ----------------------------------------------------
        # NO PHONE AT ALL
        #
        # WE KEEP THE ORIGINAL ROW.
        # TELEPHONE IS EMPTY.
        #
        # This ensures that NOTHING is deleted.
        # ----------------------------------------------------

        else:

            if current_rows >= MAX_ROWS_PER_FILE:

                close_output()

                current_part += 1
                current_rows = 0

            if current_writer is None:

                open_output(
                    current_source,
                    current_part
                )

            output_row = [
                row.get("STE", ""),
                row.get("TVA", ""),
                row.get("NOM", ""),
                row.get("ADRESSE", ""),
                row.get("NUMERO", ""),
                row.get("COMPLEMENT", ""),
                row.get("CP", ""),
                row.get("VILLE", ""),
                "",
                source
            ]

            current_writer.writerow(output_row)

            current_rows += 1
            total_output_rows += 1


# ============================================================
# CLOSE FINAL FILE
# ============================================================

close_output()


# ============================================================
# FINAL REPORT
# ============================================================

print("\n")
print("=" * 75)
print("STEP 2 FINISHED")
print("=" * 75)

print(
    f"Original Master rows : {total_input_rows:,}"
)

print(
    f"Final telephone rows : {total_output_rows:,}"
)

print(
    f"Output files created : {total_files_created:,}"
)

print(
    f"\nOutput folder:\n{OUTPUT_FOLDER}"
)

print("\n✓ TELEPHONE SEPARATION COMPLETED")
print("✓ No duplicates removed")
print("✓ No phone numbers cleaned")
print("✓ No phone numbers validated")
print("✓ Empty-phone rows preserved")
print("✓ Files split to remain Excel-readable")
