import pandas as pd
import re

# ============================================================
# INPUT FILE
# ============================================================
input_file = "master_final_table.xlsx"

# OUTPUT FILES
clean_file = "phones_clean.xlsx"
check_file = "GSM_CHECK.xlsx"


# ============================================================
# READ FILE
# ============================================================
df = pd.read_excel(input_file, dtype=str)

if "GSM" not in df.columns:
    raise ValueError("Column 'GSM' was not found.")


# ============================================================
# CLEAN NUMBER
# ============================================================
def clean_number(value):

    if pd.isna(value):
        return ""

    value = str(value).strip()

    if value == "":
        return ""

    # Keep digits only
    number = re.sub(r"\D", "", value)

    # Remove 0032 from beginning
    if number.startswith("0032"):
        number = number[4:]

    # Remove 32 from beginning
    elif number.startswith("32"):
        number = number[2:]

    # Remove 0 from beginning
    if number.startswith("0"):
        number = number[1:]

    return number


# ============================================================
# CLASSIFY NUMBER
# ============================================================
def classify_number(value):

    number = clean_number(value)

    if number == "":
        return "", ""

    # 9 digits = GSM
    if len(number) == 9:
        return number, "GSM"

    # 8 digits = FIXE
    elif len(number) == 8:
        return number, "FIXE"

    # Anything else = CHECK
    else:
        return number, "CHECK"


# ============================================================
# APPLY
# ============================================================
df[["PHONE_CLEAN", "TYPE"]] = df["GSM"].apply(
    lambda x: pd.Series(classify_number(x))
)


# ============================================================
# VALID NUMBERS
# GSM + FIXE IN ONE FILE
# ============================================================
clean_df = df[df["TYPE"].isin(["GSM", "FIXE"])].copy()

# Replace GSM with cleaned number
clean_df["GSM"] = clean_df["PHONE_CLEAN"]

# Remove helper column
clean_df.drop(
    columns=["PHONE_CLEAN"],
    inplace=True
)

clean_df.to_excel(clean_file, index=False)


# ============================================================
# CHECK NUMBERS IN SEPARATE FILE
# ============================================================
check_df = df[df["TYPE"] == "CHECK"].copy()

# Keep the original number
check_df.rename(
    columns={"GSM": "GSM_ORIGINAL"},
    inplace=True
)

# Rename cleaned number
check_df.rename(
    columns={"PHONE_CLEAN": "GSM_CLEAN"},
    inplace=True
)

check_df.to_excel(check_file, index=False)


# ============================================================
# SUMMARY
# ============================================================
print("========================================")
print("DONE")
print("========================================")

print(f"Clean file : {clean_file}")
print(f"Check file : {check_file}")

print("\nResults:")
print(f"GSM   : {len(df[df['TYPE'] == 'GSM'])}")
print(f"FIXE  : {len(df[df['TYPE'] == 'FIXE'])}")
print(f"CHECK : {len(df[df['TYPE'] == 'CHECK'])}")
