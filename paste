input_wb = openpyxl.load_workbook(
    INPUT_FILE,
    read_only=True,
    data_only=False
)

output_wb = openpyxl.Workbook(
    write_only=True
)


# ============================================================
# COUNTERS
# ============================================================

original_rows = 0
output_rows = 0
split_rows = 0
phones_found = 0
empty_rows = 0


# ============================================================
# PROCESS EACH SHEET
# ============================================================

for ws in input_wb.worksheets:

    print()
    print("SHEET:", ws.title)

    output_ws = output_wb.create_sheet(
        title=ws.title
    )

    rows = ws.iter_rows()

    try:
        header = next(rows)
    except StopIteration:
        continue

    header_values = [
        cell.value
        for cell in header
    ]

    # --------------------------------------------------------
    # FIND TELE COLUMN
    # --------------------------------------------------------

    tele_index = None

    for i, value in enumerate(header_values):

        if value is not None:

            if str(value).strip().upper() == TELE_COLUMN:
                tele_index = i
                break

    if tele_index is None:

        print("TELE column not found.")
        output_ws.append(header_values)

        for row in rows:
            output_ws.append([
                cell.value
                for cell in row
            ])

        continue

    # Write header
    output_ws.append(header_values)

    # ========================================================
    # ROWS
    # ========================================================

    for excel_row, row in enumerate(
        rows,
        start=2
    ):

        original_rows += 1

        values = [
            cell.value
            for cell in row
        ]

        tele_value = values[tele_index]

        # ----------------------------------------------------
        # EMPTY
        # ----------------------------------------------------

        if (
            tele_value is None
            or str(tele_value).strip() == ""
        ):

            output_ws.append(values)

            output_rows += 1
            empty_rows += 1

            continue

        # ----------------------------------------------------
        # EXTRACT
        # ----------------------------------------------------

        numbers = extract_numbers(
            tele_value
        )

        # Safety
        numbers = [
            x for x in numbers
            if x
        ]

        # ----------------------------------------------------
        # NOTHING FOUND
        # ----------------------------------------------------

        if not numbers:

            output_ws.append(values)

            output_rows += 1

            continue

        # ----------------------------------------------------
        # MORE THAN ONE NUMBER
        # ----------------------------------------------------

        if len(numbers) > 1:

            split_rows += 1

            print(
                f"[SPLIT] Row {excel_row}: "
                f"{tele_value}  -->  "
                f"{' | '.join(numbers)}"
            )

        # ----------------------------------------------------
        # WRITE EACH NUMBER
        # ----------------------------------------------------

        for number in numbers:

            new_row = values.copy()

            new_row[tele_index] = number

            output_ws.append(
                new_row
            )

            output_rows += 1
            phones_found += 1

        # Progress
        if original_rows % 10000 == 0:

            print(
                f"Progress: "
                f"{original_rows:,} rows | "
                f"Output: {output_rows:,} | "
                f"Split: {split_rows:,}"
            )


