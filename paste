import re

def clean_tele(value):
    if value is None:
        return None

    # Preserve formulas
    if isinstance(value, str) and value.startswith("="):
        return value

    # Handle Excel numeric values such as 471234567.0
    if isinstance(value, float) and value.is_integer():
        value = int(value)

    # Convert to text and remove everything except digits
    digits = re.sub(r"[^0-9]", "", str(value))

    # If no digits remain, leave the cell blank
    return digits if digits else None
