import re
import sys
import pandas as pd

# ====== SETTINGS ======
INPUT_FILE = "data.xlsx"          # your file (.xlsx or .csv)
OUTPUT_FILE = "data_split.xlsx"   # result file
PHONE_COLUMN = "tele"             # name of the phone column
# ======================

# Belgian numbers: GSM = 10 digits (04xx...), landline = 9 digits (02, 03, 09, ...)
LENGTHS = (10, 9)


def segment(digits):
    """Cut a long digit string into pieces of 10 or 9 digits, each starting with 0."""
    if digits == "":
        return []
    for n in LENGTHS:
        if len(digits) >= n and digits[0] == "0":
            rest = segment(digits[n:])
            if rest is not None:
                return [digits[:n]] + rest
    return None  # impossible to cut


def split_cell(value):
    if pd.isna(value):
        return [value]                      # keep the empty row as it is
    text = str(value).strip()
    text = re.sub(r"\.0$", "", text)        # 475123456.0 -> 475123456
    text = text.replace("(0)", "")          # +32 (0)475... -> +32 475...
    text = re.sub(r"\+32|0032", "0", text)  # international -> national
    digits = re.sub(r"\D", "", text)        # keep digits only

    if len(digits) <= 10:
        return [digits]                     # normal number, nothing to split

    parts = segment(digits)
    return parts if parts else [digits]     # if it can't be cut, keep it unchanged


def main():
    inp = sys.argv[1] if len(sys.argv) > 1 else INPUT_FILE
    out = sys.argv[2] if len(sys.argv) > 2 else OUTPUT_FILE

    if inp.lower().endswith(".csv"):
        df = pd.read_csv(inp, dtype=str)
    else:
        df = pd.read_excel(inp, dtype=str)

    col = next((c for c in df.columns if str(c).strip().lower() == PHONE_COLUMN.lower()), None)
    if col is None:
        raise SystemExit(f"Column '{PHONE_COLUMN}' not found. Columns: {list(df.columns)}")

    df[col] = df[col].apply(split_cell)
    df = df.explode(col, ignore_index=True)   # other columns are repeated

    if out.lower().endswith(".csv"):
        df.to_csv(out, index=False, encoding="utf-8-sig")
    else:
        df.to_excel(out, index=False)

    print(f"Done: {len(df)} rows saved in {out}")


if __name__ == "__main__":
    main()
