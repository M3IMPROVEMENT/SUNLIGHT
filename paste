import pandas as pd
from pathlib import Path

# ============================================================
# CONFIG
# ============================================================

input_folder = Path(
    r"C:\Users\Sunlight\Desktop\01-10-26\#NET"
)

output_folder = Path(
    r"C:\Users\Sunlight\Desktop\01-10-26\#NET\CLEAN_PHONE\MERGE-TELE"
)

output_folder.mkdir(parents=True, exist_ok=True)

phone_columns = ["GSM", "TEL1", "TEL2", "TEL3"]

# ============================================================
# FIND EXCEL FILES
# ============================================================

excel_files = [
    f for f in input_folder.glob("*.xlsx")
    if not f.name.startswith("~$")
]

print(f"Excel files found: {len(excel_files)}")

# ============================================================
# PROCESS EACH FILE
# ============================================================

total_original_rows = 0
total_final_rows = 0
errors = []

for input_file in excel_files:

    try:
        print(f"\nProcessing: {input_file.name}")

        # Read file
        df = pd.read_excel(input_file, dtype=str)
        df = df.fillna("")

        total_original_rows += len(df)

        # Check phone columns
        for col in phone_columns:
            if col not in df.columns:
                df[col] = ""

        rows = []

        # Create one row per phone number
        for _, row in df.iterrows():

            phones_found = False

            for col in phone_columns:
                phone = str(row[col]).strip()

                if phone != "":
                    phones_found = True

                    new_row = row.copy()
                    new_row["TELE"] = phone
                    rows.append(new_row)

            # Preserve rows with no phone number
            if not phones_found:
                new_row = row.copy()
                new_row["TELE"] = ""
                rows.append(new_row)

        # Build final DataFrame
        result = pd.DataFrame(rows)

        # Remove original phone columns
        result = result.drop(
            columns=phone_columns,
            errors="ignore"
        )

        # Save with the original filename
        output_file = output_folder / (
            input_file.stem + "_TELE.xlsx"
        )

        result.to_excel(output_file, index=False)

        total_final_rows += len(result)

        print(f"Original rows: {len(df):,}")
        print(f"Final rows:    {len(result):,}")
        print(f"Saved: {output_file}")

    except Exception as e:
        errors.append((input_file.name, str(e)))
        print(f"ERROR processing {input_file.name}: {e}")

# ============================================================
# SUMMARY
# ============================================================

print("\n" + "=" * 50)
print("PROCESSING FINISHED")
print("=" * 50)

print(f"Files found:          {len(excel_files)}")
print(f"Original rows:        {total_original_rows:,}")
print(f"Final rows:           {total_final_rows:,}")
print(f"Files with errors:    {len(errors)}")
print(f"Output folder:        {output_folder}")

if errors:
    print("\nFILES WITH ERRORS:")
    for filename, error in errors:
        print(f"- {filename}: {error}")
