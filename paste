import pandas as pd
from pathlib import Path

# =========================
# SETTINGS
# =========================
folder = Path(r"C:\Users\YOUR_NAME\Desktop\MY_FILES")
output_folder = folder / "MERGED_OUTPUT"
output_folder.mkdir(exist_ok=True)

rows_per_file = 800_000   # keep each output manageable

# =========================
# MERGE
# =========================
excel_files = list(folder.glob("*.xlsx"))

print(f"Found {len(excel_files)} Excel files")

output_number = 1
current_rows = []
current_count = 0

for i, file in enumerate(excel_files, start=1):

    print(f"[{i}/{len(excel_files)}] Reading: {file.name}")

    try:
        df = pd.read_excel(file, dtype=str)

        current_rows.append(df)
        current_count += len(df)

        # Save once we reach approximately 800,000 rows
        if current_count >= rows_per_file:

            merged = pd.concat(current_rows, ignore_index=True)

            while len(merged) >= rows_per_file:

                part = merged.iloc[:rows_per_file]

                output_file = output_folder / f"merged_part_{output_number}.csv"

                part.to_csv(
                    output_file,
                    index=False,
                    encoding="utf-8-sig"
                )

                print(f"Saved: {output_file.name}")

                output_number += 1
                merged = merged.iloc[rows_per_file:]

            current_rows = [merged] if len(merged) > 0 else []
            current_count = len(merged)

    except Exception as e:
        print(f"ERROR in {file.name}: {e}")

# =========================
# SAVE REMAINING ROWS
# =========================
if current_rows:

    merged = pd.concat(current_rows, ignore_index=True)

    output_file = output_folder / f"merged_part_{output_number}.csv"

    merged.to_csv(
        output_file,
        index=False,
        encoding="utf-8-sig"
    )

    print(f"Saved: {output_file.name}")

print("DONE")
