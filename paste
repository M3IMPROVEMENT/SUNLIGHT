import pandas as pd
from pathlib import Path
import math

# ============================================================
# CONFIG
# ============================================================

input_file = Path(r"C:\Users\Sunlight\Desktop\input.xlsx")
output_folder = Path(r"C:\Users\Sunlight\Desktop\telephone_parts")

output_folder.mkdir(parents=True, exist_ok=True)

# Excel maximum rows per sheet
MAX_EXCEL_ROWS = 1_048_576

# ============================================================
# READ FILE
# ============================================================

df = pd.read_excel(input_file, dtype=str)

# Keep empty cells as empty strings
df = df.fillna("")

# Phone columns
phone_columns = ["GSM", "TEL1", "TEL2", "TEL3"]

# Make sure all phone columns exist
for col in phone_columns:
    if col not in df.columns:
        df[col] = ""

# ============================================================
# CREATE ONE ROW PER PHONE
# ============================================================

rows = []

for _, row in df.iterrows():

    phones_found = False

    for col in phone_columns:

        phone = str(row[col]).strip()

        if phone != "":
            phones_found = True

            new_row = row.copy()

            # Put the phone into TELE
            new_row["TELE"] = phone

            rows.append(new_row)

    # Keep rows that have no telephone
    if not phones_found:
        new_row = row.copy()
        new_row["TELE"] = ""

        rows.append(new_row)

# ============================================================
# CREATE FINAL DATAFRAME
# ============================================================

result = pd.DataFrame(rows)

# Remove original phone columns
result = result.drop(columns=phone_columns)

# ============================================================
# SPLIT INTO EXCEL PARTS
# ============================================================

total_rows = len(result)

# Excel can handle 1,048,576 rows, but the header
# occupies one row, so use 1,048,575 data rows.
MAX_DATA_ROWS = MAX_EXCEL_ROWS - 1

number_of_parts = math.ceil(total_rows / MAX_DATA_ROWS)

print("--------------------------------------------")
print(f"Original rows : {len(df):,}")
print(f"Final rows    : {total_rows:,}")
print(f"Number parts  : {number_of_parts}")
print("--------------------------------------------")

for part_number in range(number_of_parts):

    start = part_number * MAX_DATA_ROWS
    end = start + MAX_DATA_ROWS

    part = result.iloc[start:end]

    output_file = output_folder / f"telephone_part{part_number + 1}.xlsx"

    part.to_excel(
        output_file,
        index=False
    )

    print(
        f"Part {part_number + 1}: "
        f"{len(part):,} rows → {output_file.name}"
    )

print("--------------------------------------------")
print("DONE")
print(f"Files saved in: {output_folder}")
