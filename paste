import pandas as pd
import re

# ============================================================
# SETTINGS
# ============================================================

INPUT_FILE = r"C:\Users\YourName\Desktop\input.xlsx"
OUTPUT_FILE = r"C:\Users\YourName\Desktop\tele_clean_deduplicated.xlsx"

TELE_COLUMN = "TELE"


# ============================================================
# CLEAN TELEPHONE
# ============================================================

def clean_tele(value):

    if pd.isna(value):
        return ""

    value = str(value).strip()

    # Remove Excel .0
    value = re.sub(r"\.0+$", "", value)

    # Keep digits only
    value = re.sub(r"\D", "", value)

    if not value:
        return ""

    # Remove Belgian international prefix
    if value.startswith("0032"):
        value = value[4:]

    elif value.startswith("32"):
        value = value[2:]

    # Remove Belgian national 0
    elif value.startswith("0"):
        value = value[1:]

    return value


# ============================================================
# READ FILE
# ============================================================

print("Reading file...")

df = pd.read_excel(INPUT_FILE, dtype={TELE_COLUMN: str})

print(f"Rows before cleaning: {len(df):,}")


# ============================================================
# CHECK COLUMN
# ============================================================

if TELE_COLUMN not in df.columns:
    raise ValueError(
        f"Column '{TELE_COLUMN}' was not found.\n"
        f"Available columns: {list(df.columns)}"
    )


# ============================================================
# CLEAN TELE
# ============================================================

df[TELE_COLUMN] = df[TELE_COLUMN].apply(clean_tele)

print("TELE column cleaned.")


# ============================================================
# DEDUPLICATE ONLY NON-EMPTY TELE
# ============================================================

# Separate rows with TELE from rows without TELE
has_tele = df[TELE_COLUMN].ne("")
no_tele = df[TELE_COLUMN].eq("")

# Deduplicate ONLY rows that contain a TELE number
with_tele = df.loc[has_tele].copy()

before_duplicates = len(with_tele)

with_tele = with_tele.drop_duplicates(
    subset=[TELE_COLUMN],
    keep="first"
)

duplicates_removed = before_duplicates - len(with_tele)

# Keep ALL empty TELE rows
empty_tele_rows = df.loc[no_tele].copy()

# Put everything back together
df = pd.concat(
    [with_tele, empty_tele_rows],
    ignore_index=True
)


# ============================================================
# SAVE
# ============================================================

df.to_excel(
    OUTPUT_FILE,
    index=False,
    engine="openpyxl"
)


# ============================================================
# SUMMARY
# ============================================================

print("\n" + "=" * 50)
print("DONE")
print("=" * 50)

print(f"Original rows       : {len(df) + duplicates_removed:,}")
print(f"Duplicates removed  : {duplicates_removed:,}")
print(f"Final rows          : {len(df):,}")
print(f"Empty TELE rows kept: {len(empty_tele_rows):,}")

print("\nOutput:")
print(OUTPUT_FILE)
