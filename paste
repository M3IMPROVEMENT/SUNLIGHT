import pandas as pd
import os

# ============================================================
# 1. INPUT FILE
# ============================================================

input_file = r"C:\Users\Sunlight\Desktop\your_file.xlsx"

# Output file
output_file = os.path.splitext(input_file)[0] + "_telephone.xlsx"


# ============================================================
# 2. COLUMNS
# ============================================================

# Columns containing telephone numbers
phone_columns = ["GSM", "TEL1", "TEL2", "TEL3"]

# All other information to keep
info_columns = [
    "STE",
    "TVA",
    "NOM",
    "ADRESSE",
    "NUMERO",
    "COMPLEMENT",
    "CP",
    "VILLE"
]


# ============================================================
# 3. READ EXCEL
# ============================================================

df = pd.read_excel(input_file, dtype=str)

# Remove spaces from column names
df.columns = df.columns.str.strip()


# ============================================================
# 4. MAKE SURE PHONE COLUMNS EXIST
# ============================================================

for col in phone_columns:
    if col not in df.columns:
        df[col] = ""


# Make sure information columns exist
for col in info_columns:
    if col not in df.columns:
        df[col] = ""


# ============================================================
# 5. KEEP ONLY THE REQUIRED INFORMATION
# ============================================================

df = df[info_columns + phone_columns].copy()


# ============================================================
# 6. CLEAN PHONE COLUMNS
# ============================================================

for col in phone_columns:
    df[col] = (
        df[col]
        .fillna("")
        .astype(str)
        .str.strip()
        .str.replace(r"\.0$", "", regex=True)
    )


# ============================================================
# 7. PUT GSM + TEL1 + TEL2 + TEL3 INTO ONE COLUMN
# ============================================================

result = df.melt(
    id_vars=info_columns,
    value_vars=phone_columns,
    var_name="SOURCE",
    value_name="TELEPHONE"
)


# ============================================================
# 8. REMOVE EMPTY TELEPHONE ROWS
# ============================================================

result["TELEPHONE"] = result["TELEPHONE"].str.strip()

result = result[result["TELEPHONE"] != ""].copy()


# ============================================================
# 9. REMOVE THE SOURCE COLUMN
# ============================================================

result = result.drop(columns=["SOURCE"])


# ============================================================
# 10. FINAL COLUMN ORDER
# ============================================================

final_columns = [
    "STE",
    "TVA",
    "NOM",
    "ADRESSE",
    "NUMERO",
    "COMPLEMENT",
    "CP",
    "VILLE",
    "TELEPHONE"
]

result = result[final_columns]


# ============================================================
# 11. SAVE
# ============================================================

result.to_excel(output_file, index=False)

print("========================================")
print("DONE!")
print("========================================")
print(f"Input file : {input_file}")
print(f"Output file: {output_file}")
print(f"Total telephone rows: {len(result):,}")
print("========================================")
