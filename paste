import pandas as pd
import re

# ============================================================
# FILE PATHS
# ============================================================

input_file = r"C:\Users\Sunlight\Desktop\your_file.xlsx"

output_file = r"C:\Users\Sunlight\Desktop\TVA_TO_CHECK_KBO.xlsx"


# ============================================================
# CLEAN TVA
# ============================================================

def clean_tva(value):

    if pd.isna(value):
        return ""

    value = str(value).strip().upper()

    if value in ["", "NAN", "NONE", "NULL"]:
        return ""

    # Remove Excel .000000
    value = re.sub(r"\.0+$", "", value)

    # Remove BE
    if value.startswith("BE"):
        value = value[2:]

    # Keep digits only
    value = re.sub(r"\D", "", value)

    # Belgian enterprise numbers = 10 digits
    # Sometimes Excel/data has removed the first 0
    if len(value) == 9:
        value = "0" + value

    return value


# ============================================================
# READ YOUR FILE
# ============================================================

df = pd.read_excel(
    input_file,
    dtype=str
)

df.columns = (
    df.columns
    .astype(str)
    .str.strip()
    .str.upper()
)


if "TVA" not in df.columns:
    raise ValueError("TVA column not found.")


print("Rows in original file:", len(df))


# ============================================================
# NORMALIZE TVA
# ============================================================

df["_TVA_CHECK"] = df["TVA"].apply(clean_tva)


# ============================================================
# IGNORE EMPTY TVA
# ============================================================

valid = df[
    df["_TVA_CHECK"] != ""
].copy()


# ============================================================
# FIND DUPLICATED TVA
# ============================================================

duplicates = valid[
    valid["_TVA_CHECK"].duplicated(
        keep=False
    )
].copy()


print(
    "Rows involved in TVA duplicates:",
    len(duplicates)
)


# ============================================================
# COUNT HOW MANY TIMES EACH TVA EXISTS
# ============================================================

counts = (
    duplicates["_TVA_CHECK"]
    .value_counts()
    .reset_index()
)

counts.columns = [
    "TVA",
    "NUMBER_OF_ROWS"
]


# ============================================================
# ADD BELGIAN TVA FORMAT
# ============================================================

counts["TVA_BE"] = (
    "BE" + counts["TVA"]
)


# ============================================================
# CREATE KBO LINK
# ============================================================

# Direct enterprise page
counts["KBO_LINK"] = counts["TVA"].apply(
    lambda x:
    f"https://kbopub.economie.fgov.be/kbopub-m/enterprise/{x}?lang=fr"
)


# ============================================================
# SAVE
# ============================================================

counts.to_excel(
    output_file,
    index=False
)


print()
print("Different duplicated TVA:", len(counts))

print()
print("File created:")
print(output_file)

print()
print("DONE ✅")
