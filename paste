import re

VAT_RE = re.compile(r"\bBE[\s.]?(0?\d{3})[\s.]?(\d{3})[\s.]?(\d{3})\b", re.I)

def valid_be_vat(digits: str) -> bool:
    # digits = 10 chiffres ; contrôle modulo 97
    return len(digits) == 10 and 97 - int(digits[:8]) % 97 == int(digits[8:])

def extract_vat(page) -> str:
    text = page.inner_text("body")
    for m in VAT_RE.finditer(text):
        d = "".join(m.groups()).rjust(10, "0")
        if valid_be_vat(d):
            return f"BE{d}"
    return "-"
