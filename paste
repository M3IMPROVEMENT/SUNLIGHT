# ============================================================
# DIGITS
# ============================================================

def digits_only(value):
    if value is None:
        return ""

    s = str(value).strip()

    # Excel numeric value such as 43822774.0
    if s.endswith(".0"):
        s = s[:-2]

    return re.sub(r"\D", "", s)


# ============================================================
# NORMALIZE ONE PHONE
# ============================================================

def normalize_phone(value):

    d = digits_only(value)

    if not d:
        return ""

    # 0032XXXXXXXXX
    if d.startswith("0032"):
        d = d[4:]

    # 32XXXXXXXXX
    elif d.startswith("32") and len(d) >= 11:
        d = d[2:]

    # Belgian national 0
    if d.startswith("0"):
        d = d[1:]

    return d


# ============================================================
# CHECK PLAUSIBLE BELGIAN NUMBER
# ============================================================

def phone_score(value):

    d = digits_only(value)

    if not d:
        return -1000

    score = 0

    # International formats
    if d.startswith("0032"):
        d = d[4:]
        score += 20

    elif d.startswith("32") and len(d) >= 11:
        d = d[2:]
        score += 20

    # National 0
    if d.startswith("0"):
        score += 10
        d = d[1:]

    # Belgian phone after removing country/leading zero:
    # normally 8 or 9 digits
    if len(d) == 8:
        score += 50

    elif len(d) == 9:
        score += 60

    elif len(d) == 10:
        score += 25

    else:
        score -= abs(len(d) - 9) * 10

    # Belgian mobile prefixes
    if d.startswith(("46", "47", "48", "49")):
        score += 15

    # Common fixed-line area prefixes
    if d.startswith((
        "2", "3", "4", "5", "6", "9"
    )):
        score += 5

    return score


# ============================================================
# SPLIT USING EXPLICIT SEPARATORS
# ============================================================

def separator_split(text):

    # Slash, comma, semicolon, pipe
    parts = re.split(
        r"\s*(?:/|;|,|\|)\s*",
        text
    )

    parts = [
        p.strip()
        for p in parts
        if digits_only(p)
    ]

    if len(parts) >= 2:
        return parts

    return None


# ============================================================
# SPLIT SPACE-SEPARATED NUMBERS
# ============================================================

def space_split(text):

    parts = re.split(r"\s+", text.strip())

    if len(parts) < 2:
        return None

    # Check whether the spaces are merely phone formatting.
    #
    # Example:
    # 010 22 25 55
    #
    # This should remain ONE number.
    #
    # But:
    # 010881429 0495541429
    #
    # should become TWO.

    digit_lengths = [
        len(digits_only(p))
        for p in parts
        if digits_only(p)
    ]

    if len(digit_lengths) < 2:
        return None

    # If pieces are small, spaces are formatting.
    if any(x < 7 for x in digit_lengths):
        return None

    # Every piece looks like a phone
    if all(
        phone_score(p) > 20
        for p in parts
    ):
        return parts

    return None


# ============================================================
# FIND BEST SPLIT OF A DIGIT STRING
# ============================================================

def best_concatenated_split(digits):

    """
    Find the most plausible way to divide a long digit string
    into 2 or more Belgian phone numbers.

    We consider phone lengths after normalization:
        8 or 9 digits
    """

    # Dynamic programming.
    #
    # Every possible segment is tested.
    # The highest scoring complete interpretation wins.

    n = len(digits)

    candidates = []

    # --------------------------------------------------------
    # Recursive search
    # --------------------------------------------------------

    def search(position, current):

        if position == n:

            if len(current) >= 2:

                score = sum(
                    phone_score(x)
                    for x in current
                )

                candidates.append(
                    (score, current.copy())
                )

            return

        # Prevent crazy fragmentation
        if len(current) >= 5:
            return

        # Possible normalized phone lengths
        for length in (8, 9, 10):

            end = position + length

            if end > n:
                continue

            piece = digits[position:end]

            # Score candidate
            s = phone_score(piece)

            if s <= 0:
                continue

            current.append(piece)

            search(
                end,
                current
            )

            current.pop()

    search(0, [])

    if not candidates:
        return None

    # Highest total score
    candidates.sort(
        key=lambda x: x[0],
        reverse=True
    )

    return candidates[0][1]


# ============================================================
# EXTRACT ALL NUMBERS FROM ONE CELL
# ============================================================

def extract_numbers(value):

    if value is None:
        return []

    text = str(value).strip()

    if not text:
        return []

    # --------------------------------------------------------
    # 1. Explicit separators
    # --------------------------------------------------------

    result = separator_split(text)

    if result:
        return [
            normalize_phone(x)
            for x in result
            if digits_only(x)
        ]

    # --------------------------------------------------------
    # 2. Space-separated complete phones
    # --------------------------------------------------------

    result = space_split(text)

    if result:
        return [
            normalize_phone(x)
            for x in result
            if digits_only(x)
        ]

    # --------------------------------------------------------
    # 3. Whole value
    # --------------------------------------------------------

    d = digits_only(text)

    # Remove international prefix temporarily
    normalized = normalize_phone(text)

    # If it already looks like ONE phone
    if 8 <= len(normalized) <= 10:
        return [normalized]

    # --------------------------------------------------------
    # 4. Long concatenated value
    # --------------------------------------------------------

    # Try the original digits
    result = best_concatenated_split(d)

    if result:
        return [
            normalize_phone(x)
            for x in result
        ]

    # --------------------------------------------------------
    # 5. Try after removing 0032 / 32
    # --------------------------------------------------------

    if d.startswith("0032"):
        d2 = d[4:]

        result = best_concatenated_split(d2)

        if result:
            return [
                normalize_phone(x)
                for x in result
            ]

    elif d.startswith("32") and len(d) > 11:
        d2 = d[2:]

        result = best_concatenated_split(d2)

        if result:
            return [
                normalize_phone(x)
                for x in result
            ]

    # --------------------------------------------------------
    # 6. FINAL FALLBACK
    # --------------------------------------------------------
    #
    # NOTHING is left for manual checking.
    #
    # If the program cannot confidently split it,
    # it keeps the entire cleaned value as ONE phone.
    #

    return [normalize_phone(text)]


