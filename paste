import pandas as pd
from pathlib import Path
import re

# ==============================
# INPUT FILE
# ==============================
input_file = Path(r"C:\Users\YOUR_NAME\Desktop\INPUT\your_file.xlsx")

# ==============================
# OUTPUT FOLDER
# ==============================
output_folder = Path(r"C:\Users\YOUR_NAME\Desktop\OUTPUT")

# Create output folder if it doesn't exist
output_folder.mkdir(parents=True, exist_ok=True)

# ==============================
# READ FILE
# ==============================
df = pd.read_excel(input_file, dtype=str)

# ==============================
# CLEAN TELE
# ==============================
def clean_tele(value):

    if pd.isna(value):
        return ""

    value = str(value).strip()

    if value == "":
        return ""

    # Remove Excel .0
    value = re.sub(r"\.0$", "", value)

    # Keep digits only
    value = re.sub(r"\D", "", value)

    # Remove Belgian prefixes
    if value.startswith("0032"):
        value = value[4:]
    elif value.startswith("32"):
        value = value[2:]

    # Add 0
    if value and not value.startswith("0"):
        value = "0" + value

    return value


df["TELE"] = df["TELE"].apply(clean_tele)

# ==============================
# OUTPUT
# ==============================
output_file = output_folder / "TELE_cleaned.xlsx"

df.to_excel(output_file, index=False)

print("✅ Cleaning finished!")
print(f"📂 Input : {input_file}")
print(f"📂 Output: {output_file}")
