# ============================================================
# 6. FUNCTION TO FIND KBO KEY COLUMN
# ============================================================

def find_kbo_column(columns):

    possible = [
        "EnterpriseNumber",
        "EntityNumber",
        "enterpriseNumber",
        "entityNumber"
    ]

    for wanted in possible:
        for c in columns:
            if c.lower() == wanted.lower():
                return c

    return None


# ============================================================
# 7. CREATE KBO_KEY
# ============================================================

def add_kbo_key(df):

    key_column = find_kbo_column(df.columns)

    if key_column is None:
        return None, None

    df = df.withColumn(
        "KBO_KEY",
        F.regexp_replace(
            F.trim(F.col(key_column).cast("string")),
            r"[^0-9]",
            ""
        )
    )

    # Remove empty KBO keys
    df = df.filter(
        F.col("KBO_KEY").isNotNull()
        & (F.col("KBO_KEY") != "")
    )

    return df, key_column


# ============================================================
# 8. MAKE SAFE UNIQUE COLUMN NAMES
# ============================================================

def make_unique_columns(columns, source_name):

    result = []
    used = set()

    for c in columns:

        # KBO_KEY is our common key
        if c == "KBO_KEY":
            new_name = "KBO_KEY"

        else:
            new_name = c

        # If duplicate column name exists,
        # add source name.
        if new_name in used:

            base = f"{source_name}_{c}"
            new_name = base

            counter = 2

            while new_name in used:
                new_name = f"{base}_{counter}"
                counter += 1

        used.add(new_name)
        result.append(new_name)

    return result


# ============================================================
# 9. AGGREGATE EACH SOURCE SEPARATELY
# ============================================================

aggregated_tables = []

for csv_file in csv_files:

    source_name = csv_file.stem

    print("\n" + "=" * 70)
    print("PROCESSING:", csv_file.name)
    print("=" * 70)

    # --------------------------------------------------------
    # Read CSV
    # --------------------------------------------------------

    df = (
        spark.read
        .option("header", "true")
        .option("inferSchema", "false")
        .option("multiLine", "true")
        .option("escape", '"')
        .csv(str(csv_file))
    )

    print("Original columns:", len(df.columns))

    # --------------------------------------------------------
    # Find KBO column
    # --------------------------------------------------------

    df, key_column = add_kbo_key(df)

    if df is None:

        print(
            "No EnterpriseNumber / EntityNumber found."
        )

        # Save files such as code.csv/meta.csv separately later
        continue

    print("KBO column:", key_column)

    # --------------------------------------------------------
    # Rename columns to avoid collisions
    #
    # Keep original header meaning.
    # Only prefix source name when necessary.
    # --------------------------------------------------------

    original_columns = [
        c for c in df.columns
        if c != "KBO_KEY"
    ]

    # We prefix source columns.
    # This prevents collisions such as EntityNumber,
    # Language, Type, etc.
    renamed_columns = ["KBO_KEY"]

    for c in original_columns:

        # Keep source name in header so we know where it came from
        new_name = f"{source_name}_{c}"

        df = df.withColumnRenamed(c, new_name)

        renamed_columns.append(new_name)

    # --------------------------------------------------------
    # Keep only required columns
    # --------------------------------------------------------

    df = df.select(renamed_columns)

    # --------------------------------------------------------
    # Remove EXACT duplicate rows first
    # --------------------------------------------------------

    df = df.dropDuplicates()

    # --------------------------------------------------------
    # Aggregate each column by KBO_KEY
    #
    # This is the important part.
    #
    # Instead of:
    #
    # denomination x activity x contact x address
    #
    # we first reduce EACH source to ONE row per KBO.
    #
    # Therefore there is no giant Cartesian multiplication.
    # --------------------------------------------------------

    aggregation_expressions = []

    for c in renamed_columns:

        if c == "KBO_KEY":
            continue

        aggregation_expressions.append(
            F.concat_ws(
                " | ",
                F.sort_array(
                    F.collect_set(
                        F.when(
                            F.trim(F.col(c)) != "",
                            F.trim(F.col(c))
                        )
                    )
                )
            ).alias(c)
        )

    aggregated = (
        df.groupBy("KBO_KEY")
        .agg(*aggregation_expressions)
    )

    print(
        f"Finished aggregation for {source_name}"
    )

    aggregated_tables.append(
        (source_name, aggregated)
    )


# ============================================================
# 10. CHECK
# ============================================================

if not aggregated_tables:

    raise RuntimeError(
