
from pathlib import Path
import pandas as pd
import re

# ============================================================
# CONFIGURATION
# ============================================================

INPUT_FOLDER = Path(r"C:\Users\Sunlight\Desktop\NET\B2B")
OUTPUT_FOLDER = Path(r"C:\Users\Sunlight\Desktop\NET\B2B_TELE_CLEANED")

TELE_HEADERS = {
    "TELE", "TELEPHONE", "TELEPHONES",
    "TEL", "TEL FIXE", "TELE FIXE"
}

# ============================================================
# HELPERS
# ============================================================

def normalize_header(value):
    value = str(value).strip().upper()
    value = value.replace("_", " ")
    return re.sub(r"\s+", " ", value)


def remove_country_prefix(digits):
    """Remove Belgian international prefixes."""
    while digits.startswith("000032"):
        digits = digits[6:]

    while digits.startswith("0032"):
        digits = digits[4:]

    if digits.startswith("32") and len(digits) in (10, 11):
        digits = digits[2:]

    return digits


def digits_only(value):
    if pd.isna(value):
        return ""

    # Handle numeric Excel values ending in .0
    if isinstance(value, float) and value.is_integer():
        value = str(int(value))
    else:
        value = str(value).strip()

    if re.fullmatch(r"\d+\.0+", value):
        value = value.split(".")[0]

    return re.sub(r"\D", "", value)


# ============================================================
# TELE CLEANING AND NUMBER SPLITTING
# ============================================================

def clean_tele(value):
    """
    Returns a list of telephone numbers.

    Example:
        0475/123/456
        -> ["0475123456"]

        048762168/8654890
        -> ["048762168", "8654890"]
    """

    if pd.isna(value) or str(value).strip() == "":
        return [""]

    text = str(value).strip()

    # Split on separators other than slash first.
    # A slash needs special treatment because it can format
    # one number or separate two numbers.
    groups = re.split(r"[;,\n\r|]+", text)

    results = []

    for group in groups:
        group = group.strip()

        if not group:
            continue

        if "/" not in group:
            digits = remove_country_prefix(digits_only(group))
            if digits:
                results.append(digits)
            continue

        # Collect digits across all slash-separated segments.
        joined_digits = digits_only(group.replace("/", ""))

        # A single Belgian local number normally has 9 or 10
        # digits. Treat slash separators as formatting when
        # the complete value fits that length after prefix removal.
        normalized_joined = remove_country_prefix(joined_digits)

        if len(normalized_joined) in (9, 10):
            results.append(normalized_joined)
        else:
            # Multiple numbers: clean each slash-separated part.
            for part in group.split("/"):
                digits = remove_country_prefix(digits_only(part))

                if digits:
                    results.append(digits)

    # Remove duplicate numbers within the same cell.
    return list(dict.fromkeys(results)) or [""]


# ============================================================
# PROCESS WORKBOOK
# ============================================================

def process_file(file):
    sheets = pd.read_excel(
        file,
        sheet_name=None,
        dtype=object,
        engine="openpyxl"
    )

    output_sheets = {}
    total_rows_before = 0
    total_rows_after = 0
    total_tele_numbers = 0
    found_tele = False

    for sheet_name, df in sheets.items():
        total_rows_before += len(df)

        tele_col = next(
            (
                col for col in df.columns
                if normalize_header(col) in TELE_HEADERS
            ),
            None
        )

        if tele_col is None:
            output_sheets[sheet_name] = df
            total_rows_after += len(df)
            continue

        found_tele = True

        # Find each row's cleaned numbers.
        number_lists = df[tele_col].map(clean_tele)

        # Expand rows only when a cell contains multiple numbers.
        row_indices = number_lists.index.repeat(
            number_lists.map(len)
        )

        expanded = df.loc[row_indices].copy()

        expanded[tele_col] = [
            number
            for numbers in number_lists
            for number in numbers
        ]

        total_tele_numbers += sum(
            len(numbers) for numbers in number_lists
        )

        output_sheets[sheet_name] = expanded
        total_rows_after += len(expanded)

    output_file = OUTPUT_FOLDER / f"{file.stem}.xlsx"

    with pd.ExcelWriter(
        output_file,
        engine="openpyxl"
    ) as writer:
        for sheet_name, df in output_sheets.items():
            df.to_excel(
                writer,
                sheet_name=sheet_name,
                index=False
            )

    return {
        "found_tele": found_tele,
        "rows_before": total_rows_before,
        "rows_after": total_rows_after,
        "numbers": total_tele_numbers,
        "output": output_file
    }


# ============================================================
# MAIN
# ============================================================

def main():
    if not INPUT_FOLDER.exists():
        print(f"Input folder not found: {INPUT_FOLDER}")
        return

    OUTPUT_FOLDER.mkdir(parents=True, exist_ok=True)

    files = sorted(
        file for file in INPUT_FOLDER.iterdir()
        if file.is_file()
        and file.suffix.lower() in {".xlsx", ".xlsm"}
        and not file.name.startswith("~$")
        and file.resolve().parent != OUTPUT_FOLDER.resolve()
    )

    if not files:
        print("No Excel files found.")
        return

    print(f"Found {len(files)} files.\n")

    for index, file in enumerate(files, start=1):
        try:
            result = process_file(file)

            status = (
                "TELE cleaned"
                if result["found_tele"]
                else "TELE column not found"
            )

            print(
                f"[{index}/{len(files)}] {file.name} | {status} | "
                f"Rows: {result['rows_before']} -> "
                f"{result['rows_after']}"
            )

        except Exception as error:
            print(f"[{index}/{len(files)}] ERROR: {file.name}: {error}")

    print("\nFinished.")
    print(f"Cleaned Excel files: {OUTPUT_FOLDER}")


if __name__ == "__main__":
    main()
