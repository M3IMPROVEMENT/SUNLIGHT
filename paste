
import re
from pathlib import Path
from openpyxl import load_workbook, Workbook

# =============== CONFIGURATION ===============

INPUT_FILE = Path(r"C:\Users\Sunlight\Desktop\DB\input.xlsx")
OUTPUT_FILE = Path(r"C:\Users\Sunlight\Desktop\DB\separated_numbers.xlsx")

# Put the exact header of the phone column here
PHONE_COLUMN = "TELE"

# =============== PHONE DETECTION ===============

def split_phone_numbers(value):
    if value is None:
        return []

    # Remove Excel float suffix when applicable and keep digits
    text = str(value).strip()
    text = re.sub(r"\.0$", "", text)

    # If there are explicit separators, split them first
    parts = re.split(r"[/;,|\s]+", text)
    candidates = []

    for part in parts:
        digits = re.sub(r"\D", "", part)

        # Convert Belgian international prefixes
        if digits.startswith("0032"):
            digits = "0" + digits[4:]
        elif digits.startswith("32") and len(digits) >= 10:
            digits = "0" + digits[2:]

        if not digits:
            continue

        # Find Belgian numbers inside a concatenated digit string.
        # GSM: 04 followed by 8 digits (10 digits total)
        # Fixed: Belgian numbers beginning 0, generally 9 digits
        i = 0
        while i < len(digits):
            if digits[i] != "0":
                i += 1
                continue

            # Prefer GSM numbers: 046, 047, 048, 049
            if digits[i:i+3] in ("046", "047", "048", "049"):
                length = 10
            else:
                # Common Belgian fixed-line format
                length = 9

            number = digits[i:i+length]

            if len(number) == length:
                candidates.append(number)
                i += length
            else:
                i += 1

    # Remove duplicates while preserving order
    return list(dict.fromkeys(candidates))


def classify(number):
    if re.fullmatch(r"04[6-9]\d{7}", number):
        return "GSM"
    if re.fullmatch(r"0[1-9]\d{7}", number):
        return "FIX"
    return "CHECK"


# =============== PROCESS EXCEL ===============

wb = load_workbook(INPUT_FILE, read_only=True, data_only=True)
ws = wb.active

headers = list(next(ws.iter_rows(min_row=1, max_row=1, values_only=True)))

if PHONE_COLUMN not in headers:
    wb.close()
    raise ValueError(f"Column '{PHONE_COLUMN}' not found. Headers: {headers}")

phone_idx = headers.index(PHONE_COLUMN)

out_wb = Workbook(write_only=True)
out_ws = out_wb.create_sheet("Separated")
out_ws.append(headers + ["TYPE_NUMERO"])

processed = 0
exported = 0
not_detected = 0

for row in ws.iter_rows(min_row=2, values_only=True):
    row = list(row)
    processed += 1

    numbers = split_phone_numbers(row[phone_idx])

    if not numbers:
        # Preserve the original row for manual review
        out_ws.append(row + ["NOT_DETECTED"])
        exported += 1
        not_detected += 1
        continue

    for number in numbers:
        new_row = row.copy()
        new_row[phone_idx] = number
        out_ws.append(new_row + [classify(number)])
        exported += 1

wb.close()
out_wb.save(OUTPUT_FILE)

print("FINISHED")
print("Input rows:", processed)
print("Output rows:", exported)
print("Rows without detected numbers:", not_detected)
print("Output:", OUTPUT_FILE)
