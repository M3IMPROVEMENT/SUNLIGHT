from pyspark.sql import SparkSession
from pyspark.sql.functions import col, regexp_replace, trim, lit

# ============================================================
# START SPARK
# ============================================================

spark = (
    SparkSession.builder
    .master("local[*]")
    .appName("KBO_CONNECT_ALL")
    .getOrCreate()
)

spark.sparkContext.setLogLevel("WARN")


# ============================================================
# FOLDER
# ============================================================

DATA_DIR = r"C:\Users\Sunlight\Downloads\KBO_0485_WORK\data"


# ============================================================
# ALL KBO FILES
# ============================================================

files = [
    "enterprise.csv",
    "denomination.csv",
    "address.csv",
    "contact.csv",
    "activity.csv",
    "branch.csv",
    "establishment.csv",
    "code.csv",
    "meta.csv"
]


# ============================================================
# READ FILES
# ============================================================

all_tables = []

for filename in files:

    path = DATA_DIR + "\\" + filename

    print("Reading:", filename)

    df = (
        spark.read
        .option("header", True)
        .option("inferSchema", False)
        .option("encoding", "UTF-8")
        .csv(path)
    )

    print("Columns:", len(df.columns))

    # --------------------------------------------------------
    # Find EnterpriseNumber / EntityNumber
    # --------------------------------------------------------

    key_column = None

    if "EnterpriseNumber" in df.columns:
        key_column = "EnterpriseNumber"

    elif "EntityNumber" in df.columns:
        key_column = "EntityNumber"

    # --------------------------------------------------------
    # If there is an enterprise/entity number,
    # create common KBO_KEY
    # --------------------------------------------------------

    if key_column:

        df = df.withColumn(
            "KBO_KEY",
            regexp_replace(
                trim(col(key_column)),
                "[^0-9]",
                ""
            )
        )

        df = df.withColumn(
            "SOURCE",
            lit(filename)
        )

        all_tables.append(df)

        print("Key:", key_column)

    else:

        print("NO ENTERPRISE/ENTITY NUMBER -> skipped")

    print()


# ============================================================
# UNION ALL TABLES
# ============================================================

print("Connecting all tables...")

# Find every column appearing in any table
all_columns = set()

for df in all_tables:
    all_columns.update(df.columns)

all_columns = list(all_columns)


# Make every table have the same columns
prepared = []

for df in all_tables:

    for c in all_columns:

        if c not in df.columns:

            df = df.withColumn(
                c,
                lit(None).cast("string")
            )

    df = df.select(all_columns)

    prepared.append(df)


# ============================================================
# UNION
# ============================================================

result = prepared[0]

for df in prepared[1:]:

    result = result.unionByName(
        df,
        allowMissingColumns=True
    )


# ============================================================
# SAVE AS CSV
# ============================================================

OUTPUT = r"C:\Users\Sunlight\Desktop\17-09-26\KBO_CONNECTED"

print("Writing final CSV...")

result.write \
    .mode("overwrite") \
    .option("header", True) \
    .option("encoding", "UTF-8") \
    .csv(OUTPUT)

print()
print("======================================")
print("DONE")
print("======================================")
print("Output:", OUTPUT)

