print("FINISHED")
print("==============================================")
print(f"Original rows : {total_original_rows:,}")
print(f"Output rows   : {total_output_rows:,}")
print(f"Rows split    : {total_split_rows:,}")
print(f"Phones found  : {total_numbers_found:,}")
print()
print("Duplicates were NOT removed.")
print("Empty TELE cells were NOT removed.")
print()
print("Output:")
print(output_file)
print("==============================================")
