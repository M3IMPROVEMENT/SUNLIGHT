import openpyxl
import re

# ============================================================
# CHANGE ONLY THESE 2 PATHS
# ============================================================

INPUT_FILE = r"C:\Users\YourName\Desktop\input.xlsx"
OUTPUT_FILE = r"C:\Users\YourName\Desktop\TELE_CLEAN_SPLIT.xlsx"

TELE_COLUMN = "TELE"


# ============================================================
# GET DIGITS FROM A PHONE VALUE
# ============================================================

def digits_only(value):
    if value is None:
        return ""

    text = str(value).strip()

    # Excel number such as 010881429.0
    if text.endswith(".0"):
        text = text[:-2]

    return re.sub(r"\D", "", text)


# ============================================================
# CLEAN ONE PHONE NUMBER
# ============================================================

def clean_phone(value):

    d = digits_only(value)

    if not d:
        return ""

    # +32XXXXXXXXX
    if d.startswith("32") and len(d) == 11:
        d = d[2:]

    # 0032XXXXXXXXX
    elif d.startswith("0032") and len(d) == 13:
        d = d[4:]

    # Remove Belgian national 0
    if d.startswith("0") and len(d) in (9, 10):
        d = d[1:]

    return d


# ============================================================
# CHECK IF SOMETHING LOOKS LIKE A PHONE NUMBER
# ============================================================

def looks_like_phone(value):

    d = digits_only(value)

    if not d:
        return False

    # Belgian national numbers
    # 9 digits = landline
    # 10 digits = mobile / some Belgian formats
    if len(d) in (9, 10) and d.startswith("0"):
        return True

    # 32 + 9 digits
    if len(d) == 11 and d.startswith("32"):
        return True

    # 0032 + 9 digits
    if len(d) == 13 and d.startswith("0032"):
        return True

    return False


# ============================================================
# SPLIT TELE
# ============================================================

def split_tele(value):

    if value is None:
        return []

    text = str(value).strip()

    if not text:
        return []

    # --------------------------------------------------------
    # IMPORTANT:
    #
    # SPACE = possible separator between 2 phone numbers
    #
    # "/" is NOT used as separator.
    #
    # Example:
    # 0475/252328
    #
    # stays ONE number.
    # --------------------------------------------------------

    parts = re.split(r"\s+", text)

    phone_parts = []

    for part in parts:

        # Remove harmless punctuation around the value
        part = part.strip(";,|")

        if not part:
            continue

        if looks_like_phone(part):

            phone_parts.append(part)

        else:

            # Sometimes there can be punctuation between numbers.
            # Try extracting phone-looking sequences without
            # destroying a slash inside a number.

            possible = re.findall(
                r"(?:\+?32|0032)?0?\d[\d/.-]{7,}",
                part
            )

            if possible:

                for p in possible:

                    if looks_like_phone(p):
                        phone_parts.append(p)

            else:

                # Keep it for manual checking
                phone_parts.append(part)

    return phone_parts


# ============================================================
# MAIN
# ============================================================

print("=" * 70)
print("TELE CLEAN + SPLIT")
print("=" * 70)

print("INPUT :", INPUT_FILE)
print("OUTPUT:", OUTPUT_FILE)
print()

input_wb = openpyxl.load_workbook(
    INPUT_FILE,
    read_only=True,
    data_only=False
)

output_wb = openpyxl.Workbook(
    write_only=True
)

total_rows = 0
normal_rows = 0
split_rows = 0
manual_rows = 0
output_rows = 0


# ============================================================
# PROCESS EVERY SHEET
# ============================================================

for ws in input_wb.worksheets:

    print()
    print("SHEET:", ws.title)
    print("-" * 70)

    output_ws = output_wb.create_sheet(
        title=ws.title
    )

    rows = ws.iter_rows()

    try:
        header = next(rows)
    except StopIteration:
        continue

    header_values = [
        cell.value for cell in header
    ]

    # --------------------------------------------------------
    # FIND TELE COLUMN
    # --------------------------------------------------------

    tele_index = None

    for i, value in enumerate(header_values):

        if value is not None:

            if str(value).strip().upper() == TELE_COLUMN:

                tele_index = i
                break

    if tele_index is None:

        print("TELE column NOT FOUND.")

        output_ws.append(header_values)

        for row in rows:
            output_ws.append(
                [cell.value for cell in row]
            )

        continue

    print(
        "TELE column found:",
        tele_index + 1
    )

    # Write header
    output_ws.append(header_values)


    # ========================================================
    # PROCESS ROWS
    # ========================================================

    for excel_row, row in enumerate(
        rows,
        start=2
    ):

        total_rows += 1

        values = [
            cell.value for cell in row
        ]

        original = values[tele_index]

        # ----------------------------------------------------
        # SPLIT
        # ----------------------------------------------------

        phones = split_tele(original)

        if not phones:

            # Empty
            new_row = values.copy()
            new_row[tele_index] = ""

            output_ws.append(new_row)

            output_rows += 1

            continue


        # ----------------------------------------------------
        # MORE THAN ONE PHONE
        # ----------------------------------------------------

        if len(phones) >= 2:

            # Check that EVERY part really looks like a phone
            all_valid = all(
                looks_like_phone(p)
                for p in phones
            )

            if all_valid:

                split_rows += 1

                print()
                print(
                    f"[SPLIT] "
                    f"Sheet={ws.title} "
                    f"Row={excel_row}"
                )

                print(
                    "Original:",
                    original
                )

                print(
                    "Numbers:",
                    " | ".join(
                        digits_only(p)
                        for p in phones
                    )
                )

                # One output row for each number
                for phone in phones:

                    new_row = values.copy()

                    new_row[tele_index] = clean_phone(
                        phone
                    )

                    output_ws.append(new_row)

                    output_rows += 1

                continue


        # ----------------------------------------------------
        # ONE PHONE
        # ----------------------------------------------------

        if len(phones) == 1:

            phone = phones[0]

            if looks_like_phone(phone):

                new_row = values.copy()

                new_row[tele_index] = clean_phone(
                    phone
                )

                output_ws.append(new_row)

                output_rows += 1
                normal_rows += 1

                continue


        # ----------------------------------------------------
        # AMBIGUOUS
        # ----------------------------------------------------

        manual_rows += 1

        print()
        print(
            f"[MANUAL CHECK] "
            f"Sheet={ws.title} "
            f"Excel row={excel_row}"
        )

        print(
            "Original:",
            original
        )

        print(
            "Digits:",
            digits_only(original)
        )

        # Do NOT guess.
        # Keep the cleaned digits in the same row.
        new_row = values.copy()

        new_row[tele_index] = digits_only(
            original
        )

        output_ws.append(new_row)

        output_rows += 1


        # ----------------------------------------------------
        # PROGRESS
        # ----------------------------------------------------

        if total_rows % 10000 == 0:

            print()
            print(
                f"Progress: "
                f"{total_rows:,} rows | "
                f"Output: {output_rows:,} | "
                f"Split: {split_rows:,} | "
                f"Manual: {manual_rows:,}"
            )


# ============================================================
# SAVE
# ============================================================

print()
print("Saving...")

output_wb.save(
    OUTPUT_FILE
)

input_wb.close()


# ============================================================
# FINAL REPORT
# ============================================================

print()
print("=" * 70)
print("FINISHED")
print("=" * 70)

print(
    f"Original rows : {total_rows:,}"
)

print(
    f"Output rows   : {output_rows:,}"
)

print(
    f"Normal rows   : {normal_rows:,}"
)

print(
    f"Split rows    : {split_rows:,}"
)

print(
    f"Manual check  : {manual_rows:,}"
)

print()
print("Duplicates were NOT removed.")
print("Original file was NOT modified.")

print()
print("OUTPUT:")
print(OUTPUT_FILE)

print("=" * 70)
