from pyspark.sql import SparkSession
from pyspark.sql.functions import col, regexp_replace, trim, lit, monotonically_increasing_id
import os
from openpyxl import Workbook

# ============================================================
# SPARK
# ============================================================

spark = (
    SparkSession.builder
    .master("local[*]")
    .appName("KBO_CONNECT_ALL_TO_EXCEL")
    .getOrCreate()
)

spark.sparkContext.setLogLevel("WARN")

# ============================================================
# PATHS
# ============================================================

DATA_DIR = r"C:\Users\Sunlight\Downloads\KBO_0485_WORK\data"

OUTPUT_DIR = r"C:\Users\Sunlight\Desktop\17-09-26\KBO_CONNECTED_EXCEL"

os.makedirs(OUTPUT_DIR, exist_ok=True)

# ============================================================
# FILES
# ============================================================

files = [
    "enterprise.csv",
    "denomination.csv",
    "address.csv",
    "contact.csv",
    "activity.csv",
    "branch.csv",
    "establishment.csv",
    "code.csv",
    "meta.csv"
]

# Excel maximum is 1,048,576 rows.
# We use 500,000 DATA rows per Excel file.
ROWS_PER_EXCEL = 500_000

# ============================================================
# READ ALL FILES
# ============================================================

all_tables = []

for filename in files:

    path = os.path.join(DATA_DIR, filename)

    print("=" * 70)
    print("Reading:", filename)

    df = (
        spark.read
        .option("header", True)
        .option("inferSchema", False)
        .option("encoding", "UTF-8")
        .csv(path)
    )

    print("Columns:", len(df.columns))

    # --------------------------------------------------------
    # Find KBO key
    # --------------------------------------------------------

    key_column = None

    if "EnterpriseNumber" in df.columns:
        key_column = "EnterpriseNumber"

    elif "EntityNumber" in df.columns:
        key_column = "EntityNumber"

    # --------------------------------------------------------
    # Add KBO_KEY
    # --------------------------------------------------------

    if key_column:

        df = df.withColumn(
            "KBO_KEY",
            regexp_replace(
                trim(col(key_column)),
                "[^0-9]",
                ""
            )
        )

        print("Key:", key_column)

        df = df.withColumn(
            "SOURCE",
            lit(filename)
        )

        all_tables.append(df)

    else:

        print("NO ENTERPRISE/ENTITY NUMBER -> skipped")

    print()

# ============================================================
# CONNECT ALL TABLES
# ============================================================

print("=" * 70)
print("Connecting all tables...")
print("=" * 70)

# Get every column appearing in every table
all_columns = set()

for df in all_tables:
    all_columns.update(df.columns)

all_columns = list(all_columns)

print("Total columns in final table:", len(all_columns))

# ============================================================
# MAKE SAME STRUCTURE
# ============================================================

prepared = []

for df in all_tables:

    for c in all_columns:

        if c not in df.columns:

            df = df.withColumn(
                c,
                lit(None).cast("string")
            )

    df = df.select(all_columns)

    prepared.append(df)

# ============================================================
# UNION
# ============================================================

result = prepared[0]

for df in prepared[1:]:

    result = result.unionByName(
        df,
        allowMissingColumns=True
    )

print("All tables connected.")

# ============================================================
# COUNT
# ============================================================

print("=" * 70)
print("Counting final rows...")
print("=" * 70)

total_rows = result.count()

print("TOTAL ROWS:", total_rows)

# ============================================================
# ADD ROW ID
# ============================================================

result = result.withColumn(
    "_ROW_ID",
    monotonically_increasing_id()
)

# ============================================================
# NUMBER OF EXCEL FILES
# ============================================================

number_of_files = (
    total_rows + ROWS_PER_EXCEL - 1
) // ROWS_PER_EXCEL

print("Excel files required:", number_of_files)

# ============================================================
# IMPORTANT:
# Repartition into manageable partitions
# ============================================================

result = result.repartition(
    max(number_of_files, 1)
)

# ============================================================
# WRITE EXCEL
# ============================================================

columns = [
    c for c in result.columns
    if c != "_ROW_ID"
]

print("=" * 70)
print("Writing Excel files...")
print("=" * 70)

def write_partition(iterator):

    from openpyxl import Workbook

    rows = list(iterator)

    if not rows:
        return

    # Partition number is not directly available here,
    # so each Spark partition writes its own Excel file.

    import uuid

    filename = (
        "KBO_part_"
        + str(uuid.uuid4())
        + ".xlsx"
    )

    output_file = os.path.join(
        OUTPUT_DIR,
        filename
    )

    wb = Workbook(
        write_only=True
    )

    ws = wb.create_sheet("KBO")

    # Header
    ws.append(columns)

    # Data
    for row in rows:

        row_dict = row.asDict()

        ws.append([
            row_dict.get(c)
            for c in columns
        ])

    wb.save(output_file)

    print("Created:", output_file)


# ============================================================
# RUN
# ============================================================

result.rdd.mapPartitions(
    write_partition
).count()

print()
print("=" * 70)
print("DONE")
print("=" * 70)

print("Output folder:")
print(OUTPUT_DIR)
