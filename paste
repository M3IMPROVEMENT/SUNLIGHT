import pandas as pd

input_file = r"C:\Users\Sunlight\Desktop\your_file.xlsx"
output_file = r"C:\Users\Sunlight\Desktop\your_file_deduplicated.xlsx"

# Read Excel
df = pd.read_excel(input_file)

# Clean column names
df.columns = df.columns.astype(str).str.strip()

# Remove duplicates based on Numéro + Libellé
before = len(df)

df = df.drop_duplicates(
    subset=["Numéro", "Libellé"],
    keep="first"
)

# Find date columns and remove the time part
for col in df.columns:
    if pd.api.types.is_datetime64_any_dtype(df[col]):
        df[col] = df[col].dt.date

# Save
df.to_excel(output_file, index=False)

print("--------------------------------")
print("DONE")
print("--------------------------------")
print(f"Rows before       : {before:,}")
print(f"Rows after        : {len(df):,}")
print(f"Duplicates removed: {before - len(df):,}")
print(f"Output            : {output_file}")
