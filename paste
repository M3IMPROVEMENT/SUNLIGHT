        INSERT OR IGNORE INTO address
        (
            kbo,
            street,
            house_number,
            box,
            postal_code,
            municipality
        )
        VALUES (?, ?, ?, ?, ?, ?)
    """, (
        kbo,
        street,
        house_number,
        box,
        postal_code,
        municipality
    ))


