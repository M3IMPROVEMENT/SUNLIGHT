import pandas as pd
import re

# ==========================
# FILES
# ==========================
input_file = "master_final_table.xlsx"
output_file = "phone_classified.xlsx"

# ==========================
# READ FILE
# ==========================
df = pd.read_excel(input_file, dtype=str)

# ==========================
# CLEAN NUMBER
# ==========================
def clean_number(value):

    if pd.isna(value):
        return ""

    value = str(value).strip()

    if value == "":
        return ""

    # Keep digits only
    number = re.sub(r"\D", "", value)

    # Remove 0032 from beginning
    if number.startswith("0032"):
        number = number[4:]

    # Remove 32 from beginning
    elif number.startswith("32"):
        number = number[2:]

    # Remove 0 from beginning
    if number.startswith("0"):
        number = number[1:]

    return number


# ==========================
# CLASSIFY NUMBER
# ==========================
def classify_number(value):

    number = clean_number(value)

    if number == "":
        return "", ""

    length = len(number)

    if length == 9:
        return number, "GSM"

    elif length == 8:
        return number, "Fixe"

    else:
        return number, "CHECK"


# ==========================
# PROCESS GSM COLUMN
# ==========================
if "GSM" not in df.columns:
    raise ValueError("Column 'GSM' was not found.")

df[["GSM_CLEAN", "GSM_TYPE"]] = df["GSM"].apply(
    lambda x: pd.Series(classify_number(x))
)

# ==========================
# SEPARATE WRONG NUMBERS
# ==========================
df["GSM_WRONG"] = df.apply(
    lambda row: row["GSM_CLEAN"]
    if row["GSM_TYPE"] == "CHECK"
    else "",
    axis=1
)

# ==========================
# SAVE
# ==========================
df.to_excel(output_file, index=False)

print("DONE")
print(f"Output file: {output_file}")

print("\nClassification:")
print(df["GSM_TYPE"].value_counts())
