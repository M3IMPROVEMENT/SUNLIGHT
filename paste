import pandas as pd
from pathlib import Path
from datetime import datetime

# ============================================================
# STEP 1 — MERGE ALL EXCEL FILES INTO ONE MASTER CSV
# NOTHING IS DELETED OR CLEANED
# ============================================================

# 📁 Folder containing your Excel files
INPUT_FOLDER = Path(r"C:\YOUR_FOLDER_HERE")

# 📄 Output file
timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
OUTPUT_FILE = INPUT_FOLDER / f"MASTER_MERGED_{timestamp}.csv"

# Excel extensions to read
EXCEL_EXTENSIONS = {".xlsx", ".xls", ".xlsm"}

# Find all Excel files
files = [
    f for f in INPUT_FOLDER.rglob("*")
    if f.is_file()
    and f.suffix.lower() in EXCEL_EXTENSIONS
    and not f.name.startswith("~$")
]

print(f"Excel files found: {len(files)}")

if not files:
    raise FileNotFoundError("No Excel files were found in the selected folder.")

# ------------------------------------------------------------
# Read files one by one and write directly to CSV
# This avoids creating one enormous DataFrame in memory.
# ------------------------------------------------------------

first_file = True
total_rows = 0
successful_files = 0
failed_files = []

for i, file in enumerate(files, start=1):

    print(f"[{i}/{len(files)}] Reading: {file.name}")

    try:
        # Read the Excel file exactly as it is
        df = pd.read_excel(file, dtype=object)

        # Keep EVERYTHING from the file
        rows = len(df)
        total_rows += rows

        # Add source file information
        # This does NOT delete or modify your original columns.
        df["SOURCE_FILE"] = file.name

        # Write to CSV
        df.to_csv(
            OUTPUT_FILE,
            mode="w" if first_file else "a",
            header=first_file,
            index=False,
            encoding="utf-8-sig"
        )

        first_file = False
        successful_files += 1

        print(f"    ✓ {rows:,} rows")

    except Exception as e:
        failed_files.append((file.name, str(e)))
        print(f"    ❌ ERROR: {e}")

# ============================================================
# FINAL REPORT
# ============================================================

print("\n" + "=" * 60)
print("MERGE FINISHED")
print("=" * 60)

print(f"Files found       : {len(files):,}")
print(f"Files processed   : {successful_files:,}")
print(f"Files with errors : {len(failed_files):,}")
print(f"Total rows        : {total_rows:,}")
print(f"\nMaster file       : {OUTPUT_FILE}")

if failed_files:
    print("\nFILES WITH ERRORS:")
    for filename, error in failed_files:
        print(f" - {filename}: {error}")
else:
    print("\n✓ All Excel files were successfully merged.")
