import pandas as pd
from pathlib import Path

# ============================================================
# SETTINGS
# ============================================================

INPUT_FOLDER = Path(r"C:\Users\YourName\Desktop\excel_files")
OUTPUT_FOLDER = Path(r"C:\Users\YourName\Desktop\merged_output")

# Maximum DATA rows per Excel file
MAX_ROWS = 1_000_000

OUTPUT_FOLDER.mkdir(parents=True, exist_ok=True)

# ============================================================
# FIND FILES
# ============================================================

files = sorted([
    f for f in INPUT_FOLDER.glob("*.xlsx")
    if not f.name.startswith("~$")
])

print(f"Found {len(files)} Excel files.")

if not files:
    raise SystemExit("❌ No Excel files found.")


# ============================================================
# CREATE EXCEL WRITER
# ============================================================

def create_writer(number):

    output_path = OUTPUT_FOLDER / f"merged_{number:03d}.xlsx"

    writer = pd.ExcelWriter(
        output_path,
        engine="xlsxwriter",
        engine_kwargs={
            "options": {
                # IMPORTANT:
                # Keep URLs as normal text.
                # Do NOT convert them to hyperlinks.
                "strings_to_urls": False
            }
        }
    )

    print(f"\n📁 Creating: {output_path.name}")

    return writer, output_path


# ============================================================
# VARIABLES
# ============================================================

output_number = 1
current_rows = 0
total_rows = 0

writer, output_path = create_writer(output_number)


# ============================================================
# MERGE
# ============================================================

for i, file in enumerate(files, start=1):

    try:

        print(f"[{i}/{len(files)}] Reading: {file.name}")

        df = pd.read_excel(file)

        rows = len(df)

        print(f"    → {rows:,} rows")

        if rows == 0:
            continue


        # ====================================================
        # IF FILE WOULD EXCEED 1 MILLION ROWS
        # ====================================================

        if current_rows + rows > MAX_ROWS:

            writer.close()

            print(
                f"✅ Finished {output_path.name} "
                f"({current_rows:,} rows)"
            )

            output_number += 1
            current_rows = 0

            writer, output_path = create_writer(output_number)


        # ====================================================
        # WRITE DATA
        # ====================================================

        df.to_excel(
            writer,
            sheet_name="Sheet1",
            startrow=current_rows + 1,
            index=False,
            header=(current_rows == 0)
        )

        current_rows += rows
        total_rows += rows


    except Exception as e:

        print(f"❌ ERROR: {file.name}")
        print(f"   {e}")


# ============================================================
# CLOSE LAST FILE
# ============================================================

writer.close()

print(
    f"\n✅ Finished {output_path.name} "
    f"({current_rows:,} rows)"
)


# ============================================================
# FINAL SUMMARY
# ============================================================

print("\n" + "=" * 60)
print("MERGE FINISHED")
print("=" * 60)

print(f"Input files     : {len(files):,}")
print(f"Output files    : {output_number:,}")
print(f"Total data rows : {total_rows:,}")
print(f"Output folder   : {OUTPUT_FOLDER}")

print("=" * 60)
