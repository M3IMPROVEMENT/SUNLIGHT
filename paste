"""
Kompass Belgique scraper : nom, TVA, téléphone, code postal, adresse.

Installation :
    pip install playwright
    playwright install chromium

Utilisation :
    1) Mets une ou plusieurs URLs de listing Kompass dans LISTING_URLS
       (page de résultats / catégorie), OU mets des URLs de fiches
       (une par ligne) dans le fichier urls.txt.
    2) python kompass_scraper.py
    Résultat : kompass_be.csv (reprise automatique si tu relances).
"""
import csv
import json
import os
import random
import re
import time

from playwright.sync_api import sync_playwright, TimeoutError as PWTimeout

# ----------------------------- CONFIG ---------------------------------
LISTING_URLS = [
    # "https://be.kompass.com/....",   # <- colle ici tes URLs de listing
]
URLS_FILE = "urls.txt"          # optionnel : une URL de fiche par ligne
OUTPUT_CSV = "kompass_be.csv"
MAX_PAGES_PER_LISTING = 50
HEADLESS = False                # False = moins de blocages anti-bot
DELAY = (1.5, 3.5)              # pause aléatoire entre deux fiches (s)
RETRIES = 3
# -----------------------------------------------------------------------

COMPANY_LINK_RE = re.compile(r"^https?://be\.kompass\.com/c/[^/]+/[a-z]{2}\d+/?$", re.I)
VAT_RE = re.compile(r"\bBE[\s.]?(0?\d{3})[\s.]?(\d{3})[\s.]?(\d{3})\b", re.I)
PHONE_RE = re.compile(r"(?:\+32|0032|0)[\s./-]?\d(?:[\s./-]?\d){7,8}")
ADDR_RE = re.compile(r"([^\n,]*\d+[^\n,]*)[,\n\s]+(\d{4})\s+([A-Za-zÀ-ÿ'’\- ]+)")
FIELDS = ["name", "tva", "phone", "postal", "address", "city", "url"]


# ------------------------------ UTILS ----------------------------------
def pause():
    time.sleep(random.uniform(*DELAY))


def valid_be_vat(d: str) -> bool:
    return len(d) == 10 and d.isdigit() and 97 - int(d[:8]) % 97 == int(d[8:])


def safe_goto(page, url: str) -> bool:
    for attempt in range(1, RETRIES + 1):
        try:
            page.goto(url, wait_until="domcontentloaded", timeout=45000)
            page.wait_for_load_state("networkidle", timeout=15000)
            return True
        except PWTimeout:
            return True  # la page est là, networkidle n'a juste pas abouti
        except Exception as e:
            print(f"   goto retry {attempt}/{RETRIES}: {str(e)[:80]}")
            time.sleep(2 * attempt)
    return False


def accept_cookies(page):
    for sel in ["#onetrust-accept-btn-handler", "button:has-text('Accepter')",
                "button:has-text('Tout accepter')", "button:has-text('Accept')"]:
        try:
            page.click(sel, timeout=1500)
            return
        except Exception:
            pass


def load_done(path: str) -> set:
    if not os.path.exists(path):
        return set()
    with open(path, newline="", encoding="utf-8-sig") as f:
        return {row["url"] for row in csv.DictReader(f)}


# --------------------------- COLLECT LINKS -----------------------------
def collect_company_links(page, listing_url: str) -> list:
    links, seen = [], set()
    if not safe_goto(page, listing_url):
        return links
    accept_cookies(page)

    for n in range(1, MAX_PAGES_PER_LISTING + 1):
        hrefs = page.eval_on_selector_all("a[href]", "els => els.map(e => e.href)")
        new = 0
        for h in hrefs:
            h = h.split("?")[0].split("#")[0]
            if COMPANY_LINK_RE.match(h) and h not in seen:
                seen.add(h)
                links.append(h)
                new += 1
        print(f"  listing page {n}: +{new} fiches (total {len(links)})")

        nxt = None
        for sel in ["a[rel='next']", "a.next", "li.next a",
                    "a:has-text('Suivant')", "a:has-text('Next')", "a[aria-label='Next']"]:
            loc = page.query_selector(sel)
            if loc and loc.is_visible():
                nxt = loc
                break
        if not nxt:
            break
        try:
            nxt.click()
            page.wait_for_load_state("domcontentloaded")
            time.sleep(random.uniform(*DELAY))
        except Exception:
            break
    return links


# ----------------------------- EXTRACTION ------------------------------
def extract_info(page) -> dict:
    info = {"name": "-", "tva": "-", "phone": "-", "postal": "-",
            "address": "-", "city": "-"}

    # Nom
    try:
        h1 = page.query_selector("h1")
        if h1:
            info["name"] = h1.inner_text().strip()
    except Exception:
        pass

    # 1) JSON-LD
    for s in page.query_selector_all('script[type="application/ld+json"]'):
        try:
            data = json.loads(s.inner_text())
        except Exception:
            continue
        for item in (data if isinstance(data, list) else [data]):
            if not isinstance(item, dict):
                continue
            a = item.get("address")
            if isinstance(a, dict):
                info["address"] = a.get("streetAddress") or info["address"]
                info["postal"] = a.get("postalCode") or info["postal"]
                info["city"] = a.get("addressLocality") or info["city"]
            if item.get("telephone"):
                info["phone"] = item["telephone"]
            if item.get("vatID"):
                info["tva"] = item["vatID"]

    # 2) Fallback texte
    text = page.inner_text("body")

    if info["tva"] == "-":
        for m in VAT_RE.finditer(text):
            d = "".join(m.groups()).rjust(10, "0")
            if valid_be_vat(d):
                info["tva"] = f"BE{d}"
                break

    if info["phone"] == "-":
        # lien tel: en priorité
        tel = page.query_selector("a[href^='tel:']")
        if tel:
            info["phone"] = tel.get_attribute("href").replace("tel:", "").strip()
        else:
            m = PHONE_RE.search(text)
            if m:
                info["phone"] = m.group().strip()
    info["phone"] = re.sub(r"[^\d+]", "", info["phone"]) or "-"

    if info["postal"] == "-" or info["address"] == "-":
        m = ADDR_RE.search(text)
        if m:
            if info["address"] == "-":
                info["address"] = m.group(1).strip()
            if info["postal"] == "-":
                info["postal"] = m.group(2)
            if info["city"] == "-":
                info["city"] = m.group(3).strip()

    return info


def scrape_company(page, url: str):
    if not safe_goto(page, url):
        return None
    for attempt in range(1, RETRIES + 1):
        try:
            # Bouton "Afficher le numéro" éventuel
            for sel in ["text=Afficher le numéro", "text=Afficher", "text=Show"]:
                try:
                    page.click(sel, timeout=800)
                    break
                except Exception:
                    pass
            info = extract_info(page)
            info["url"] = url
            return info
        except Exception as e:
            # typique : "Execution context was destroyed" (redirection)
            print(f"   extract retry {attempt}/{RETRIES}: {str(e)[:80]}")
            time.sleep(2 * attempt)
            try:
                page.wait_for_load_state("domcontentloaded")
            except Exception:
                pass
    return None


# ------------------------------- MAIN ----------------------------------
def main():
    done = load_done(OUTPUT_CSV)
    new_file = not os.path.exists(OUTPUT_CSV)

    with sync_playwright() as p:
        browser = p.chromium.launch(headless=HEADLESS)
        ctx = browser.new_context(locale="fr-BE", viewport={"width": 1366, "height": 850})
        page = ctx.new_page()

        # 1) Liste des fiches à traiter
        urls = []
        if os.path.exists(URLS_FILE):
            with open(URLS_FILE, encoding="utf-8") as f:
                urls += [l.strip() for l in f if l.strip()]
        for lu in LISTING_URLS:
            print(f"Listing : {lu}")
            urls += collect_company_links(page, lu)

        urls = [u for u in dict.fromkeys(urls) if u not in done]
        total = len(urls)
        print(f"{total} fiches à scraper ({len(done)} déjà faites)")

        # 2) Scraping
        with open(OUTPUT_CSV, "a", newline="", encoding="utf-8-sig") as f:
            writer = csv.DictWriter(f, fieldnames=FIELDS, delimiter=";")
            if new_file:
                writer.writeheader()

            for i, url in enumerate(urls, 1):
                info = scrape_company(page, url)
                if not info:
                    print(f"[{i}/{total}] ECHEC {url}")
                    continue
                writer.writerow({k: info.get(k, "-") for k in FIELDS})
                f.flush()
                print(f"[{i}/{total}] {info['name']} | {info['tva']} | "
                      f"{info['phone']} | {info['postal']} | {info['address']}")
                pause()

        browser.close()
    print(f"Terminé -> {OUTPUT_CSV}")


if __name__ == "__main__":
    main()
