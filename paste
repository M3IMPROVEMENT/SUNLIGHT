import pandas as pd
import re
from pathlib import Path


# ============================================================
# CONFIGURATION
# ============================================================

INPUT_FILE = Path(r"C:\YOUR_FOLDER\your_file.xlsx")

OUTPUT_FILE = Path(r"C:\YOUR_FOLDER\your_file_cleaned.xlsx")


# ============================================================
# CLEAN TELEPHONE
# ============================================================

def clean_tele(value):

    if pd.isna(value):
        return ""

    value = str(value).strip()

    # Remove Excel .0
    if value.endswith(".0"):
        value = value[:-2]

    # Keep digits only
    digits = re.sub(r"\D", "", value)

    if not digits:
        return ""

    # --------------------------------------------------------
    # 0032
    # --------------------------------------------------------

    if digits.startswith("0032"):

        digits = digits[4:]

        # 0032 0 4...
        if digits.startswith("0"):
            digits = digits[1:]

        # Add Belgian local 0
        digits = "0" + digits

    # --------------------------------------------------------
    # 32
    # --------------------------------------------------------

    elif digits.startswith("32"):

        digits = digits[2:]

        # 32 0 4...
        if digits.startswith("0"):
            digits = digits[1:]

        # Add Belgian local 0
        digits = "0" + digits

    # --------------------------------------------------------
    # Already Belgian local format
    # --------------------------------------------------------

    elif digits.startswith("0"):

        pass

    return digits


# ============================================================
# READ FILE
# ============================================================

print("=" * 60)
print("TELE CLEANING + DEDUPLICATION")
print("=" * 60)

print(f"Reading: {INPUT_FILE}")

df = pd.read_excel(
    INPUT_FILE,
    dtype=str
)

print(f"Rows before: {len(df):,}")


# ============================================================
# FIND TELE COLUMN
# ============================================================

tele_column = None

for col in df.columns:

    if str(col).strip().upper() == "TELE":

        tele_column = col
        break


if tele_column is None:

    raise Exception(
        "Column 'TELE' was not found in the Excel file."
    )


print(f"TELE column: {tele_column}")


# ============================================================
# CLEAN TELE
# ============================================================

df[tele_column] = df[tele_column].apply(
    clean_tele
)


# ============================================================
# COUNT BLANK TELE
# ============================================================

blank_tele = (
    df[tele_column]
    .eq("")
    .sum()
)


# ============================================================
# DEDUPLICATION
# ============================================================

before_dedup = len(df)

# Separate rows with TELE
with_tele = df[
    df[tele_column] != ""
].copy()

# Rows without TELE
without_tele = df[
    df[tele_column] == ""
].copy()

# Deduplicate only rows that have TELE
with_tele = with_tele.drop_duplicates(
    subset=[tele_column],
    keep="first"
)

# Put blank TELE rows back
df = pd.concat(
    [
        with_tele,
        without_tele
    ],
    ignore_index=True
)

after_dedup = len(df)

duplicates_removed = (
    before_dedup - after_dedup
)


# ============================================================
# SAVE
# ============================================================

df.to_excel(
    OUTPUT_FILE,
    index=False
)


# ============================================================
# SUMMARY
# ============================================================

print()
print("=" * 60)
print("DONE")
print("=" * 60)

print(
    f"Rows before:       {before_dedup:,}"
)

print(
    f"Duplicates removed:{duplicates_removed:,}"
)

print(
    f"Rows after:        {after_dedup:,}"
)

print(
    f"Blank TELE rows:   {blank_tele:,}"
)

print()
print(
    f"Saved to:\n{OUTPUT_FILE}"
)

print("=" * 60)
