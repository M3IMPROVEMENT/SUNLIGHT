
from pathlib import Path
import pandas as pd

# ================= CONFIGURATION =================

FILE_1 = Path(r"C:\Users\Sunlight\Desktop\NET\B2B\file1.xlsx")
FILE_2 = Path(r"C:\Users\Sunlight\Desktop\NET\B2B\file2.xlsx")

OUTPUT_FILE = Path(
    r"C:\Users\Sunlight\Desktop\NET\B2B\merged.xlsx"
)

# ================= MERGING =================

df1 = pd.read_excel(FILE_1, dtype=str)
df2 = pd.read_excel(FILE_2, dtype=str)

# Add the original filename
df1["source"] = FILE_1.name
df2["source"] = FILE_2.name

# Combine all rows; align columns by header name
merged = pd.concat(
    [df1, df2],
    ignore_index=True,
    sort=False
)

# Save without removing duplicates
merged.to_excel(OUTPUT_FILE, index=False, engine="openpyxl")

print(f"File 1 rows: {len(df1):,}")
print(f"File 2 rows: {len(df2):,}")
print(f"Total merged rows: {len(merged):,}")
print(f"Output: {OUTPUT_FILE}")
