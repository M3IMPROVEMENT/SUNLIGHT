import openpyxl
import re

# ============================================================
# CONFIGURATION
# ============================================================

INPUT_FILE = r"C:\Users\YourName\Desktop\input.xlsx"
OUTPUT_FILE = r"C:\Users\YourName\Desktop\TELE_CLEAN_SPLIT.xlsx"

TELE_COLUMN = "TELE"


# ============================================================
# GET DIGITS ONLY
# ============================================================

def get_digits(value):
    """
    Converts a TELE value to digits only for analysis.

    Examples:
        +32 471 12 34 56 -> 32471123456
        0471/12/34/56    -> 0471123456
        0032471123456    -> 0032471123456
    """

    if value is None:
        return ""

    text = str(value).strip()

    # Remove Excel .0
    if text.endswith(".0"):
        text = text[:-2]

    return re.sub(r"\D", "", text)


# ============================================================
# CHECK ONE BELGIAN PHONE NUMBER
# ============================================================

def is_belgian_number(digits):

    if not digits:
        return False

    # 0032 + 9 digits
    if len(digits) == 13 and digits.startswith("0032"):
        return True

    # 32 + 9 digits
    if len(digits) == 11 and digits.startswith("32"):
        return True

    # Belgian national format
    if len(digits) == 9 and digits.startswith("0"):
        return True

    if len(digits) == 10 and digits.startswith("0"):
        return True

    return False


# ============================================================
# CLEAN ONE NUMBER
# ============================================================

def clean_number(digits):

    if not digits:
        return ""

    # +32 / 0032
    if digits.startswith("0032"):
        digits = digits[4:]

    elif digits.startswith("32"):
        digits = digits[2:]

    # Belgian national 0
    if digits.startswith("0"):
        digits = digits[1:]

    return digits


# ============================================================
# FIND ALL POSSIBLE SPLITS
# ============================================================

def find_partitions(digits):

    solutions = []

    def search(position, current):

        # Stop excessive combinations
        if len(solutions) > 20:
            return

        # Finished
        if position == len(digits):

            solutions.append(current.copy())
            return

        # Possible Belgian number lengths
        for length in (9, 10, 11, 13):

            end = position + length

            if end > len(digits):
                continue

            part = digits[position:end]

            if is_belgian_number(part):

                current.append(part)

                search(end, current)

                current.pop()

    search(0, [])

    return solutions


# ============================================================
# CHECK EXPLICIT SEPARATORS
# ============================================================

def try_separator_split(text):

    # --------------------------------------------------------
    # SEMICOLON / PIPE
    # --------------------------------------------------------

    parts = re.split(r"[;|]", text)

    if len(parts) > 1:

        numbers = []
        valid = True

        for part in parts:

            d = get_digits(part)

            if not d:
                continue

            if not is_belgian_number(d):
                valid = False
                break

            numbers.append(d)

        if valid and len(numbers) >= 2:
            return numbers

    # --------------------------------------------------------
    # SLASH
    #
    # 0475/252328
    # is ONE number -> don't split
    #
    # 043822774/0478719289
    # is TWO numbers -> split
    # --------------------------------------------------------

    parts = re.split(r"\s*/\s*", text)

    if len(parts) > 1:

        numbers = []
        valid = True

        for part in parts:

            d = get_digits(part)

            if not d or not is_belgian_number(d):

                valid = False
                break

            numbers.append(d)

        if valid and len(numbers) >= 2:
            return numbers

    # --------------------------------------------------------
    # COMMA
    # --------------------------------------------------------

    parts = re.split(r"\s*,\s*", text)

    if len(parts) > 1:

        numbers = []
        valid = True

        for part in parts:

            d = get_digits(part)

            if not d or not is_belgian_number(d):

                valid = False
                break

            numbers.append(d)

        if valid and len(numbers) >= 2:
            return numbers

    return None


# ============================================================
# ANALYZE TELE
# ============================================================

def analyze_tele(value):

    if value is None:

        return {
            "status": "EMPTY",
            "numbers": [],
            "reason": ""
        }

    text = str(value).strip()

    if not text:

        return {
            "status": "EMPTY",
            "numbers": [],
            "reason": ""
        }

    digits = get_digits(text)

    if not digits:

        return {
            "status": "AMBIGUOUS",
            "numbers": [],
            "reason": "No digits found"
        }

    # --------------------------------------------------------
    # FIRST: explicit separators
    # --------------------------------------------------------

    separated = try_separator_split(text)

    if separated is not None:

        return {
            "status": "SPLIT",
            "numbers": separated,
            "reason": "Clear separator"
        }

    # --------------------------------------------------------
    # SECOND: check if the whole value is ONE number
    # --------------------------------------------------------

    if is_belgian_number(digits):

        return {
            "status": "ONE",
            "numbers": [digits],
            "reason": ""
        }

    # --------------------------------------------------------
    # THIRD: try concatenated numbers
    # --------------------------------------------------------

    partitions = find_partitions(digits)

    # Remove duplicates
    unique = []
    seen = set()

    for partition in partitions:

        key = tuple(partition)

        if key not in seen:

            seen.add(key)
            unique.append(partition)

    # --------------------------------------------------------
    # EXACTLY ONE POSSIBLE SPLIT
    # --------------------------------------------------------

    if len(unique) == 1:

        solution = unique[0]

        if len(solution) >= 2:

            return {
                "status": "SPLIT",
                "numbers": solution,
                "reason": "Unique valid split"
            }

    # --------------------------------------------------------
    # MORE THAN ONE POSSIBLE SPLIT
    # --------------------------------------------------------

    if len(unique) > 1:

        examples = []

        for partition in unique[:5]:

            examples.append(
                " + ".join(partition)
            )

        return {
            "status": "AMBIGUOUS",
            "numbers": [],
            "reason":
                "Several possible splits: "
                + " || ".join(examples)
        }

    # --------------------------------------------------------
    # NOTHING RELIABLE
    # --------------------------------------------------------

    return {
        "status": "AMBIGUOUS",
        "numbers": [],
        "reason":
            f"Could not safely identify number(s). "
            f"Digits found: {len(digits)}"
    }


# ============================================================
# MAIN
# ============================================================

print()
print("=" * 60)
print("TELE CLEAN + SPLIT")
print("=" * 60)
print()

print("Input :", INPUT_FILE)
print("Output:", OUTPUT_FILE)
print()

input_wb = openpyxl.load_workbook(
    INPUT_FILE,
    read_only=True,
    data_only=False
)

output_wb = openpyxl.Workbook(
    write_only=True
)

total_rows = 0
output_rows = 0
one_number = 0
split_rows = 0
ambiguous_rows = 0
empty_rows = 0


# ============================================================
# PROCESS EACH SHEET
# ============================================================

for ws in input_wb.worksheets:

    print()
    print("-" * 60)
    print("SHEET:", ws.title)
    print("-" * 60)

    output_ws = output_wb.create_sheet(
        title=ws.title
    )

    rows = ws.iter_rows()

    try:
        header = next(rows)
    except StopIteration:
        continue

    header_values = [
        cell.value for cell in header
    ]

    # --------------------------------------------------------
    # FIND TELE COLUMN
    # --------------------------------------------------------

    tele_index = None

    for i, value in enumerate(header_values):

        if value is not None:

            if str(value).strip().upper() == TELE_COLUMN:

                tele_index = i
                break

    if tele_index is None:

        print("WARNING: TELE column not found.")

        output_ws.append(header_values)

        for row in rows:

            output_ws.append([
                cell.value for cell in row
            ])

        continue

    print(
        "TELE column:",
        tele_index + 1
    )

    # Write header
    output_ws.append(header_values)

    # ========================================================
    # PROCESS ROWS
    # ========================================================

    for excel_row, row in enumerate(
        rows,
        start=2
    ):

        total_rows += 1

        values = [
            cell.value for cell in row
        ]

        original_tele = values[tele_index]

        result = analyze_tele(
            original_tele
        )

        status = result["status"]

        # ----------------------------------------------------
        # EMPTY
        # ----------------------------------------------------

        if status == "EMPTY":

            new_row = values.copy()

            new_row[tele_index] = ""

            output_ws.append(new_row)

            output_rows += 1
            empty_rows += 1

        # ----------------------------------------------------
        # ONE NUMBER
        # ----------------------------------------------------

        elif status == "ONE":

            new_row = values.copy()

            new_row[tele_index] = clean_number(
                result["numbers"][0]
            )

            output_ws.append(new_row)

            output_rows += 1
            one_number += 1

        # ----------------------------------------------------
        # SPLIT
        # ----------------------------------------------------

        elif status == "SPLIT":

            split_rows += 1

            cleaned_numbers = []

            for number in result["numbers"]:

                cleaned_numbers.append(
                    clean_number(number)
                )

            # PRINT EXACT ROW + NUMBERS
            print()
            print(
                f"[SPLIT] Sheet={ws.title} | "
                f"Excel row={excel_row}"
            )

            print(
                f"Original TELE: {original_tele}"
            )

            print(
                "Numbers found:",
                " + ".join(cleaned_numbers)
            )

            # Create one row for each number
            for number in cleaned_numbers:

                new_row = values.copy()

                new_row[tele_index] = number

                output_ws.append(new_row)

                output_rows += 1

        # ----------------------------------------------------
        # AMBIGUOUS
        # ----------------------------------------------------

        elif status == "AMBIGUOUS":

            ambiguous_rows += 1

            # Keep the row.
            # Clean digits only, but DO NOT GUESS A SPLIT.
            cleaned = clean_number(
                get_digits(original_tele)
            )

            new_row = values.copy()

            new_row[tele_index] = cleaned

            output_ws.append(new_row)

            output_rows += 1

            # PRINT MANUAL CHECK
            print()
            print(
                f"[MANUAL CHECK] Sheet={ws.title} | "
                f"Excel row={excel_row}"
            )

            print(
                f"Original TELE: {original_tele}"
            )

            print(
                f"Reason: {result['reason']}"
            )

        # ----------------------------------------------------
        # PROGRESS
        # ----------------------------------------------------

        if total_rows % 10000 == 0:

            print()
            print(
                f"Progress: "
                f"{total_rows:,} rows | "
                f"Output {output_rows:,} | "
                f"Split {split_rows:,} | "
                f"Manual {ambiguous_rows:,}"
            )


# ============================================================
# SAVE
# ============================================================

print()
print("Saving...")

output_wb.save(
    OUTPUT_FILE
)

input_wb.close()


# ============================================================
# FINAL REPORT
# ============================================================

print()
print("=" * 60)
print("FINISHED")
print("=" * 60)
print()

print(f"Original rows : {total_rows:,}")
print(f"Output rows   : {output_rows:,}")
print(f"One number    : {one_number:,}")
print(f"Split rows    : {split_rows:,}")
print(f"Manual check  : {ambiguous_rows:,}")
print(f"Empty TELE    : {empty_rows:,}")

print()
print("Duplicates: NOT removed")
print("Original file: NOT modified")
print()
print("Output file:")
print(OUTPUT_FILE)
print()
print("=" * 60)
