import pandas as pd
from pathlib import Path

# Folder containing your Excel files
folder = Path(r"C:\Users\YOUR_NAME\Desktop\FILES")

COLUMN = "VILLE"

files_with_ville = []

for file in folder.glob("*.xlsx"):

    try:
        df = pd.read_excel(file, dtype=str)

        # Check if column exists
        if COLUMN not in df.columns:
            print(f"⚠️ {file.name} → VILLE column not found")
            continue

        # Find non-empty VILLE
        ville = df[COLUMN].fillna("").astype(str).str.strip()

        non_empty = ville != ""
        count = non_empty.sum()

        if count > 0:
            files_with_ville.append({
                "Fichier": file.name,
                "Chemin": str(file),
                "VILLE non vide": count
            })

            print(f"❌ {file.name} → {count} non-empty VILLE")

        else:
            print(f"✅ {file.name} → VILLE empty")

    except Exception as e:
        print(f"⚠️ Error with {file.name}: {e}")


# Save results
if files_with_ville:

    result = pd.DataFrame(files_with_ville)

    output = folder / "files_with_non_empty_VILLE.xlsx"
    result.to_excel(output, index=False)

    print("\n================================")
    print("FILES WITH NON-EMPTY VILLE")
    print("================================")
    print(result.to_string(index=False))

    print(f"\n📁 Saved to: {output}")

else:
    print("\n✅ All files have an empty VILLE column.")
