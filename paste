import pandas as pd
import re

# ============================================================
# INPUT / OUTPUT
# ============================================================
input_file = "master_final_table.xlsx"

clean_file = "phones_clean.xlsx"
check_file = "GSM_CHECK.xlsx"
no_gsm_file = "GSM_NO_VALUE.xlsx"


# ============================================================
# READ FILE
# ============================================================
df = pd.read_excel(input_file, dtype=str)

if "GSM" not in df.columns:
    raise ValueError("Column 'GSM' was not found.")


# ============================================================
# KEEP ORIGINAL EXCEL ROW NUMBER
# +2 because Excel row 1 = header
# ============================================================
df["EXCEL_ROW"] = df.index + 2


# ============================================================
# CLEAN NUMBER
# ============================================================
def clean_number(value):

    if pd.isna(value):
        return ""

    value = str(value).strip()

    if value == "":
        return ""

    # Keep digits only
    number = re.sub(r"\D", "", value)

    # Remove 0032 from beginning
    if number.startswith("0032"):
        number = number[4:]

    # Remove 32 from beginning
    elif number.startswith("32"):
        number = number[2:]

    # Remove 0 from beginning
    if number.startswith("0"):
        number = number[1:]

    return number


# ============================================================
# CLASSIFY
# ============================================================
def classify_number(value):

    number = clean_number(value)

    if number == "":
        return "", "NO_GSM"

    if len(number) == 9:
        return number, "GSM"

    elif len(number) == 8:
        return number, "FIXE"

    else:
        return number, "CHECK"


# ============================================================
# APPLY
# ============================================================
df[["PHONE_CLEAN", "TYPE"]] = df["GSM"].apply(
    lambda x: pd.Series(classify_number(x))
)


# ============================================================
# GSM + FIXE
# ============================================================
clean_df = df[df["TYPE"].isin(["GSM", "FIXE"])].copy()

clean_df["GSM"] = clean_df["PHONE_CLEAN"]

clean_df.drop(
    columns=["PHONE_CLEAN"],
    inplace=True
)

clean_df.to_excel(clean_file, index=False)


# ============================================================
# CHECK
# ============================================================
check_df = df[df["TYPE"] == "CHECK"].copy()

check_df.rename(
    columns={
        "GSM": "GSM_ORIGINAL",
        "PHONE_CLEAN": "GSM_CLEAN"
    },
    inplace=True
)

check_df.to_excel(check_file, index=False)


# ============================================================
# NO GSM / EMPTY GSM
# ============================================================
no_gsm_df = df[df["TYPE"] == "NO_GSM"].copy()

# Remove helper columns except EXCEL_ROW
no_gsm_df.drop(
    columns=["PHONE_CLEAN", "TYPE"],
    inplace=True
)

no_gsm_df.to_excel(no_gsm_file, index=False)


# ============================================================
# SUMMARY
# ============================================================
gsm_count = len(df[df["TYPE"] == "GSM"])
fixe_count = len(df[df["TYPE"] == "FIXE"])
check_count = len(df[df["TYPE"] == "CHECK"])
no_gsm_count = len(df[df["TYPE"] == "NO_GSM"])

total = len(df)

print("========================================")
print("DONE")
print("========================================")

print(f"Total rows       : {total}")
print(f"GSM              : {gsm_count}")
print(f"FIXE             : {fixe_count}")
print(f"CHECK            : {check_count}")
print(f"NO GSM           : {no_gsm_count}")

print("----------------------------------------")

print(f"GSM + FIXE + CHECK + NO GSM = "
      f"{gsm_count + fixe_count + check_count + no_gsm_count}")

print("----------------------------------------")

print(f"Clean file       : {clean_file}")
print(f"Check file       : {check_file}")
print(f"No GSM file      : {no_gsm_file}")

print("========================================")

# ============================================================
# SHOW EXCEL ROWS WITH NO GSM
# ============================================================
if no_gsm_count > 0:

    print("\nRows with NO GSM:")

    print(
        no_gsm_df["EXCEL_ROW"].tolist()
    )

else:

    print("\nThere are no rows without GSM.")
