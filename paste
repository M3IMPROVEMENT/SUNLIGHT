import pandas as pd
import re
from pathlib import Path

# ============================================================
# CONFIG
# ============================================================

input_file = Path(r"C:\Users\Sunlight\Desktop\input.xlsx")
output_file = Path(r"C:\Users\Sunlight\Desktop\telephone_checked.xlsx")

# ============================================================
# BELGIAN PHONE CLASSIFICATION
# ============================================================

def classify_belgian_number(phone):

    if pd.isna(phone):
        return "UNKNOWN"

    phone = str(phone).strip()

    if not phone:
        return "UNKNOWN"

    # Remove Excel decimal artifact
    if phone.endswith(".0"):
        phone = phone[:-2]

    # Keep only digits and +
    phone = re.sub(r"[^\d+]", "", phone)

    # Convert Belgian international formats to national format
    if phone.startswith("+32"):
        phone = "0" + phone[3:]

    elif phone.startswith("0032"):
        phone = "0" + phone[4:]

    elif phone.startswith("32") and not phone.startswith("320"):
        phone = "0" + phone[2:]

    # --------------------------------------------------------
    # Belgian GSM
    # Normally starts with 04
    # --------------------------------------------------------

    if re.fullmatch(r"04\d{8}", phone):
        return "GSM"

    # --------------------------------------------------------
    # Belgian fixed-line
    # Geographic numbers generally start with 0
    # and contain 9 digits in national format.
    # --------------------------------------------------------

    if re.fullmatch(r"0\d{8}", phone):
        return "FIXE"

    # --------------------------------------------------------
    # Unknown / invalid format
    # --------------------------------------------------------

    return "UNKNOWN"


# ============================================================
# READ FILE
# ============================================================

df = pd.read_excel(input_file, dtype=str)

# Make sure TELE exists
if "TELE" not in df.columns:
    raise ValueError("The column 'TELE' was not found in the file.")

# ============================================================
# ANALYZE TELE
# ============================================================

df["TYPE_TELE"] = df["TELE"].apply(classify_belgian_number)

# ============================================================
# SAVE
# ============================================================

df.to_excel(output_file, index=False)

print("DONE")
print()
print("Results:")
print(df["TYPE_TELE"].value_counts(dropna=False))
print()
print(f"Output: {output_file}")
