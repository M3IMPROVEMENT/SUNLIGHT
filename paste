
from pathlib import Path
import pandas as pd

# ================= CONFIGURATION =================

INPUT_FILE = Path(
    r"C:\Users\Sunlight\Desktop\NET\B2B\merged.xlsx"
)

OUTPUT_FILE = Path(
    r"C:\Users\Sunlight\Desktop\NET\B2B\deduplicated.xlsx"
)

AUDIT_FILE = Path(
    r"C:\Users\Sunlight\Desktop\NET\B2B\duplicates_audit.xlsx"
)

DEDUP_COLUMN = "TVA"

# ================= DEDUPLICATION =================

df = pd.read_excel(INPUT_FILE, dtype=str)

# Normalize headers
df.columns = df.columns.astype(str).str.strip()

if DEDUP_COLUMN not in df.columns:
    raise ValueError(
        f"Column '{DEDUP_COLUMN}' not found. "
        f"Available columns: {list(df.columns)}"
    )

# Clean TVA for comparison only
df["_dedup_key"] = (
    df[DEDUP_COLUMN]
    .fillna("")
    .str.strip()
    .str.upper()
    .str.replace(r"[\s.\-/]", "", regex=True)
)

# Count non-empty cells in each row
data_columns = [
    col for col in df.columns
    if col != "_dedup_key"
]

df["_info_score"] = (
    df[data_columns]
    .fillna("")
    .apply(
        lambda col: col.astype(str).str.strip().ne("")
    )
    .sum(axis=1)
)

# Separate rows with and without a TVA
has_key = df["_dedup_key"].ne("")

with_key = df[has_key].copy()
without_key = df[~has_key].copy()

# Rank most complete rows first within each TVA
with_key = with_key.sort_values(
    "_info_score",
    ascending=False,
    kind="stable"
)

# Keep the most complete row for each TVA
kept = with_key.drop_duplicates(
    subset="_dedup_key",
    keep="first"
)

# Keep rows with no TVA; don't merge them all into one
result = pd.concat(
    [kept, without_key],
    ignore_index=True
)

# Export removed duplicates for audit
duplicate_mask = with_key.duplicated(
    subset="_dedup_key",
    keep="first"
)

duplicates = with_key.loc[duplicate_mask].copy()

# Remove temporary columns
result = result.drop(
    columns=["_dedup_key", "_info_score"]
)

duplicates = duplicates.drop(
    columns=["_dedup_key", "_info_score"]
)

# Save
result.to_excel(OUTPUT_FILE, index=False)
duplicates.to_excel(AUDIT_FILE, index=False)

print(f"Rows before: {len(df):,}")
print(f"Rows after: {len(result):,}")
print(f"Duplicate rows removed: {len(duplicates):,}")
print(f"Clean file: {OUTPUT_FILE}")
print(f"Duplicate audit: {AUDIT_FILE}")
