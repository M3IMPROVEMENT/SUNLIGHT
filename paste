import pandas as pd
from pathlib import Path

# ==============================
# FILE PATH
# ==============================
input_file = r"C:\Users\Sunlight\Desktop\your_file.xlsx"

# Output file
output_file = r"C:\Users\Sunlight\Desktop\your_file_deduplicated.xlsx"


# ==============================
# READ EXCEL
# ==============================
df = pd.read_excel(input_file)


# ==============================
# CLEAN COLUMN NAMES
# ==============================
df.columns = df.columns.astype(str).str.strip()


# ==============================
# REMOVE DUPLICATES
# BASED ON NUMERO + LIBELLE
# ==============================
before = len(df)

df = df.drop_duplicates(
    subset=["Numéro", "Libellé"],
    keep="first"
)

after = len(df)


# ==============================
# SAVE
# ==============================
df.to_excel(output_file, index=False)


# ==============================
# RESULTS
# ==============================
print("--------------------------------")
print("DONE")
print("--------------------------------")
print(f"Rows before      : {before:,}")
print(f"Rows after       : {after:,}")
print(f"Duplicates removed: {before - after:,}")
print(f"Output            : {output_file}")
