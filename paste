# ============================================================
# BASIC CLEANING
# ============================================================

def digits_only(value):
    """
    Keep digits only.

    Examples:
        0475/12 34 56  -> 0475123456
        +32 475 12 34  -> 324751234
        0032 475...    -> 0032475...
    """

    if value is None:
        return ""

    text = str(value).strip()

    # Excel numeric value such as 010881429.0
    if text.endswith(".0"):
        text = text[:-2]

    return re.sub(r"\D", "", text)


# ============================================================
# NORMALIZE PREFIX
# ============================================================

def normalize_number(digits):
    """
    Convert Belgian prefixes to the same national representation.

    0032XXXXXXXXX -> 0XXXXXXXXX
    32XXXXXXXXX   -> 0XXXXXXXXX

    We do NOT remove the national 0 here.
    """

    if digits.startswith("0032"):
        rest = digits[4:]

        if rest:
            return "0" + rest

    if digits.startswith("32"):
        rest = digits[2:]

        if rest:
            return "0" + rest

    return digits


# ============================================================
# IS ONE BELGIAN PHONE NUMBER?
# ============================================================

def is_phone(digits):
    """
    Belgian phone number detection.

    Main Belgian national format:
        0 + 8 digits = 9 digits total

    International:
        32 + 9 digits = 11 digits
        0032 + 9 digits = 13 digits

    We also allow 10-digit national values because
    some source files contain them.
    """

    if not digits:
        return False

    # 0032 + 9 national digits
    if len(digits) == 13 and digits.startswith("0032"):
        return True

    # 32 + 9 national digits
    if len(digits) == 11 and digits.startswith("32"):
        return True

    # Belgian national number
    if len(digits) in (9, 10) and digits.startswith("0"):
        return True

    return False


# ============================================================
# CLEAN FINAL PHONE
# ============================================================

def clean_phone(digits):

    digits = digits_only(digits)

    if not digits:
        return ""

    # 0032xxxxxxxxx
    if digits.startswith("0032"):
        digits = "0" + digits[4:]

    # 32xxxxxxxxx
    elif digits.startswith("32"):
        digits = "0" + digits[2:]

    return digits


# ============================================================
# FIND ALL POSSIBLE PHONE SPLITS
# ============================================================

@lru_cache(maxsize=None)
def possible_splits(digits):

    results = []

    # --------------------------------------------------------
    # ONE NUMBER
    # --------------------------------------------------------

    if is_phone(digits):

        results.append((digits,))

    # --------------------------------------------------------
    # MULTIPLE NUMBERS
    #
    # Try every possible Belgian phone length.
    # --------------------------------------------------------

    for length in (9, 10, 11, 13):

        if len(digits) <= length:
            continue

        first = digits[:length]

        if not is_phone(first):
            continue

        rest = digits[length:]

        for solution in possible_splits(rest):

            results.append(
                (first,) + solution
            )

    # Remove duplicates
    unique = []

    seen = set()

    for result in results:

        if result not in seen:

            seen.add(result)
            unique.append(result)

    return tuple(unique)


# ============================================================
# ANALYZE ONE TELE CELL
# ============================================================

def analyze_tele(value):

    if value is None:
        return "EMPTY", [], ""

    original = str(value).strip()

    if not original:
        return "EMPTY", [], ""

    # --------------------------------------------------------
    # Convert everything to digits.
    #
    # This means:
    #
    # 011 27 08 46
    # becomes
    # 011270846
    #
    # 0475/252328
    # becomes
    # 0475252328
    # --------------------------------------------------------

    digits = digits_only(original)

    if not digits:
        return "AMBIGUOUS", [], "No digits"

    # --------------------------------------------------------
    # VERY IMPORTANT:
    #
    # First check whether the ENTIRE cell is one phone.
    #
    # This prevents:
    #
    # 011 27 08 46
    #
    # from being treated as 4 separate pieces.
    # --------------------------------------------------------

    if is_phone(digits):

        return "ONE", [digits], ""

    # --------------------------------------------------------
    # If entire value isn't one phone,
    # search for multiple phones.
    # --------------------------------------------------------

    solutions = possible_splits(digits)

    # Only keep solutions containing 2+ numbers
    multiple = [
        solution
        for solution in solutions
        if len(solution) >= 2
    ]

    # --------------------------------------------------------
    # EXACTLY ONE POSSIBLE SPLIT
    # --------------------------------------------------------

    if len(multiple) == 1:

        return "SPLIT", list(multiple[0]), ""

    # --------------------------------------------------------
    # MORE THAN ONE POSSIBLE SPLIT
    #
    # Do not guess.
    # --------------------------------------------------------

    if len(multiple) > 1:

        examples = []

        for solution in multiple[:5]:

            examples.append(
                " + ".join(
                    clean_phone(x)
                    for x in solution
                )
            )

        return (
            "AMBIGUOUS",
            [],
            "Several possible splits: "
            + " || ".join(examples)
        )

    # --------------------------------------------------------
    # NO VALID PHONE INTERPRETATION
    # --------------------------------------------------------

    return (
        "AMBIGUOUS",
        [],
        f"{len(digits)} digits; no valid phone interpretation"
    )


# ============================================================
# MAIN PROGRAM
# ============================================================

print("=" * 70)
print("BELGIAN TELE CLEAN + SPLIT")
print("=" * 70)

print()
print("Input :", INPUT_FILE)
print("Output:", OUTPUT_FILE)
print()

input_wb = openpyxl.load_workbook(
    INPUT_FILE,
    read_only=True,
    data_only=False
)

output_wb = openpyxl.Workbook(
    write_only=True
)

total_rows = 0
output_rows = 0

one_number_rows = 0
split_rows = 0
manual_rows = 0
empty_rows = 0


# ============================================================
# PROCESS EACH SHEET
# ============================================================

for ws in input_wb.worksheets:

    print()
    print("-" * 70)
    print("SHEET:", ws.title)
    print("-" * 70)

    output_ws = output_wb.create_sheet(
        title=ws.title
    )

    rows = ws.iter_rows()

    try:
        header = next(rows)
    except StopIteration:
        continue

    header_values = [
        cell.value for cell in header
    ]

    # --------------------------------------------------------
    # FIND TELE COLUMN
    # --------------------------------------------------------

    tele_index = None

    for i, value in enumerate(header_values):

        if value is not None:

            if str(value).strip().upper() == "TELE":

                tele_index = i
                break

    if tele_index is None:

        print("WARNING: TELE column not found.")

        output_ws.append(header_values)

        for row in rows:

            output_ws.append([
                cell.value for cell in row
            ])

        continue

    print(
        "TELE column:",
        tele_index + 1
    )

    # Write header
    output_ws.append(header_values)


    # ========================================================
    # ROWS
    # ========================================================

    for excel_row, row in enumerate(
        rows,
        start=2
    ):

        total_rows += 1

        values = [
            cell.value
            for cell in row
        ]

        original = values[tele_index]

        status, numbers, reason = analyze_tele(
            original
        )


        # ====================================================
        # EMPTY
        # ====================================================

        if status == "EMPTY":

            new_row = values.copy()

            new_row[tele_index] = ""

            output_ws.append(new_row)

            output_rows += 1
            empty_rows += 1

            continue


        # ====================================================
        # ONE NUMBER
        # ====================================================

        if status == "ONE":

            new_row = values.copy()

            new_row[tele_index] = clean_phone(
                numbers[0]
            )

            output_ws.append(new_row)

            output_rows += 1
            one_number_rows += 1

            continue


        # ====================================================
        # SPLIT
        # ====================================================

        if status == "SPLIT":

            split_rows += 1

            cleaned_numbers = [
                clean_phone(number)
                for number in numbers
            ]

            print()
            print(
                f"[SPLIT] "
                f"Sheet={ws.title} "
                f"| Excel row={excel_row}"
            )

            print(
                "Original:",
                original
            )

            print(
                "Numbers:",
                " | ".join(cleaned_numbers)
            )

            # -----------------------------------------------
            # CREATE ONE ROW FOR EACH PHONE
            # -----------------------------------------------

            for phone in cleaned_numbers:

                new_row = values.copy()

                new_row[tele_index] = phone

                output_ws.append(new_row)

                output_rows += 1

            continue


        # ====================================================
        # MANUAL CHECK
        # ====================================================

        manual_rows += 1

        print()
        print(
            f"[MANUAL CHECK] "
            f"Sheet={ws.title} "
            f"| Excel row={excel_row}"
        )

        print(
            "Original:",
            original
        )

        print(
            "Digits:",
            digits_only(original)
        )

        print(
            "Reason:",
            reason
        )

        # ----------------------------------------------------
        # IMPORTANT:
        #
        # DO NOT split an ambiguous value.
        #
        # Keep it in the same row after removing formatting.
        # ----------------------------------------------------

        new_row = values.copy()

        new_row[tele_index] = digits_only(
            original
        )

        output_ws.append(new_row)

        output_rows += 1


        # ====================================================
        # PROGRESS
        # ====================================================

        if total_rows % 10000 == 0:

            print()
            print(
                f"Progress: "
                f"{total_rows:,} rows | "
                f"Output: {output_rows:,} | "
                f"Split: {split_rows:,} | "
                f"Manual: {manual_rows:,}"
            )


