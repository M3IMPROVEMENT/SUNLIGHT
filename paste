from pathlib import Path
from openpyxl import load_workbook, Workbook

# ============================================================
# SETTINGS
# ============================================================

INPUT_FOLDER = Path(r"C:\Users\YourName\Desktop\excel_files")
OUTPUT_FOLDER = Path(r"C:\Users\YourName\Desktop\merged_output")

# Maximum DATA rows per output file
MAX_DATA_ROWS = 1_000_000

OUTPUT_FOLDER.mkdir(parents=True, exist_ok=True)


# ============================================================
# FIND ALL EXCEL FILES
# ============================================================

files = sorted([
    f for f in INPUT_FOLDER.glob("*.xlsx")
    if not f.name.startswith("~$")
])

print(f"Found {len(files)} Excel files")


if not files:
    raise SystemExit("❌ No Excel files found.")


# ============================================================
# CREATE OUTPUT FILE
# ============================================================

output_number = 1
data_rows_in_output = 0
total_rows = 0


def create_output_file(number, header):

    path = OUTPUT_FOLDER / f"merged_{number:03d}.xlsx"

    wb = Workbook(write_only=True)
    ws = wb.create_sheet("Sheet1")

    # Write header
    ws.append(header)

    print(f"\n📁 Creating {path.name}")

    return wb, ws, path


# ============================================================
# GET HEADER FROM FIRST FILE
# ============================================================

first_wb = load_workbook(
    files[0],
    read_only=True,
    data_only=False
)

first_ws = first_wb.worksheets[0]

header = next(first_ws.iter_rows(values_only=True))

header = list(header)

first_wb.close()

print("\nHeader:")
print(header)


# ============================================================
# CREATE FIRST OUTPUT
# ============================================================

output_wb, output_ws, output_path = create_output_file(
    output_number,
    header
)


# ============================================================
# PROCESS EVERY FILE
# ============================================================

for file_number, file in enumerate(files, start=1):

    print(
        f"\n[{file_number}/{len(files)}] "
        f"{file.name}"
    )

    try:

        wb = load_workbook(
            file,
            read_only=True,
            data_only=False
        )

        ws = wb.worksheets[0]

        file_rows = 0

        # Skip header row
        rows = ws.iter_rows(
            min_row=2,
            values_only=True
        )

        for row in rows:

            # ------------------------------------------------
            # IMPORTANT:
            # WE DO NOT CHECK IF ROW IS EMPTY.
            #
            # A row containing ONLY STE is copied.
            # A row containing STE + empty cells is copied.
            # Nothing is filtered or deleted.
            # ------------------------------------------------

            if data_rows_in_output >= MAX_DATA_ROWS:

                output_wb.save(output_path)

                print(
                    f"   ✅ Saved {output_path.name} "
                    f"({data_rows_in_output:,} data rows)"
                )

                output_number += 1
                data_rows_in_output = 0

                output_wb, output_ws, output_path = (
                    create_output_file(
                        output_number,
                        header
                    )
                )

            # Copy the row exactly
            output_ws.append(list(row))

            data_rows_in_output += 1
            file_rows += 1
            total_rows += 1

        wb.close()

        print(
            f"   → {file_rows:,} rows copied"
        )

    except Exception as e:

        print(f"❌ ERROR: {file.name}")
        print(f"   {e}")


# ============================================================
# SAVE LAST OUTPUT
# ============================================================

output_wb.save(output_path)

print(
    f"\n✅ Saved {output_path.name} "
    f"({data_rows_in_output:,} data rows)"
)


# ============================================================
# FINAL SUMMARY
# ============================================================

print("\n" + "=" * 60)
print("MERGE COMPLETED")
print("=" * 60)

print(f"Input files       : {len(files):,}")
print(f"Output files      : {output_number:,}")
print(f"Total rows copied : {total_rows:,}")
print(f"Output folder     : {OUTPUT_FOLDER}")

print("=" * 60)
