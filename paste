"""Check TVA and GSM columns of an Excel file against KBO Public Search.

Usage: python check_kbo.py            (uses input.xlsx -> output.xlsx)
       python check_kbo.py in.xlsx out.xlsx
Requires: pip install requests beautifulsoup4 openpyxl
"""
import os
import re
import sys
import time

import requests
from bs4 import BeautifulSoup
from openpyxl import load_workbook

TVA_COL = "TVA"   # header name of the TVA column (10 digits, BE optional)
GSM_COL = "GSM"   # header name of the GSM column
URL = "https://kbopub.economie.fgov.be/kbopub/toonondernemingps.html"


def to_text(value):
    if value is None:
        return ""
    if isinstance(value, float) and value.is_integer():
        value = int(value)
    return str(value)


def digits(value):
    return re.sub(r"\D", "", to_text(value))


def norm_tva(value):
    d = digits(value)
    return d.zfill(10) if d else ""


def norm_phone(value):
    d = digits(value)
    return d[-8:] if d else ""


def value_after(lines, label):
    for i, line in enumerate(lines):
        if line.lower().startswith(label.lower()):
            rest = line.split(":", 1)[1].strip() if ":" in line else ""
            if rest:
                return rest
            if i + 1 < len(lines):
                return lines[i + 1]
    return ""


def fetch_kbo(number):
    r = requests.get(
        URL,
        params={"ondernemingsnummer": number, "lang": "fr"},
        headers={"User-Agent": "Mozilla/5.0"},
        timeout=30,
    )
    r.raise_for_status()
    text = BeautifulSoup(r.text, "html.parser").get_text("\n")
    text = text.replace("\xa0", " ")
    lines = [re.sub(r"\s+", " ", l).strip() for l in text.splitlines()]
    lines = [l for l in lines if l]
    status = value_after(lines, "Assujettie à la TVA")
    phone = value_after(lines, "Numéro de téléphone")
    return status, phone


def main(src, dst):
    if not os.path.exists(src):
        print(f"File not found: {src}")
        print("Put your Excel file next to this script, or pass its name.")
        return

    wb = load_workbook(src)
    ws = wb.active

    headers = [to_text(c.value).strip() for c in ws[1]]
    print(f"Columns found: {headers}")
    lower = [h.lower() for h in headers]
    if TVA_COL.lower() not in lower or GSM_COL.lower() not in lower:
        print(f"Columns '{TVA_COL}' and/or '{GSM_COL}' not found. "
              "Change TVA_COL / GSM_COL at the top of the script.")
        return

    tva_idx = lower.index(TVA_COL.lower()) + 1
    gsm_idx = lower.index(GSM_COL.lower()) + 1

    # New columns after the last used column
    first_new = ws.max_column + 1
    for offset, name in enumerate(
        ["kbo_tva_status", "kbo_phone", "tva_ok", "gsm_ok"]
    ):
        ws.cell(row=1, column=first_new + offset, value=name)

    total = ws.max_row - 1
    for r in range(2, ws.max_row + 1):
        tva = norm_tva(ws.cell(row=r, column=tva_idx).value)
        gsm = ws.cell(row=r, column=gsm_idx).value
        try:
            status, phone = fetch_kbo(tva) if tva else ("", "")
        except Exception as e:
            status, phone = f"ERREUR: {e}", ""

        tva_ok = "oui" if status.lower().startswith("oui") else "non"
        mine, theirs = norm_phone(gsm), norm_phone(phone)
        gsm_ok = "oui" if mine and mine == theirs else (
            "absent KBO" if not theirs else "non"
        )

        ws.cell(row=r, column=first_new, value=status)
        ws.cell(row=r, column=first_new + 1, value=phone)
        ws.cell(row=r, column=first_new + 2, value=tva_ok)
        ws.cell(row=r, column=first_new + 3, value=gsm_ok)

        print(f"[{r - 1}/{total}] TVA {tva or '-'} | KBO status: "
              f"{status or '-'} | KBO phone: {phone or '-'} | "
              f"tva_ok={tva_ok} gsm_ok={gsm_ok}")
        time.sleep(1)

    wb.save(dst)
    print(f"Done. Results saved to {dst}")


if __name__ == "__main__":
    src = sys.argv[1] if len(sys.argv) > 1 else "input.xlsx"
    dst = sys.argv[2] if len(sys.argv) > 2 else "output.xlsx"
    main(src, dst)
