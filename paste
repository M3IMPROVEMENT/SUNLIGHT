import os
from pathlib import Path
from openpyxl import load_workbook, Workbook
from openpyxl.utils import get_column_letter
import pandas as pd
from datetime import datetime


# ============================================================
# 1. CONFIGURATION
# ============================================================

# Folder containing your 1500 Excel files
INPUT_FOLDER = Path(r"C:\YOUR_FOLDER\EXCEL_FILES")

# Folder where the merged files will be created
OUTPUT_FOLDER = Path(r"C:\YOUR_FOLDER\MERGED_OUTPUT")

# Maximum DATA rows per output file
# Excel limit is 1,048,576 rows including the header.
MAX_ROWS_PER_FILE = 1_000_000


# ============================================================
# 2. REQUIRED COLUMNS
# ============================================================

REQUIRED_COLUMNS = [
    "STE",
    "TVA",
    "NOM",
    "ADRESSE",
    "NUMERO",
    "COMPLEMENT",
    "CP",
    "VILLE",
    "GSM",
    "TEL1",
    "TEL2",
    "TEL3"
]


# ============================================================
# 3. PREPARE OUTPUT FOLDER
# ============================================================

OUTPUT_FOLDER.mkdir(parents=True, exist_ok=True)

REPORT_FILE = OUTPUT_FOLDER / "files_to_fix.xlsx"


# ============================================================
# 4. NORMALIZE HEADER
# ============================================================

def normalize_header(value):
    """
    Makes headers easier to compare.

    Example:
        ' gsm ' -> 'GSM'
        'Complement' -> 'COMPLEMENT'
    """

    if value is None:
        return ""

    return str(value).strip().upper()


# ============================================================
# 5. CHECK HEADERS
# ============================================================

def check_headers(file_path):

    try:
        wb = load_workbook(
            file_path,
            read_only=True,
            data_only=True
        )

        ws = wb.active

        # Read first row
        headers = next(ws.iter_rows(
            min_row=1,
            max_row=1,
            values_only=True
        ))

        headers = [normalize_header(x) for x in headers]

        # Empty headers
        empty_headers = []

        for i, header in enumerate(headers, start=1):
            if header == "":
                empty_headers.append(
                    f"Column {get_column_letter(i)}"
                )

        # Duplicate headers
        duplicates = []

        seen = set()

        for header in headers:

            if header == "":
                continue

            if header in seen:
                if header not in duplicates:
                    duplicates.append(header)

            seen.add(header)

        # Missing required columns
        missing_columns = [
            col for col in REQUIRED_COLUMNS
            if col not in headers
        ]

        # Extra columns
        extra_columns = [
            col for col in headers
            if col not in REQUIRED_COLUMNS and col != ""
        ]

        wb.close()

        return {
            "valid": (
                len(missing_columns) == 0
                and len(duplicates) == 0
                and len(empty_headers) == 0
            ),
            "missing": missing_columns,
            "duplicates": duplicates,
            "empty": empty_headers,
            "extra": extra_columns
        }

    except Exception as e:

        return {
            "valid": False,
            "missing": [],
            "duplicates": [],
            "empty": [],
            "extra": [],
            "error": str(e)
        }


# ============================================================
# 6. GET ALL EXCEL FILES
# ============================================================

excel_files = sorted(
    [
        f for f in INPUT_FOLDER.iterdir()
        if f.is_file()
        and f.suffix.lower() == ".xlsx"
        and not f.name.startswith("~$")
    ]
)

print()
print("=" * 70)
print("EXCEL MERGE")
print("=" * 70)

print(f"Input folder : {INPUT_FOLDER}")
print(f"Files found  : {len(excel_files)}")
print()


# ============================================================
# 7. VALIDATE ALL FILES FIRST
# ============================================================

print("=" * 70)
print("STEP 1 - CHECKING HEADERS")
print("=" * 70)

valid_files = []
files_to_fix = []

for index, file_path in enumerate(excel_files, start=1):

    result = check_headers(file_path)

    if result["valid"]:

        valid_files.append(file_path)

    else:

        files_to_fix.append({
            "FILE_NAME": file_path.name,
            "FULL_PATH": str(file_path),
            "MISSING_COLUMNS": ", ".join(result["missing"]),
            "DUPLICATE_COLUMNS": ", ".join(result["duplicates"]),
            "EMPTY_HEADERS": ", ".join(result["empty"]),
            "EXTRA_COLUMNS": ", ".join(result["extra"]),
            "ERROR": result.get("error", "")
        })

        print()
        print("❌ FILE TO FIX:")
        print(f"   {file_path.name}")

        if result["missing"]:
            print(
                "   Missing:",
                ", ".join(result["missing"])
            )

        if result["duplicates"]:
            print(
                "   Duplicate:",
                ", ".join(result["duplicates"])
            )

        if result["empty"]:
            print(
                "   Empty headers:",
                ", ".join(result["empty"])
            )

        if result["extra"]:
            print(
                "   Extra:",
                ", ".join(result["extra"])
            )

        if result.get("error"):
            print(
                "   Error:",
                result["error"]
            )

    # Progress
    if index % 50 == 0 or index == len(excel_files):

        print(
            f"Checked {index}/{len(excel_files)} files..."
        )


# ============================================================
# 8. SAVE FILES-TO-FIX REPORT
# ============================================================

if files_to_fix:

    report_df = pd.DataFrame(files_to_fix)

    report_df.to_excel(
        REPORT_FILE,
        index=False
    )

    print()
    print("=" * 70)
    print("FILES THAT NEED FIXING")
    print("=" * 70)

    print(
        f"❌ {len(files_to_fix)} files need fixing."
    )

    print(
        f"Report saved to:\n{REPORT_FILE}"
    )

else:

    print()
    print("✅ All files have valid headers.")


# ============================================================
# 9. STOP IF NO VALID FILES
# ============================================================

if not valid_files:

    print()
    print("❌ No valid files to merge.")
    print("Fix the files and run the script again.")
    raise SystemExit


# ============================================================
# 10. MERGE VALID FILES
# ============================================================

print()
print("=" * 70)
print("STEP 2 - MERGING VALID FILES")
print("=" * 70)

print(
    f"Valid files : {len(valid_files)}"
)

print(
    f"Skipped files : {len(files_to_fix)}"
)

print()


# ============================================================
# 11. FUNCTION TO CREATE OUTPUT FILE
# ============================================================

output_counter = 1
rows_in_current_file = 0
total_rows = 0

current_output_path = None
current_wb = None
current_ws = None


def create_new_output():

    global output_counter
    global rows_in_current_file
    global current_output_path
    global current_wb
    global current_ws

    # Close previous workbook
    if current_wb is not None:
        current_wb.save(current_output_path)
        current_wb.close()

    current_output_path = (
        OUTPUT_FOLDER
        / f"merged_{output_counter:03d}.xlsx"
    )

    current_wb = Workbook(write_only=True)

    current_ws = current_wb.create_sheet(
        title="Data"
    )

    # Write headers
    current_ws.append(REQUIRED_COLUMNS)

    rows_in_current_file = 0

    print()
    print(
        f"📁 Creating: {current_output_path.name}"
    )

    output_counter += 1


# ============================================================
# 12. START FIRST OUTPUT FILE
# ============================================================

create_new_output()


# ============================================================
# 13. PROCESS EACH VALID FILE
# ============================================================

for file_number, file_path in enumerate(
    valid_files,
    start=1
):

    print(
        f"[{file_number}/{len(valid_files)}] "
        f"Processing: {file_path.name}"
    )

    try:

        wb = load_workbook(
            file_path,
            read_only=True,
            data_only=True
        )

        ws = wb.active

        # Get headers
        header_row = next(
            ws.iter_rows(
                min_row=1,
                max_row=1,
                values_only=True
            )
        )

        normalized_headers = [
            normalize_header(x)
            for x in header_row
        ]

        # Map required columns to positions
        column_positions = {
            column: normalized_headers.index(column)
            for column in REQUIRED_COLUMNS
        }

        file_rows = 0

        # Read data rows
        for row in ws.iter_rows(
            min_row=2,
            values_only=True
        ):

            # Stop if the output reaches 1 million rows
            if rows_in_current_file >= MAX_ROWS_PER_FILE:

                create_new_output()

            # Reconstruct row in required order
            output_row = [
                row[column_positions[column]]
                if column_positions[column] < len(row)
                else None
                for column in REQUIRED_COLUMNS
            ]

            current_ws.append(output_row)

            rows_in_current_file += 1
            total_rows += 1
            file_rows += 1

        wb.close()

        print(
            f"    ✓ {file_rows:,} rows"
        )

    except Exception as e:

        print()
        print(
            f"❌ ERROR while processing: "
            f"{file_path.name}"
        )

        print(
            f"   {e}"
        )

        # Add error to report
        files_to_fix.append({
            "FILE_NAME": file_path.name,
            "FULL_PATH": str(file_path),
            "MISSING_COLUMNS": "",
            "DUPLICATE_COLUMNS": "",
            "EMPTY_HEADERS": "",
            "EXTRA_COLUMNS": "",
            "ERROR": str(e)
        })


# ============================================================
# 14. SAVE LAST OUTPUT FILE
# ============================================================

if current_wb is not None:

    current_wb.save(current_output_path)
    current_wb.close()


# ============================================================
# 15. FINAL SUMMARY
# ============================================================

number_of_output_files = output_counter - 1

print()
print("=" * 70)
print("MERGE FINISHED")
print("=" * 70)

print(
    f"Files found:        {len(excel_files):,}"
)

print(
    f"Valid files:        {len(valid_files):,}"
)

print(
    f"Files to fix:       {len(files_to_fix):,}"
)

print(
    f"Total rows merged:  {total_rows:,}"
)

print(
    f"Output files:       {number_of_output_files:,}"
)

print()
print(
    f"Output folder:"
)
print(
    OUTPUT_FOLDER
)

if files_to_fix:

    print()
    print(
        "⚠️ Files that need fixing:"
    )

    print(
        REPORT_FILE
    )

print()
print("=" * 70)
print("DONE")
print("=" * 70)
