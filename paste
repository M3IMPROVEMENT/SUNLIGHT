from pathlib import Path
from openpyxl import load_workbook, Workbook


# ============================================================
# 1. INPUT EXCEL FILE
# ============================================================

INPUT_FILE = Path(
    r"C:\Users\Sunlight\Desktop\15-09-26\MERIAME15_9\Nouveau dossier\YOUR_FILE.xlsx"
)


# ============================================================
# 2. OUTPUT FILE
# ============================================================

OUTPUT_FILE = INPUT_FILE.parent / f"{INPUT_FILE.stem}_TELEPHONE.xlsx"


# ============================================================
# 3. COLUMNS
# ============================================================

BASE_COLUMNS = [
    "STE",
    "TVA",
    "NOM",
    "ADRESSE",
    "NUMERO",
    "COMPLEMENT",
    "CP",
    "VILLE"
]

PHONE_COLUMNS = [
    "GSM",
    "TEL1",
    "TEL2",
    "TEL3"
]

FINAL_COLUMNS = BASE_COLUMNS + ["TELEPHONE"]


# ============================================================
# 4. OPEN INPUT
# ============================================================

wb_in = load_workbook(
    INPUT_FILE,
    read_only=True,
    data_only=False
)

ws_in = wb_in.active


# ============================================================
# 5. READ HEADER
# ============================================================

header = next(ws_in.iter_rows(values_only=True))

header_map = {
    str(value).strip().upper(): index
    for index, value in enumerate(header)
    if value is not None
}


# ============================================================
# 6. CHECK COLUMNS
# ============================================================

required_columns = BASE_COLUMNS + PHONE_COLUMNS

missing_columns = [
    column
    for column in required_columns
    if column.upper() not in header_map
]

if missing_columns:
    print("❌ Missing columns:")
    print(missing_columns)
    wb_in.close()
    raise SystemExit


# ============================================================
# 7. CREATE OUTPUT
# ============================================================

wb_out = Workbook(write_only=True)
ws_out = wb_out.create_sheet("DATA")

ws_out.append(FINAL_COLUMNS)


# ============================================================
# 8. COUNTERS
# ============================================================

telephone_count = 0
empty_telephone_rows = 0
output_rows = 0

gsm_count = 0
tel1_count = 0
tel2_count = 0
tel3_count = 0


# ============================================================
# 9. PROCESS EVERY ROW
# ============================================================

for row in ws_in.iter_rows(
    min_row=2,
    values_only=True
):

    # --------------------------------------------------------
    # COMPANY INFORMATION
    # --------------------------------------------------------

    base_data = [
        row[header_map[column.upper()]]
        for column in BASE_COLUMNS
    ]


    # --------------------------------------------------------
    # GET PHONES
    # --------------------------------------------------------

    phones = []

    # GSM
    value = row[header_map["GSM"]]

    if value is not None and value != "":
        phones.append(value)
        gsm_count += 1


    # TEL1
    value = row[header_map["TEL1"]]

    if value is not None and value != "":
        phones.append(value)
        tel1_count += 1


    # TEL2
    value = row[header_map["TEL2"]]

    if value is not None and value != "":
        phones.append(value)
        tel2_count += 1


    # TEL3
    value = row[header_map["TEL3"]]

    if value is not None and value != "":
        phones.append(value)
        tel3_count += 1


    # --------------------------------------------------------
    # ONE PHONE = ONE ROW
    # --------------------------------------------------------

    if phones:

        for phone in phones:

            ws_out.append(
                base_data + [phone]
            )

            telephone_count += 1
            output_rows += 1


    # --------------------------------------------------------
    # NO PHONE → KEEP THE ORIGINAL ROW
    # --------------------------------------------------------

    else:

        ws_out.append(
            base_data + [""]
        )

        empty_telephone_rows += 1
        output_rows += 1


# ============================================================
# 10. SAVE
# ============================================================

wb_out.save(OUTPUT_FILE)

wb_in.close()


# ============================================================
# 11. FINAL REPORT
# ============================================================

print()
print("=" * 70)
print("DONE")
print("=" * 70)

print(f"GSM              : {gsm_count:,}")
print(f"TEL1             : {tel1_count:,}")
print(f"TEL2             : {tel2_count:,}")
print(f"TEL3             : {tel3_count:,}")
print("-" * 70)
print(f"TOTAL TELEPHONES : {telephone_count:,}")
print(f"NO PHONE ROWS    : {empty_telephone_rows:,}")
print(f"TOTAL OUTPUT ROWS: {output_rows:,}")
print("-" * 70)
print(f"OUTPUT FILE      : {OUTPUT_FILE}")
print("=" * 70)
