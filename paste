from pathlib import Path
from openpyxl import load_workbook, Workbook
from datetime import datetime

# ============================================================
# STEP 1
# SMART MERGE OF EXCEL FILES
#
# OUTPUT:
#   MASTER_001.xlsx
#   MASTER_002.xlsx
#   MASTER_003.xlsx
#   ...
#
# TARGET:
#   Maximum ~700,000 DATA ROWS per output file
#
# IMPORTANT:
# - Nothing is deleted
# - No duplicates are removed
# - No cleaning
# - No filtering
# - Only selected columns are kept
# - SOURCE is added at the end
# ============================================================


# ============================================================
# 1. YOUR INPUT FOLDER
# ============================================================

INPUT_FOLDER = Path(
    r"C:\YOUR_FOLDER_HERE"
)


# ============================================================
# 2. MAXIMUM ROWS PER MASTER
# ============================================================

MAX_ROWS_PER_MASTER = 700_000


# ============================================================
# 3. COLUMNS TO KEEP
# ============================================================

KEEP_COLUMNS = [
    "STE",
    "TVA",
    "NOM",
    "ADRESSE",
    "NUMERO",
    "COMPLEMENT",
    "CP",
    "VILLE",
    "GSM",
    "TEL1",
    "TEL2",
    "TEL3"
]


# ============================================================
# 4. FIND EXCEL FILES
# ============================================================

files = sorted([
    f
    for f in INPUT_FOLDER.iterdir()
    if f.is_file()
    and f.suffix.lower() in [".xlsx", ".xlsm"]
    and not f.name.startswith("~$")
])


print("=" * 75)
print("SMART EXCEL MERGE")
print("=" * 75)

print(f"Excel files found: {len(files)}")


if not files:
    raise Exception(
        "No Excel files found."
    )


# ============================================================
# 5. OUTPUT FOLDER
# ============================================================

timestamp = datetime.now().strftime(
    "%Y%m%d_%H%M%S"
)

OUTPUT_FOLDER = (
    INPUT_FOLDER /
    f"MASTER_OUTPUT_{timestamp}"
)

OUTPUT_FOLDER.mkdir(
    exist_ok=True
)


# ============================================================
# VARIABLES
# ============================================================

master_number = 0

current_master_rows = 0
total_rows = 0
total_files = 0

errors = []

wb_out = None
ws_out = None


# ============================================================
# CREATE NEW MASTER
# ============================================================

def create_new_master():

    global master_number
    global current_master_rows
    global wb_out
    global ws_out

    # Close previous workbook
    if wb_out is not None:

        wb_out.save(
            current_output_path
        )

        wb_out.close()

    master_number += 1

    current_master_rows = 0

    # New filename
    filename = (
        f"MASTER_{master_number:03d}.xlsx"
    )

    global current_output_path

    current_output_path = (
        OUTPUT_FOLDER / filename
    )

    print("\n" + "=" * 75)

    print(
        f"CREATING {filename}"
    )

    print("=" * 75)

    # Write-only workbook
    wb_out = Workbook(
        write_only=True
    )

    ws_out = wb_out.create_sheet(
        title="Master"
    )

    # Header
    ws_out.append(
        KEEP_COLUMNS + ["SOURCE"]
    )


# ============================================================
# CREATE FIRST MASTER
# ============================================================

create_new_master()


# ============================================================
# PROCESS EACH EXCEL FILE
# ============================================================

for file_number, file_path in enumerate(
    files,
    start=1
):

    print("\n" + "-" * 75)

    print(
        f"[{file_number}/{len(files)}] "
        f"{file_path.name}"
    )

    try:

        # ====================================================
        # OPEN INPUT FILE
        # ====================================================

        wb_in = load_workbook(
            filename=file_path,
            read_only=True,
            data_only=False
        )

        ws_in = wb_in[
            wb_in.sheetnames[0]
        ]

        rows = ws_in.iter_rows(
            values_only=True
        )


        # ====================================================
        # READ HEADER
        # ====================================================

        try:

            original_header = next(rows)

        except StopIteration:

            print(
                "⚠ Empty file - skipped."
            )

            wb_in.close()

            continue


        # ====================================================
        # CREATE HEADER MAP
        # ====================================================

        header_map = {}

        for index, column in enumerate(
            original_header
        ):

            if column is not None:

                name = (
                    str(column)
                    .strip()
                    .upper()
                )

                header_map[name] = index


        # ====================================================
        # CHECK MISSING COLUMNS
        # ====================================================

        missing = [
            column
            for column in KEEP_COLUMNS
            if column.upper()
            not in header_map
        ]

        if missing:

            print(
                f"⚠ Missing columns: {missing}"
            )


        # ====================================================
        # PROCESS ROWS
        # ====================================================

        file_rows = 0

        for row in rows:

            # ------------------------------------------------
            # BUILD OUTPUT ROW
            # ------------------------------------------------

            output_row = []

            for column in KEEP_COLUMNS:

                index = header_map.get(
                    column.upper()
                )

                if (
                    index is not None
                    and index < len(row)
                ):

                    value = row[index]

                else:

                    value = None

                output_row.append(value)


            # ------------------------------------------------
            # ADD SOURCE AT THE END
            # ------------------------------------------------

            output_row.append(
                file_path.name
            )


            # ------------------------------------------------
            # WRITE ROW
            # ------------------------------------------------

            ws_out.append(
                output_row
            )

            current_master_rows += 1
            total_rows += 1
            file_rows += 1


            # ------------------------------------------------
            # IMPORTANT:
            #
            # We do NOT split in the middle of a source file.
            #
            # The current source is allowed to finish.
            #
            # After the file finishes, if the Master is
            # over 700,000, the next source starts a new one.
            # ------------------------------------------------


        wb_in.close()

        total_files += 1

        print(
            f"✓ {file_rows:,} rows copied"
        )

        print(
            f"Current Master rows: "
            f"{current_master_rows:,}"
        )


        # ====================================================
        # IF MASTER HAS REACHED / EXCEEDED TARGET
        # START NEW MASTER FOR NEXT SOURCE
        # ====================================================

        if (
            current_master_rows
            >= MAX_ROWS_PER_MASTER
        ):

            print(
                "\n→ Target reached."
            )

            print(
                "→ Next source will start "
                "a new Master."
            )

            # Save current Master
            wb_out.save(
                current_output_path
            )

            wb_out.close()

            wb_out = None
            ws_out = None

            create_new_master()


    except Exception as error:

        errors.append(
            f"{file_path.name} -> {error}"
        )

        print(
            f"❌ ERROR: {error}"
        )


# ============================================================
# SAVE FINAL MASTER
# ============================================================

if wb_out is not None:

    wb_out.save(
        current_output_path
    )

    wb_out.close()


# ============================================================
# FINAL REPORT
# ============================================================

print("\n")
print("=" * 75)
print("MERGE FINISHED")
print("=" * 75)

print(
    f"Excel files found     : "
    f"{len(files):,}"
)

print(
    f"Excel files processed : "
    f"{total_files:,}"
)

print(
    f"Master files created  : "
    f"{master_number:,}"
)

print(
    f"Total rows copied     : "
    f"{total_rows:,}"
)

print(
    f"Errors                : "
    f"{len(errors):,}"
)

print(
    f"\nOutput folder:\n"
    f"{OUTPUT_FOLDER}"
)


# ============================================================
# ERRORS
# ============================================================

if errors:

    print("\n" + "=" * 75)
    print("ERRORS")
    print("=" * 75)

    for error in errors:

        print(
            " -",
            error
        )

else:

    print(
        "\n✓ ALL FILES PROCESSED SUCCESSFULLY"
    )


print("\n")
print("NOTHING WAS:")
print("✓ Deleted")
print("✓ Deduplicated")
print("✓ Cleaned")
print("✓ Filtered")

print("\nKept columns:")

print(
    ", ".join(KEEP_COLUMNS)
)

print("\nSOURCE = last column")
