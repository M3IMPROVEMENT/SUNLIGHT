from pathlib import Path
from openpyxl import load_workbook, Workbook


# ============================================================
# SETTINGS
# ============================================================

INPUT_FOLDER = Path(r"C:\Users\YourName\Desktop\excel_files")
OUTPUT_FOLDER = Path(r"C:\Users\YourName\Desktop\merged_output")

MAX_ROWS = 1_000_000

OUTPUT_FOLDER.mkdir(parents=True, exist_ok=True)


# ============================================================
# FIND FILES
# ============================================================

files = sorted([
    f for f in INPUT_FOLDER.glob("*.xlsx")
    if not f.name.startswith("~$")
])

print(f"Found {len(files)} files")


# ============================================================
# CREATE OUTPUT FILE
# ============================================================

def create_output(number, header):

    path = OUTPUT_FOLDER / f"merged_{number:03d}.xlsx"

    wb = Workbook(write_only=True)
    ws = wb.create_sheet("Sheet1")

    # Header ONLY ONCE
    ws.append(header)

    return wb, ws, path


# ============================================================
# READ FIRST FILE HEADER
# ============================================================

wb = load_workbook(
    files[0],
    read_only=True,
    data_only=False
)

ws = wb.worksheets[0]

header = list(
    next(
        ws.iter_rows(
            min_row=1,
            max_row=1,
            values_only=True
        )
    )
)

wb.close()


# ============================================================
# ADD SOURCE COLUMN
# ============================================================

header.append("source")


print("\nOUTPUT HEADER:")
print(header)


# ============================================================
# INITIALIZE
# ============================================================

output_number = 1
output_rows = 0
total_rows = 0

output_wb, output_ws, output_path = create_output(
    output_number,
    header
)


# ============================================================
# PROCESS FILES
# ============================================================

for file_number, file in enumerate(files, start=1):

    print(
        f"\n[{file_number}/{len(files)}] {file.name}"
    )

    try:

        wb = load_workbook(
            file,
            read_only=True,
            data_only=False
        )

        ws = wb.worksheets[0]


        # ====================================================
        # SKIP ONLY THE HEADER ROW
        # ====================================================

        rows = ws.iter_rows(
            min_row=2,
            values_only=True
        )


        file_rows = 0


        # ====================================================
        # COPY EVERY OTHER ROW
        # ====================================================

        for row in rows:

            # -----------------------------------------------
            # DO NOT CHANGE THE ROW
            # -----------------------------------------------

            new_row = list(row)

            # -----------------------------------------------
            # ADD SOURCE
            # -----------------------------------------------

            new_row.append(file.name)


            # -----------------------------------------------
            # NEW OUTPUT FILE IF LIMIT REACHED
            # -----------------------------------------------

            if output_rows >= MAX_ROWS:

                output_wb.save(output_path)

                print(
                    f"   Saved: {output_path.name}"
                )

                output_number += 1
                output_rows = 0

                output_wb, output_ws, output_path = (
                    create_output(
                        output_number,
                        header
                    )
                )


            # -----------------------------------------------
            # WRITE ROW
            # -----------------------------------------------

            output_ws.append(new_row)

            output_rows += 1
            total_rows += 1
            file_rows += 1


        wb.close()


        print(
            f"   Rows copied: {file_rows:,}"
        )


    except Exception as e:

        print(
            f"   ❌ ERROR: {file.name}"
        )

        print(e)


# ============================================================
# SAVE LAST FILE
# ============================================================

output_wb.save(output_path)


# ============================================================
# FINAL RESULT
# ============================================================

print("\n")
print("=" * 70)
print("MERGE FINISHED")
print("=" * 70)

print(
    f"Input files : {len(files):,}"
)

print(
    f"Output files: {output_number:,}"
)

print(
    f"Data rows   : {total_rows:,}"
)

print(
    f"Output      : {OUTPUT_FOLDER}"
)

print("=" * 70)
