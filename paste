from pathlib import Path
from openpyxl import load_workbook, Workbook


# ============================================================
# 1. INPUT EXCEL FILE
# ============================================================

INPUT_FILE = Path(
    r"C:\Users\Sunlight\Desktop\15-09-26\MERIAME15_9\Nouveau dossier\YOUR_FILE.xlsx"
)


# ============================================================
# 2. OUTPUT FILE
# ============================================================

OUTPUT_FILE = INPUT_FILE.parent / f"{INPUT_FILE.stem}_TELEPHONE.xlsx"


# ============================================================
# 3. COLUMNS TO KEEP
# ============================================================

BASE_COLUMNS = [
    "STE",
    "TVA",
    "NOM",
    "ADRESSE",
    "NUMERO",
    "COMPLEMENT",
    "CP",
    "VILLE"
]

PHONE_COLUMNS = [
    "GSM",
    "TEL1",
    "TEL2",
    "TEL3"
]

FINAL_COLUMNS = BASE_COLUMNS + ["TELEPHONE"]


# ============================================================
# 4. OPEN INPUT FILE
# ============================================================

print("=" * 70)
print(f"Processing: {INPUT_FILE.name}")
print("=" * 70)

wb_in = load_workbook(
    INPUT_FILE,
    read_only=True,
    data_only=False
)

ws_in = wb_in.active


# ============================================================
# 5. READ HEADER
# ============================================================

header = next(ws_in.iter_rows(values_only=True))

header_map = {
    str(value).strip().upper(): index
    for index, value in enumerate(header)
    if value is not None
}


# ============================================================
# 6. CHECK REQUIRED COLUMNS
# ============================================================

required_columns = BASE_COLUMNS + PHONE_COLUMNS

missing_columns = [
    column
    for column in required_columns
    if column.upper() not in header_map
]

if missing_columns:
    print("❌ Missing columns:")
    print(missing_columns)
    wb_in.close()
    raise SystemExit


# ============================================================
# 7. CREATE OUTPUT FILE
# ============================================================

wb_out = Workbook(write_only=True)
ws_out = wb_out.create_sheet("DATA")

# Final header
ws_out.append(FINAL_COLUMNS)


# ============================================================
# 8. PROCESS EACH ROW
# ============================================================

output_rows = 0
telephone_count = 0

for row in ws_in.iter_rows(
    min_row=2,
    values_only=True
):

    # --------------------------------------------------------
    # COMPANY INFORMATION
    # --------------------------------------------------------

    base_data = [
        row[header_map[column.upper()]]
        for column in BASE_COLUMNS
    ]


    # --------------------------------------------------------
    # GET GSM + TEL1 + TEL2 + TEL3
    # --------------------------------------------------------

    phones = []

    for phone_column in PHONE_COLUMNS:

        value = row[header_map[phone_column.upper()]]

        # ONLY ignore empty cells.
        # DO NOT clean or modify the telephone.
        if value is not None and value != "":
            phones.append(value)


    # --------------------------------------------------------
    # ONE TELEPHONE = ONE ROW
    # --------------------------------------------------------

    for phone in phones:

        output_row = base_data + [phone]

        ws_out.append(output_row)

        output_rows += 1
        telephone_count += 1


# ============================================================
# 9. SAVE
# ============================================================

wb_out.save(OUTPUT_FILE)

wb_in.close()


# ============================================================
# 10. FINAL RESULT
# ============================================================

print()
print("=" * 70)
print("DONE")
print("=" * 70)

print(f"Input file       : {INPUT_FILE}")
print(f"Output file      : {OUTPUT_FILE}")
print(f"TELEPHONE count  : {telephone_count:,}")
print(f"Output rows      : {output_rows:,}")

print("=" * 70)
