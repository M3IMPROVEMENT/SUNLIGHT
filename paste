import pandas as pd
import re
from pathlib import Path

# ============================================================
# SETTINGS
# ============================================================

INPUT_FILE = r"C:\Users\YourName\Desktop\input.xlsx"
OUTPUT_FILE = r"C:\Users\YourName\Desktop\tele_clean_deduplicated.xlsx"

TELE_COLUMN = "TELE"


# ============================================================
# CLEAN TELEPHONE
# ============================================================

def clean_tele(value):
    """
    Normalize Belgian telephone numbers.

    Examples:
        +32 476 12 34 56  -> 476123456
        0032 476 12 34 56 -> 476123456
        32 476 12 34 56   -> 476123456
        0476 12 34 56     -> 476123456
        0476123456        -> 476123456

    Returns:
        cleaned number as string
    """

    if pd.isna(value):
        return ""

    # Convert to string
    value = str(value).strip()

    # Remove Excel decimal suffix, e.g. 476123456.0
    value = re.sub(r"\.0+$", "", value)

    # Keep digits only
    value = re.sub(r"\D", "", value)

    if not value:
        return ""

    # --------------------------------------------------------
    # Remove Belgian international prefixes
    # --------------------------------------------------------

    # 0032XXXXXXXXX
    if value.startswith("0032"):
        value = value[4:]

    # 32XXXXXXXXX
    elif value.startswith("32"):
        value = value[2:]

    # Belgian national format:
    # 04XXXXXXXX -> 4XXXXXXXX
    elif value.startswith("0"):
        value = value[1:]

    # --------------------------------------------------------
    # Final normalization
    # --------------------------------------------------------

    return value


# ============================================================
# READ FILE
# ============================================================

print("Reading file...")

df = pd.read_excel(INPUT_FILE, dtype={TELE_COLUMN: str})

print(f"Rows before cleaning: {len(df):,}")


# ============================================================
# CHECK TELE COLUMN
# ============================================================

if TELE_COLUMN not in df.columns:
    raise ValueError(
        f"Column '{TELE_COLUMN}' was not found.\n"
        f"Available columns: {list(df.columns)}"
    )


# ============================================================
# CLEAN TELE
# ============================================================

df[TELE_COLUMN] = df[TELE_COLUMN].apply(clean_tele)

print("TELE column cleaned.")


# ============================================================
# REMOVE EMPTY TELE
# ============================================================

before_empty = len(df)

df = df[df[TELE_COLUMN] != ""].copy()

removed_empty = before_empty - len(df)

print(f"Empty TELE rows removed: {removed_empty:,}")


# ============================================================
# REMOVE DUPLICATES
# ============================================================

before_duplicates = len(df)

df = df.drop_duplicates(
    subset=[TELE_COLUMN],
    keep="first"
).copy()

duplicates_removed = before_duplicates - len(df)

print(f"Duplicates removed: {duplicates_removed:,}")


# ============================================================
# RESET INDEX
# ============================================================

df.reset_index(drop=True, inplace=True)


# ============================================================
# SAVE
# ============================================================

df.to_excel(
    OUTPUT_FILE,
    index=False,
    engine="openpyxl"
)


# ============================================================
# SUMMARY
# ============================================================

print("\n" + "=" * 50)
print("DONE")
print("=" * 50)

print(f"Rows before cleaning : {before_empty:,}")
print(f"Empty TELE removed   : {removed_empty:,}")
print(f"Duplicates removed   : {duplicates_removed:,}")
print(f"Final rows           : {len(df):,}")

print(f"\nOutput:")
print(OUTPUT_FILE)
