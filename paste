import pandas as pd
import re

# =========================
# SETTINGS
# =========================
input_file = r"C:\Users\YourName\Desktop\input.xlsx"
output_file = r"C:\Users\YourName\Desktop\TELE_cleaned_deduplicated.xlsx"

# =========================
# READ FILE
# =========================
df = pd.read_excel(input_file, dtype=str)

print(f"Rows before cleaning: {len(df)}")

# Make sure TELE exists
if "TELE" not in df.columns:
    raise ValueError("Column 'TELE' was not found in the file.")


# =========================
# CLEAN TELE
# =========================
def clean_tele(value):

    # Keep empty cells empty
    if pd.isna(value):
        return ""

    value = str(value).strip()

    if value == "":
        return ""

    # Remove Excel decimal ending
    # Example: 0470123456.0 -> 0470123456
    value = re.sub(r"\.0$", "", value)

    # Convert common separators to space
    value = re.sub(r"[/|;,]+", " ", value)

    # Remove brackets, parentheses, dots, hyphens, etc.
    value = re.sub(r"[\(\)\[\]\{\}\-\.]", "", value)

    # Keep + only if it is at the beginning
    if value.startswith("+"):
        value = "+" + re.sub(r"\D", "", value[1:])
    else:
        value = re.sub(r"\D", "", value)

    return value.strip()


df["TELE"] = df["TELE"].apply(clean_tele)


# =========================
# CREATE NORMALIZED VERSION
# FOR DUPLICATION CHECK
# =========================
def normalize_tele(value):

    if not value:
        return ""

    value = str(value).strip()

    # +32xxxxxxxxx -> 32xxxxxxxxx
    if value.startswith("+"):
        value = value[1:]

    # 0032xxxxxxxxx -> 32xxxxxxxxx
    if value.startswith("0032"):
        value = value[2:]

    # 0xxxxxxxxx -> 32xxxxxxxxx for Belgian numbers
    if value.startswith("0"):
        value = "32" + value[1:]

    return value


df["_TELE_NORMALIZED"] = df["TELE"].apply(normalize_tele)


# =========================
# DEDUPLICATION
# =========================

before_dedup = len(df)

# Do NOT remove empty TELE rows
# Only deduplicate actual phone numbers
non_empty = df["_TELE_NORMALIZED"] != ""

# Keep first occurrence of each TELE
duplicates_mask = (
    non_empty &
    df["_TELE_NORMALIZED"].duplicated(keep="first")
)

duplicates_removed = duplicates_mask.sum()

df = df[~duplicates_mask].copy()


# =========================
# REMOVE TEMP COLUMN
# =========================
df.drop(columns=["_TELE_NORMALIZED"], inplace=True)


# =========================
# EXPORT
# =========================
df.to_excel(output_file, index=False)

print("--------------------------------")
print("DONE")
print("--------------------------------")
print(f"Rows before cleaning : {before_dedup}")
print(f"Duplicates removed  : {duplicates_removed}")
print(f"Rows after          : {len(df)}")
print(f"Output file         : {output_file}")
