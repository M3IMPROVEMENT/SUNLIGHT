# ============================================================
# 3. HELPER FUNCTIONS
# ============================================================

def normalize_kbo(value):
    """
    0200.065.765 -> 0200065765
    0200065765   -> 0200065765
    """

    if not value:
        return ""

    return re.sub(r"\D", "", str(value))


def clean_text(value):

    if value is None:
        return ""

    return str(value).strip()


def read_csv_rows(filename):

    with open(
        filename,
        "r",
        encoding="utf-8-sig",
        newline="",
        errors="replace"
    ) as f:

        reader = csv.DictReader(
            f,
            delimiter=",",
            quotechar='"'
        )

        for row in reader:
            yield row


# ============================================================
# 4. CP EXTRACTION
# ============================================================

def extract_cp(*values):
    """
    Try to find a Belgian postal code.

    Examples:
        1000
        2000
        "Rue Example 12, 1000 Bruxelles"
        "1000 Bruxelles"

    Returns exactly 4 digits when found.
    """

    for value in values:

        if not value:
            continue

        text = clean_text(value)

        # Direct 4 digit CP
        match = re.search(r"(?<!\d)(\d{4})(?!\d)", text)

        if match:
            return match.group(1)

    return ""


# ============================================================
# 5. GSM DETECTION
# ============================================================

def is_gsm(phone):

    if not phone:
        return False

    # Keep only numbers and +
    x = re.sub(r"[^0-9+]", "", str(phone))

    # 0032 -> +32
    if x.startswith("0032"):
        x = "+32" + x[4:]

    # --------------------------------------------------------
    # INTERNATIONAL BELGIAN GSM
    #
    # +3246...
    # +3247...
    # +3248...
    # +3249...
    # --------------------------------------------------------

    if x.startswith("+324"):

        if len(x) >= 5 and x[4] in "6789":
            return True

    # --------------------------------------------------------
    # INTERNATIONAL WITHOUT +
    #
    # 3246...
    # 3247...
    # 3248...
    # 3249...
    # --------------------------------------------------------

    if x.startswith("324"):

        if len(x) >= 4 and x[3] in "6789":
            return True

    # --------------------------------------------------------
    # LOCAL BELGIAN GSM
    #
    # 046...
    # 047...
    # 048...
    # 049...
    # --------------------------------------------------------

    if re.match(r"^04[6-9]", x):
        return True

    return False


