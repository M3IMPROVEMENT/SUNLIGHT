from pathlib import Path
from openpyxl import load_workbook
import csv
from datetime import datetime

# ============================================================
# STEP 1
# MERGE EXCEL FILES TWO BY TWO
# ============================================================

# 👇 CHANGE THIS TO YOUR FOLDER
INPUT_FOLDER = Path(r"C:\YOUR_FOLDER_HERE")

# ============================================================
# COLUMNS TO KEEP
# ============================================================

KEEP_COLUMNS = [
    "STE",
    "TVA",
    "NOM",
    "ADRESSE",
    "NUMERO",
    "COMPLEMENT",
    "CP",
    "VILLE",
    "GSM",
    "TEL1",
    "TEL2",
    "TEL3"
]

# ============================================================
# FIND EXCEL FILES
# ============================================================

files = sorted([
    f for f in INPUT_FOLDER.iterdir()
    if f.is_file()
    and f.suffix.lower() in [".xlsx", ".xlsm"]
    and not f.name.startswith("~$")
])

print("=" * 70)
print("MERGE EXCEL FILES TWO BY TWO")
print("=" * 70)

print(f"Files found: {len(files)}")

if not files:
    raise Exception("No Excel files found.")

# ============================================================
# OUTPUT FOLDER
# ============================================================

timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")

OUTPUT_FOLDER = INPUT_FOLDER / f"MASTER_OUTPUT_{timestamp}"

OUTPUT_FOLDER.mkdir(exist_ok=True)

# ============================================================
# PROCESS TWO FILES AT A TIME
# ============================================================

total_rows = 0
total_output_files = 0
errors = []

for i in range(0, len(files), 2):

    file1 = files[i]

    # Second file in the pair, if it exists
    file2 = files[i + 1] if i + 1 < len(files) else None

    pair_number = (i // 2) + 1

    output_path = (
        OUTPUT_FOLDER /
        f"MASTER_{pair_number:03d}.csv"
    )

    print("\n" + "=" * 70)
    print(f"PAIR {pair_number}")
    print("=" * 70)

    print(f"File 1: {file1.name}")

    if file2:
        print(f"File 2: {file2.name}")
    else:
        print("File 2: NONE")

    try:

        # ----------------------------------------------------
        # CREATE OUTPUT CSV
        # ----------------------------------------------------

        with open(
            output_path,
            "w",
            newline="",
            encoding="utf-8-sig"
        ) as output:

            writer = csv.writer(output)

            # Header
            writer.writerow(
                KEEP_COLUMNS + ["SOURCE"]
            )

            # ------------------------------------------------
            # PROCESS THE TWO FILES
            # ------------------------------------------------

            pair_rows = 0

            for file_path in [file1, file2]:

                if file_path is None:
                    continue

                print(
                    f"\nReading: {file_path.name}"
                )

                # Read-only mode = lower RAM usage
                wb = load_workbook(
                    filename=file_path,
                    read_only=True,
                    data_only=False
                )

                ws = wb[wb.sheetnames[0]]

                rows = ws.iter_rows(
                    values_only=True
                )

                # Read header
                original_header = next(rows)

                # ------------------------------------------------
                # HEADER MAP
                # ------------------------------------------------

                header_map = {}

                for index, column in enumerate(
                    original_header
                ):

                    if column is not None:

                        name = (
                            str(column)
                            .strip()
                            .upper()
                        )

                        header_map[name] = index

                # ------------------------------------------------
                # CHECK COLUMNS
                # ------------------------------------------------

                missing = [
                    col
                    for col in KEEP_COLUMNS
                    if col.upper() not in header_map
                ]

                if missing:

                    print(
                        f"WARNING - Missing columns: "
                        f"{missing}"
                    )

                # ------------------------------------------------
                # WRITE EVERY ROW
                # ------------------------------------------------

                file_rows = 0

                for row in rows:

                    output_row = []

                    for column in KEEP_COLUMNS:

                        index = header_map.get(
                            column.upper()
                        )

                        if (
                            index is not None
                            and index < len(row)
                        ):

                            value = row[index]

                        else:

                            value = ""

                        output_row.append(value)

                    # SOURCE LAST
                    output_row.append(
                        file_path.name
                    )

                    writer.writerow(
                        output_row
                    )

                    file_rows += 1
                    pair_rows += 1
                    total_rows += 1

                wb.close()

                print(
                    f"✓ {file_rows:,} rows written"
                )

            print(
                f"\n✓ MASTER_{pair_number:03d}.csv "
                f"= {pair_rows:,} rows"
            )

        total_output_files += 1

    except Exception as error:

        errors.append(
            f"PAIR {pair_number}: {error}"
        )

        print(
            f"❌ ERROR: {error}"
        )

# ============================================================
# FINAL REPORT
# ============================================================

print("\n")
print("=" * 70)
print("FINISHED")
print("=" * 70)

print(
    f"Excel files found   : {len(files):,}"
)

print(
    f"Master files created: {total_output_files:,}"
)

print(
    f"Total rows          : {total_rows:,}"
)

print(
    f"Errors              : {len(errors):,}"
)

print(
    f"\nOutput folder:\n{OUTPUT_FOLDER}"
)

if errors:

    print("\nERRORS:")

    for error in errors:
        print(" -", error)

else:

    print("\n✓ Everything completed successfully.")

print("\nNothing was:")
print("✓ Deleted")
print("✓ Deduplicated")
print("✓ Cleaned")
print("✓ Filtered")
