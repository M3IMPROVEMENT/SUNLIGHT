import pandas as pd
from pathlib import Path

# ============================================================
# CONFIG
# ============================================================

input_folder = Path(
    r"C:\Users\Sunlight\Desktop\01-10-26\#NET"
)

output_folder = Path(
    r"C:\Users\Sunlight\Desktop\01-10-26\#NET\CLEAN_PHONE\MERGE-TELE"
)

output_folder.mkdir(parents=True, exist_ok=True)

PHONE_COLS = ["GSM", "TEL1", "TEL2", "TEL3"]

# Find Excel files directly inside the input folder
files = [
    f for f in input_folder.glob("*.xlsx")
    if not f.name.startswith("~$")
    and f.parent != output_folder
]

print(f"Files found: {len(files)}")

total_before = 0
total_after = 0
errors = []

# ============================================================
# PROCESS FILES
# ============================================================

for file in files:
    try:
        print(f"\nProcessing: {file.name}")

        # Read data
        df = pd.read_excel(file, dtype=str).fillna("")
        total_before += len(df)

        # Ensure phone columns exist
        for col in PHONE_COLS:
            if col not in df.columns:
                df[col] = ""

        # Identify original rows with no phone numbers
        has_phone = (
            df[PHONE_COLS]
            .apply(lambda col: col.str.strip().ne(""))
            .any(axis=1)
        )

        # Rows with no phone: preserve once with TELE empty
        no_phone = df.loc[~has_phone].copy()
        no_phone["TELE"] = ""

        # Rows with phones: reshape into one row per phone
        with_phone = df.loc[has_phone].copy()
        with_phone["_ROW_ID"] = with_phone.index

        result = with_phone.melt(
            id_vars=["_ROW_ID"],
            value_vars=PHONE_COLS,
            var_name="_PHONE_SOURCE",
            value_name="TELE"
        )

        # Remove empty phone values
        result["TELE"] = result["TELE"].str.strip()
        result = result[result["TELE"].ne("")]

        # Restore the other original columns
        original_columns = [
            col for col in df.columns
            if col not in PHONE_COLS
        ]

        result = result.merge(
            with_phone[["_ROW_ID"] + original_columns],
            on="_ROW_ID",
            how="left",
            sort=False
        )

        # Combine rows with and without phones
        result = pd.concat(
            [result[original_columns + ["TELE"]],
             no_phone[original_columns + ["TELE"]]],
            ignore_index=True
        )

        # Save output
        output_file = output_folder / f"{file.stem}_TELE.xlsx"

        result.to_excel(
            output_file,
            index=False,
            engine="xlsxwriter"
        )

        total_after += len(result)

        print(f"Rows before: {len(df):,}")
        print(f"Rows after:  {len(result):,}")
        print("Saved successfully.")

    except Exception as e:
        errors.append((file.name, str(e)))
        print(f"ERROR: {file.name}: {e}")

# ============================================================
# SUMMARY
# ============================================================

print("\n========== FINISHED ==========")
print(f"Files processed: {len(files) - len(errors)}")
print(f"Files with errors: {len(errors)}")
print(f"Rows before: {total_before:,}")
print(f"Rows after: {total_after:,}")
print(f"Output folder: {output_folder}")

for filename, error in errors:
    print(f"\nFAILED: {filename}\n{error}")
