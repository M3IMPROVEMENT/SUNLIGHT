
from pathlib import Path
from openpyxl import load_workbook, Workbook

# ============================================================
# SETTINGS
# ============================================================

INPUT_FOLDER = Path(r"C:\Users\YourName\Desktop\excel_files")
OUTPUT_FOLDER = Path(r"C:\Users\YourName\Desktop\merged_output")

MAX_DATA_ROWS = 1_000_000

OUTPUT_FOLDER.mkdir(parents=True, exist_ok=True)


# ============================================================
# FIND FILES
# ============================================================

files = sorted([
    f for f in INPUT_FOLDER.glob("*.xlsx")
    if not f.name.startswith("~$")
])

print(f"Found {len(files)} files")


# ============================================================
# GET HEADER FROM FIRST FILE
# ============================================================

wb = load_workbook(
    files[0],
    read_only=True,
    data_only=False
)

ws = wb.worksheets[0]

# IMPORTANT: recalculate dimensions
ws.reset_dimensions()

header = next(ws.iter_rows(values_only=True))

header = list(header)

wb.close()

print("\nHEADER:")
print(header)


# ============================================================
# FUNCTION: CREATE OUTPUT
# ============================================================

def create_output(number):

    path = OUTPUT_FOLDER / f"merged_{number:03d}.xlsx"

    wb = Workbook(write_only=True)
    ws = wb.create_sheet("Sheet1")

    # Header
    ws.append(header)

    print(f"\n📁 Creating {path.name}")

    return wb, ws, path


# ============================================================
# INITIALIZE
# ============================================================

output_number = 1
output_data_rows = 0
total_data_rows = 0

output_wb, output_ws, output_path = create_output(output_number)


# ============================================================
# PROCESS FILES
# ============================================================

for file_number, file in enumerate(files, start=1):

    print(
        f"\n[{file_number}/{len(files)}] {file.name}"
    )

    try:

        wb = load_workbook(
            file,
            read_only=True,
            data_only=False
        )

        ws = wb.worksheets[0]

        # ====================================================
        # VERY IMPORTANT
        # ====================================================
        # Some Excel files have incorrect worksheet dimensions.
        # This forces openpyxl to find the real used range.
        # ====================================================

        ws.reset_dimensions()

        file_rows = 0

        # Start at row 2 -> skip header
        for row in ws.iter_rows(
            min_row=2,
            values_only=True
        ):

            # ------------------------------------------------
            # DO NOT DELETE ANY ROW
            # ------------------------------------------------
            # Even if only STE contains a value,
            # the row is copied.
            # ------------------------------------------------

            if output_data_rows >= MAX_DATA_ROWS:

                output_wb.save(output_path)

                print(
                    f"   ✅ {output_path.name}: "
                    f"{output_data_rows:,} rows"
                )

                output_number += 1
                output_data_rows = 0

                output_wb, output_ws, output_path = (
                    create_output(output_number)
                )

            output_ws.append(list(row))

            output_data_rows += 1
            total_data_rows += 1
            file_rows += 1

        wb.close()

        print(
            f"   Rows copied: {file_rows:,}"
        )

    except Exception as e:

        print(f"❌ ERROR in {file.name}")
        print(e)


# ============================================================
# SAVE LAST FILE
# ============================================================

output_wb.save(output_path)

print(
    f"\n✅ {output_path.name}: "
    f"{output_data_rows:,} rows"
)


# ============================================================
# FINAL RESULT
# ============================================================

print("\n" + "=" * 60)
print("MERGE FINISHED")
print("=" * 60)

print(f"Input files       : {len(files):,}")
print(f"Output files      : {output_number:,}")
print(f"Total data rows   : {total_data_rows:,}")
print(f"Expected manually : 88,233")
print(f"Difference        : {88_233 - total_data_rows:,}")

print("=" * 60)
