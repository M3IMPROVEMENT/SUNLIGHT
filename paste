import csv, re, random, time
from urllib.parse import urljoin
from playwright.sync_api import sync_playwright

BASE = "https://be.kompass.com"
MAX_PAGES = 5             # how many result pages to scrape (raise it when it works)
GET_DETAILS = False       # start with False, switch to True once it works
OUT = "kompass_belgium.csv"

COMPANY_RE = re.compile(r"/c/[^/]+/[^/]+/?$")

NEXT_SELECTORS = [
    "a[rel='next']",
    "li.next a", "a.next", "a.pagination-next", "button.next",
    "a[aria-label*='suivant' i]", "button[aria-label*='suivant' i]",
    "a[aria-label*='next' i]", "button[aria-label*='next' i]",
    "a:has-text('Suivant')", "button:has-text('Suivant')",
    "a:has-text('Next')", "button:has-text('Next')",
    "a:has-text('›')", "a:has-text('»')",
]

def pause(a=2.5, b=6):
    time.sleep(random.uniform(a, b))

def active_page(ctx):
    pages = [pg for pg in ctx.pages if not pg.is_closed()]
    return pages[-1]

def settle(page):
    try:
        page.wait_for_load_state("domcontentloaded", timeout=20000)
    except Exception:
        pass
    page.wait_for_timeout(2500)

def collect_company_links(ctx, tries=4):
    for attempt in range(tries):
        page = active_page(ctx)
        settle(page)
        try:
            links = {}
            anchors = page.eval_on_selector_all(
                "a[href*='/c/']",
                "els => els.map(e => [e.getAttribute('href'), e.innerText])"
            )
            for href, text in anchors:
                full = urljoin(page.url, (href or "").split("?")[0])
                if COMPANY_RE.search(full):
                    name = (text or "").strip()
                    if full not in links or (name and not links[full]):
                        links[full] = name
            return links
        except Exception:
            print(f"  page was navigating, retry {attempt + 1}/{tries}...")
            time.sleep(3)
    return {}

def is_disabled(el):
    try:
        cls = (el.get_attribute("class") or "").lower()
        parent_cls = (el.evaluate("e => e.parentElement ? e.parentElement.className : ''") or "").lower()
        aria = (el.get_attribute("aria-disabled") or "").lower()
        return "disabled" in cls or "disabled" in parent_cls or aria == "true" or el.is_disabled()
    except Exception:
        return False

def find_next(page, current_no):
    # 1) classic "next" buttons
    for sel in NEXT_SELECTORS:
        try:
            for el in page.query_selector_all(sel):
                if el.is_visible() and not is_disabled(el):
                    return el
        except Exception:
            continue
    # 2) numbered pagination: click the link whose text is current_no + 1
    target = str(current_no + 1)
    for container in ["nav[aria-label*='pagination' i]", "ul.pagination",
                      ".pagination", "[class*='paginat']"]:
        try:
            for el in page.query_selector_all(f"{container} a, {container} button"):
                if el.is_visible() and (el.inner_text() or "").strip() == target:
                    return el
        except Exception:
            continue
    return None

def go_next(ctx, current_no, before_links):
    page = active_page(ctx)
    btn = find_next(page, current_no)
    if not btn:
        return False
    try:
        btn.scroll_into_view_if_needed()
        page.wait_for_timeout(random.randint(500, 1500))
        btn.click()
    except Exception as e:
        print("  click failed:", str(e).splitlines()[0])
        return False
    # wait until the list of companies actually changes (up to ~40 s)
    for _ in range(20):
        time.sleep(2)
        try:
            now = set(collect_company_links(ctx, tries=1).keys())
        except Exception:
            continue
        if now and now != set(before_links):
            return True
    return False

def safe_goto(page, url):
    try:
        page.goto(url, wait_until="domcontentloaded", timeout=45000)
    except Exception as e:
        print("  navigation note:", str(e).splitlines()[0])
        page.wait_for_timeout(4000)

def get_details(page, url):
    safe_goto(page, url)
    page.wait_for_timeout(random.randint(1500, 3500))
    d = {"phone": "", "website": "", "address": ""}
    tel = page.query_selector("a[href^='tel:']")
    if tel:
        d["phone"] = tel.get_attribute("href").replace("tel:", "").strip()
    for a in page.query_selector_all("a[target='_blank'][href^='http']"):
        h = a.get_attribute("href") or ""
        if "kompass.com" not in h and "b2bstars" not in h:
            d["website"] = h
            break
    addr = page.query_selector("[itemprop='address'], address")
    if addr:
        d["address"] = " ".join(addr.inner_text().split())
    return d

def save(rows):
    with open(OUT, "w", newline="", encoding="utf-8-sig") as f:
        w = csv.DictWriter(f, fieldnames=["name", "url", "phone", "website", "address"])
        w.writeheader()
        w.writerows(rows)

def main():
    results = {}
    with sync_playwright() as p:
        ctx = p.chromium.launch_persistent_context(
            user_data_dir="./chrome_profile",
            channel="chrome",
            headless=False,
            locale="fr-BE",
            viewport={"width": 1366, "height": 850},
            args=["--disable-blink-features=AutomationControlled"],
            # proxy={"server": "http://host:port", "username": "...", "password": "..."},
        )
        ctx.add_init_script(
            "Object.defineProperty(navigator, 'webdriver', {get: () => undefined})"
        )
        page = ctx.pages[0] if ctx.pages else ctx.new_page()

        safe_goto(page, BASE + "/fr")
        print("\n1) In Chrome: accept cookies, solve any check.")
        print("2) Search for companies yourself (keyword, Belgium, etc.)")
        print("3) Leave the FIRST results page open and fully loaded.\n")
        input("Press Enter here when ready...")

        page_no = 1
        while page_no <= MAX_PAGES:
            found = collect_company_links(ctx)
            new = {u: n for u, n in found.items() if u not in results}
            results.update(new)
            print(f"[Page {page_no}] {len(found)} links, {len(new)} new, total {len(results)}")
            save([{"name": n, "url": u, "phone": "", "website": "", "address": ""}
                  for u, n in results.items()])

            if not found:
                pg = active_page(ctx)
                with open("debug_page.html", "w", encoding="utf-8") as f:
                    f.write(pg.content())
                print("  No company links. Saved debug_page.html, URL:", pg.url)
                break
            if page_no >= MAX_PAGES:
                break

            if go_next(ctx, page_no, found.keys()):
                page_no += 1
                pause()
            else:
                print("  Could not find/click the next button automatically.")
                cmd = input("  Click NEXT yourself in Chrome, then press Enter "
                            "(or type q + Enter to finish): ").strip().lower()
                if cmd == "q":
                    break
                page_no += 1

        rows = []
        work_page = active_page(ctx)
        for i, (url, name) in enumerate(results.items(), 1):
            row = {"name": name, "url": url, "phone": "", "website": "", "address": ""}
            if GET_DETAILS:
                try:
                    row.update(get_details(work_page, url))
                except Exception as e:
                    print("  error on", url, e)
                print(f"  [{i}/{len(results)}] {name}")
                pause()
            rows.append(row)
            save(rows)

        ctx.close()
    print("Saved", len(rows), "rows to", OUT)

if __name__ == "__main__":
    main()
