import pandas as pd
from pathlib import Path
import sys

# ============================================================
# SETTINGS
# ============================================================

INPUT_FOLDER = Path(
    r"C:\Users\Sunlight\Desktop\01-10-26\ALL DB\excel_data-PC3"
)

OUTPUT_FOLDER = Path(
    r"C:\Users\Sunlight\Desktop\01-10-26\ALL DB\excel_data-PC3\GSM\MERGE-FILES\merged_output"
)

# Maximum DATA rows per Excel output file
MAX_ROWS = 1_000_000

OUTPUT_FOLDER.mkdir(parents=True, exist_ok=True)


# ============================================================
# FIND INPUT FILES
# ============================================================

files = sorted(
    [
        f for f in INPUT_FOLDER.glob("*.xlsx")
        if not f.name.startswith("~$")
        and OUTPUT_FOLDER not in f.parents
    ]
)

print("=" * 70)
print("MERGE EXCEL FILES")
print("=" * 70)

print(f"Input folder : {INPUT_FOLDER}")
print(f"Found files  : {len(files):,}")
print()


if not files:
    raise SystemExit("❌ No Excel files found.")


# ============================================================
# WRITER
# ============================================================

def create_writer(number):

    output_path = OUTPUT_FOLDER / f"merged_{number:03d}.xlsx"

    writer = pd.ExcelWriter(
        output_path,
        engine="xlsxwriter",
        engine_kwargs={
            "options": {
                "strings_to_urls": False,
                "strings_to_formulas": False,
            }
        }
    )

    print(f"\n📁 Creating: {output_path.name}")

    return writer, output_path


# ============================================================
# VARIABLES
# ============================================================

output_number = 1

current_rows = 0
total_rows = 0

processed_files = 0
failed_files = []

writer, output_path = create_writer(output_number)


# ============================================================
# PROCESS FILES
# ============================================================

for i, file in enumerate(files, start=1):

    print("=" * 70)
    print(f"[{i}/{len(files)}] {file.name}")

    try:

        # ----------------------------------------------------
        # READ EXCEL
        # ----------------------------------------------------

        df = pd.read_excel(
            file,
            sheet_name=0,
            dtype=object
        )

        rows = len(df)
        columns = len(df.columns)

        print(f"Rows    : {rows:,}")
        print(f"Columns : {columns:,}")

        # Empty file
        if rows == 0:
            print("⚠️ Empty file - nothing to write.")
            processed_files += 1
            continue


        # ----------------------------------------------------
        # CHECK IF OUTPUT WOULD EXCEED LIMIT
        # ----------------------------------------------------

        if current_rows > 0 and current_rows + rows > MAX_ROWS:

            writer.close()

            print(
                f"✅ Closed {output_path.name} "
                f"with {current_rows:,} data rows."
            )

            output_number += 1
            current_rows = 0

            writer, output_path = create_writer(output_number)


        # ----------------------------------------------------
        # WRITE
        # ----------------------------------------------------

        df.to_excel(
            writer,
            sheet_name="Sheet1",
            startrow=current_rows + 1,
            index=False,
            header=(current_rows == 0)
        )

        current_rows += rows
        total_rows += rows
        processed_files += 1

        print(
            f"✅ Added {rows:,} rows "
            f"| Current output: {current_rows:,}"
        )


    except Exception as e:

        print()
        print("❌❌❌ ERROR ❌❌❌")
        print(f"File: {file.name}")
        print(f"Error: {repr(e)}")
        print()

        failed_files.append((file.name, str(e)))

        # IMPORTANT:
        # Do NOT silently continue without recording the file.
        continue


# ============================================================
# CLOSE LAST OUTPUT
# ============================================================

writer.close()

print()
print(
    f"✅ Finished {output_path.name} "
    f"({current_rows:,} data rows)"
)


# ============================================================
# FINAL SUMMARY
# ============================================================

print()
print("=" * 70)
print("MERGE FINISHED")
print("=" * 70)

print(f"Input files found       : {len(files):,}")
print(f"Files processed         : {processed_files:,}")
print(f"Files failed            : {len(failed_files):,}")
print(f"Output files created    : {output_number:,}")
print(f"Total data rows merged  : {total_rows:,}")
print(f"Output folder           : {OUTPUT_FOLDER}")

# ============================================================
# FAILED FILES
# ============================================================

if failed_files:

    print()
    print("=" * 70)
    print("⚠️ FILES THAT WERE NOT MERGED")
    print("=" * 70)

    for filename, error in failed_files:
        print(f"\n❌ {filename}")
        print(f"   {error}")

    # Save a report so NOTHING gets forgotten
    report_path = OUTPUT_FOLDER / "FAILED_FILES.txt"

    with open(report_path, "w", encoding="utf-8") as f:

        f.write("FILES THAT WERE NOT MERGED\n")
        f.write("=" * 70 + "\n\n")

        for filename, error in failed_files:

            f.write(f"FILE: {filename}\n")
            f.write(f"ERROR: {error}\n")
            f.write("-" * 70 + "\n")

    print()
    print(f"⚠️ Failed-file report: {report_path}")

else:

    print()
    print("🎉 ALL FILES WERE MERGED SUCCESSFULLY.")


print("=" * 70)
