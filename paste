from pathlib import Path
from openpyxl import load_workbook, Workbook

# ============================================================
# SETTINGS
# ============================================================

INPUT_FOLDER = Path(r"C:\Users\YourName\Desktop\excel_files")
OUTPUT_FOLDER = Path(r"C:\Users\YourName\Desktop\merged_output")

# Maximum data rows per output file
MAX_ROWS = 1_000_000

OUTPUT_FOLDER.mkdir(parents=True, exist_ok=True)


# ============================================================
# FIND ALL EXCEL FILES
# ============================================================

files = sorted(
    f for f in INPUT_FOLDER.glob("*.xlsx")
    if not f.name.startswith("~$")
)

print(f"Found {len(files)} files")


# ============================================================
# VARIABLES
# ============================================================

output_number = 1
output_rows = 0
total_rows = 0


# ============================================================
# CREATE FIRST OUTPUT
# ============================================================

output_path = OUTPUT_FOLDER / f"merged_{output_number:03d}.xlsx"

output_wb = Workbook(write_only=True)
output_ws = output_wb.create_sheet("Sheet1")


# ============================================================
# MERGE
# ============================================================

for i, file in enumerate(files, start=1):

    print(f"[{i}/{len(files)}] {file.name}")

    try:

        wb = load_workbook(
            file,
            read_only=True,
            data_only=False
        )

        ws = wb.worksheets[0]

        rows_in_file = 0

        # ====================================================
        # COPY EVERYTHING
        # INCLUDING HEADER
        # ====================================================

        for row in ws.iter_rows(values_only=True):

            # ------------------------------------------------
            # If output reaches limit, create another file
            # ------------------------------------------------

            if output_rows >= MAX_ROWS:

                output_wb.save(output_path)

                print(
                    f"   Saved: {output_path.name} "
                    f"({output_rows:,} rows)"
                )

                output_number += 1
                output_rows = 0

                output_path = (
                    OUTPUT_FOLDER /
                    f"merged_{output_number:03d}.xlsx"
                )

                output_wb = Workbook(write_only=True)
                output_ws = output_wb.create_sheet("Sheet1")

            # ------------------------------------------------
            # COPY ROW EXACTLY
            # ------------------------------------------------

            output_ws.append(list(row))

            output_rows += 1
            total_rows += 1
            rows_in_file += 1

        wb.close()

        print(
            f"   Copied: {rows_in_file:,} rows"
        )

    except Exception as e:

        print(
            f"   ❌ ERROR: {file.name}"
        )

        print(e)


# ============================================================
# SAVE LAST OUTPUT
# ============================================================

output_wb.save(output_path)

print()
print("=" * 60)
print("MERGE FINISHED")
print("=" * 60)

print(f"Files processed : {len(files):,}")
print(f"Output files    : {output_number:,}")
print(f"Total rows      : {total_rows:,}")
print(f"Output folder   : {OUTPUT_FOLDER}")

print("=" * 60)
