from pathlib import Path
from openpyxl import load_workbook, Workbook
import csv

# ============================================================
# SETTINGS
# ============================================================

INPUT_FOLDER = Path(r"C:\Users\YourName\Desktop\excel_files")
OUTPUT_FOLDER = Path(r"C:\Users\YourName\Desktop\merged_output")

MAX_DATA_ROWS = 1_000_000

OUTPUT_FOLDER.mkdir(parents=True, exist_ok=True)


# ============================================================
# FIND FILES
# ============================================================

files = sorted([
    f for f in INPUT_FOLDER.glob("*.xlsx")
    if not f.name.startswith("~$")
])

print("=" * 70)
print(f"FOUND {len(files)} EXCEL FILES")
print("=" * 70)


if not files:
    raise Exception("No Excel files found.")


# ============================================================
# EXPECTED HEADER
# ============================================================

EXPECTED_HEADER = [
    "name",
    "address",
    "postal_code",
    "phone",
    "website",
    "review",
    "total_review",
    "url"
]


# ============================================================
# READ HEADER FROM FIRST FILE
# ============================================================

wb = load_workbook(
    files[0],
    read_only=True,
    data_only=False
)

ws = wb.worksheets[0]

header = list(
    next(
        ws.iter_rows(
            min_row=1,
            max_row=1,
            values_only=True
        )
    )
)

wb.close()


print("\nHEADER FOUND:")
print(header)

print("\nEXPECTED HEADER:")
print(EXPECTED_HEADER)


# ============================================================
# HEADER CHECK
# ============================================================

if header != EXPECTED_HEADER:

    print("\n⚠️ WARNING: HEADER IS DIFFERENT!")

    print("Found:")
    print(header)

    print("Expected:")
    print(EXPECTED_HEADER)

else:

    print("\n✅ Header is correct.")


# ============================================================
# CREATE OUTPUT
# ============================================================

def create_output(number):

    path = OUTPUT_FOLDER / f"merged_{number:03d}.xlsx"

    wb = Workbook(write_only=True)
    ws = wb.create_sheet("Sheet1")

    # Write header
    ws.append(header)

    print("\n" + "-" * 70)
    print(f"CREATING {path.name}")
    print("-" * 70)

    return wb, ws, path


# ============================================================
# INITIALIZE
# ============================================================

output_number = 1

output_data_rows = 0
total_data_rows = 0

output_wb, output_ws, output_path = create_output(
    output_number
)


# ============================================================
# DIAGNOSTIC LOG
# ============================================================

log = []


# ============================================================
# PROCESS FILES
# ============================================================

for file_number, file in enumerate(files, start=1):

    print("\n")
    print("=" * 70)
    print(f"[{file_number}/{len(files)}] {file.name}")
    print("=" * 70)

    file_rows_copied = 0

    try:

        # ----------------------------------------------------
        # OPEN FILE
        # ----------------------------------------------------

        wb = load_workbook(
            file,
            read_only=True,
            data_only=False
        )

        ws = wb.worksheets[0]

        # ----------------------------------------------------
        # GET EXCEL DIMENSIONS
        # ----------------------------------------------------

        max_row = ws.max_row
        max_column = ws.max_column

        expected_data_rows = max(
            0,
            max_row - 1
        )

        print(
            f"Excel reports:"
        )

        print(
            f"   Rows    : {max_row:,}"
        )

        print(
            f"   Columns : {max_column}"
        )

        print(
            f"Expected data rows: "
            f"{expected_data_rows:,}"
        )


        # ----------------------------------------------------
        # CHECK HEADER OF THIS FILE
        # ----------------------------------------------------

        current_header = list(
            next(
                ws.iter_rows(
                    min_row=1,
                    max_row=1,
                    values_only=True
                )
            )
        )

        if current_header != header:

            print(
                "\n⚠️ HEADER DIFFERENT!"
            )

            print(
                "This file:"
            )

            print(
                current_header
            )


        # ----------------------------------------------------
        # READ DATA
        # ----------------------------------------------------

        for row in ws.iter_rows(
            min_row=2,
            max_row=max_row,
            values_only=True
        ):

            # =================================================
            # IMPORTANT:
            # DO NOT FILTER ANY ROW
            # =================================================

            row = list(row)


            # -------------------------------------------------
            # Keep exactly 8 columns
            # -------------------------------------------------

            if len(row) < len(header):

                row += [None] * (
                    len(header) - len(row)
                )

            elif len(row) > len(header):

                row = row[:len(header)]


            # -------------------------------------------------
            # CREATE NEW OUTPUT WHEN LIMIT REACHED
            # -------------------------------------------------

            if output_data_rows >= MAX_DATA_ROWS:

                output_wb.save(output_path)

                print(
                    f"\n💾 Saved {output_path.name}"
                )

                print(
                    f"   Rows: "
                    f"{output_data_rows:,}"
                )

                output_number += 1

                output_data_rows = 0

                output_wb, output_ws, output_path = (
                    create_output(output_number)
                )


            # -------------------------------------------------
            # COPY ROW
            # -------------------------------------------------

            output_ws.append(row)

            output_data_rows += 1

            total_data_rows += 1

            file_rows_copied += 1


        # ----------------------------------------------------
        # CLOSE INPUT
        # ----------------------------------------------------

        wb.close()


        # ----------------------------------------------------
        # COMPARE COUNTS
        # ----------------------------------------------------

        difference = (
            file_rows_copied
            -
            expected_data_rows
        )


        print(
            f"\nRESULT:"
        )

        print(
            f"   Expected : "
            f"{expected_data_rows:,}"
        )

        print(
            f"   Copied   : "
            f"{file_rows_copied:,}"
        )

        print(
            f"   Difference: "
            f"{difference:,}"
        )


        # ----------------------------------------------------
        # WARNING IF DIFFERENT
        # ----------------------------------------------------

        if difference != 0:

            print(
                "\n🚨🚨🚨 WARNING 🚨🚨🚨"
            )

            print(
                f"{abs(difference):,} "
                f"rows difference in this file!"
            )


        else:

            print(
                "   ✅ File copied completely"
            )


        # ----------------------------------------------------
        # SAVE LOG
        # ----------------------------------------------------

        log.append({

            "file": file.name,

            "excel_max_row": max_row,

            "expected_data_rows":
                expected_data_rows,

            "copied_rows":
                file_rows_copied,

            "difference":
                difference

        })


    except Exception as e:

        print(
            "\n❌ ERROR!"
        )

        print(
            f"File: {file.name}"
        )

        print(
            f"Error: {e}"
        )


        log.append({

            "file": file.name,

            "excel_max_row": "",

            "expected_data_rows": "",

            "copied_rows": "",

            "difference": "ERROR"

        })


# ============================================================
# SAVE LAST OUTPUT
# ============================================================

output_wb.save(output_path)

print(
    f"\n💾 Saved {output_path.name}"
)

print(
    f"Rows: {output_data_rows:,}"
)


# ============================================================
# SAVE DIAGNOSTIC LOG
# ============================================================

log_path = OUTPUT_FOLDER / "merge_diagnostic.csv"

with open(
    log_path,
    "w",
    newline="",
    encoding="utf-8-sig"
) as f:

    writer = csv.DictWriter(
        f,
        fieldnames=[
            "file",
            "excel_max_row",
            "expected_data_rows",
            "copied_rows",
            "difference"
        ]
    )

    writer.writeheader()

    writer.writerows(log)


# ============================================================
# FINAL TOTALS
# ============================================================

expected_total = sum(
    int(x["expected_data_rows"])
    for x in log
    if str(x["expected_data_rows"]).isdigit()
)

copied_total = sum(
    int(x["copied_rows"])
    for x in log
    if str(x["copied_rows"]).isdigit()
)

total_difference = (
    copied_total - expected_total
)


print("\n")
print("=" * 70)
print("MERGE DIAGNOSTIC FINISHED")
print("=" * 70)

print(
    f"Input files          : {len(files):,}"
)

print(
    f"Expected data rows   : {expected_total:,}"
)

print(
    f"Copied data rows     : {copied_total:,}"
)

print(
    f"Difference           : {total_difference:,}"
)

print()
print(
    f"Diagnostic file:"
)

print(
    log_path
)

print("=" * 70)
