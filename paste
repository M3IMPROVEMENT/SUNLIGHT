from pathlib import Path
from openpyxl import load_workbook, Workbook
from datetime import datetime


# ============================================================
# 1. FOLDER CONTAINING YOUR MASTER FILES
# ============================================================

INPUT_FOLDER = Path(r"C:\YOUR_FOLDER_HERE\MASTER_OUTPUT")


# ============================================================
# 2. OUTPUT FOLDER
# ============================================================

timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
OUTPUT_FOLDER = INPUT_FOLDER / f"TELEPHONE_OUTPUT_{timestamp}"
OUTPUT_FOLDER.mkdir(parents=True, exist_ok=True)


# ============================================================
# 3. COLUMNS WE WANT TO KEEP
# ============================================================

BASE_COLUMNS = [
    "STE",
    "TVA",
    "NOM",
    "ADRESSE",
    "NUMERO",
    "COMPLEMENT",
    "CP",
    "VILLE"
]

PHONE_COLUMNS = [
    "GSM",
    "TEL1",
    "TEL2",
    "TEL3"
]

FINAL_COLUMNS = BASE_COLUMNS + [
    "TELEPHONE",
    "SOURCE"
]


# ============================================================
# 4. FIND MASTER FILES
# ============================================================

master_files = sorted(
    [
        f for f in INPUT_FOLDER.glob("MASTER_*.xlsx")
        if not f.name.startswith("~$")
    ]
)

print(f"\n{len(master_files)} Master files found.\n")


# ============================================================
# 5. PROCESS EACH MASTER SEPARATELY
# ============================================================

for master_file in master_files:

    print("=" * 70)
    print(f"Processing: {master_file.name}")
    print("=" * 70)

    # --------------------------------------------------------
    # OPEN ONE MASTER
    # --------------------------------------------------------

    wb_in = load_workbook(
        master_file,
        read_only=True,
        data_only=False
    )

    ws_in = wb_in.active

    # --------------------------------------------------------
    # READ HEADER
    # --------------------------------------------------------

    header = next(ws_in.iter_rows(values_only=True))

    header_map = {
        str(value).strip().upper(): index
        for index, value in enumerate(header)
        if value is not None
    }

    # --------------------------------------------------------
    # CHECK REQUIRED COLUMNS
    # --------------------------------------------------------

    required_columns = BASE_COLUMNS + PHONE_COLUMNS + ["SOURCE"]

    missing_columns = [
        column
        for column in required_columns
        if column.upper() not in header_map
    ]

    if missing_columns:
        print(f"❌ Missing columns: {missing_columns}")
        wb_in.close()
        continue

    # --------------------------------------------------------
    # CREATE ONE OUTPUT FILE FOR THIS MASTER
    # --------------------------------------------------------

    wb_out = Workbook(write_only=True)
    ws_out = wb_out.create_sheet("DATA")

    # Header
    ws_out.append(FINAL_COLUMNS)

    # --------------------------------------------------------
    # PROCESS ROWS
    # --------------------------------------------------------

    output_rows = 0

    for row in ws_in.iter_rows(
        min_row=2,
        values_only=True
    ):

        # Company information
        base_data = [
            row[header_map[column.upper()]]
            for column in BASE_COLUMNS
        ]

        # SOURCE
        source = row[header_map["SOURCE"]]

        # ----------------------------------------------------
        # GET GSM + TEL1 + TEL2 + TEL3
        # ----------------------------------------------------

        phones = []

        for phone_column in PHONE_COLUMNS:

            value = row[header_map[phone_column.upper()]]

            # Keep the value exactly as it is
            # Only ignore completely empty cells
            if value is not None and value != "":
                phones.append(value)

        # ----------------------------------------------------
        # ONE PHONE = ONE ROW
        # ----------------------------------------------------

        if phones:

            for phone in phones:

                output_row = (
                    base_data
                    + [phone]
                    + [source]
                )

                ws_out.append(output_row)
                output_rows += 1

        # ----------------------------------------------------
        # IF NO PHONE, KEEP THE ORIGINAL ROW
        # ----------------------------------------------------

        else:

            output_row = (
                base_data
                + [""]
                + [source]
            )

            ws_out.append(output_row)
            output_rows += 1

    # --------------------------------------------------------
    # SAVE EXACTLY ONE OUTPUT FOR THIS MASTER
    # --------------------------------------------------------

    output_file = (
        OUTPUT_FOLDER
        / f"{master_file.stem}_TELEPHONE.xlsx"
    )

    wb_out.save(output_file)
    wb_in.close()

    print(f"✅ Finished: {master_file.name}")
    print(f"   Output rows: {output_rows:,}")
    print(f"   Output file: {output_file.name}")
    print()


# ============================================================
# 6. FINISHED
# ============================================================

print("=" * 70)
print("ALL MASTER FILES FINISHED")
print("=" * 70)

print(f"\nOutput folder:")
print(OUTPUT_FOLDER)
