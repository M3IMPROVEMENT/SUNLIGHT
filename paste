import pandas as pd
import re

# ============================================================
# SETTINGS
# ============================================================

INPUT_FILE = r"C:\Users\YourName\Desktop\input.xlsx"
OUTPUT_FILE = r"C:\Users\YourName\Desktop\output_one_number_per_row.xlsx"

TELE_COLUMN = "TELE"


# ============================================================
# DETECT AND SPLIT MULTIPLE PHONE NUMBERS
# ============================================================

def split_tele(value):

    if pd.isna(value):
        return [""]

    text = str(value).strip()

    if not text:
        return [""]

    # --------------------------------------------------------
    # First, identify Belgian numbers in the cell.
    #
    # This recognizes:
    # +32 476 12 34 56
    # 0032 476 12 34 56
    # 32 476 12 34 56
    # 0476 12 34 56
    #
    # Spaces INSIDE the number are allowed.
    # --------------------------------------------------------

    pattern = re.compile(
        r"""
        (?:
            \+32
            |
            0032
            |
            32
            |
            0
        )
        [\s.\-()]*
        \d
        (?:
            [\s.\-()]*
            \d
        ){7,9}
        """,
        re.VERBOSE
    )

    matches = list(pattern.finditer(text))

    # --------------------------------------------------------
    # If we found 2+ numbers, return them separately.
    # --------------------------------------------------------

    if len(matches) >= 2:

        numbers = []

        for match in matches:
            number = match.group(0).strip()

            if number not in numbers:
                numbers.append(number)

        return numbers

    # --------------------------------------------------------
    # If only one number was found, keep the ORIGINAL value.
    # No cleaning.
    # --------------------------------------------------------

    return [text]


# ============================================================
# READ EXCEL
# ============================================================

df = pd.read_excel(
    INPUT_FILE,
    dtype={TELE_COLUMN: str}
)

print(f"Original rows: {len(df):,}")


# ============================================================
# CHECK COLUMN
# ============================================================

if TELE_COLUMN not in df.columns:
    raise ValueError(
        f"Column '{TELE_COLUMN}' not found."
    )


# ============================================================
# CREATE NEW ROWS
# ============================================================

new_rows = []
split_count = 0

for _, row in df.iterrows():

    numbers = split_tele(row[TELE_COLUMN])

    # One or multiple numbers
    for number in numbers:

        new_row = row.copy()

        # ONLY change TELE
        new_row[TELE_COLUMN] = number

        # Everything else stays exactly the same
        new_rows.append(new_row)

    if len(numbers) > 1:
        split_count += 1


# ============================================================
# CREATE RESULT
# ============================================================

result = pd.DataFrame(
    new_rows,
    columns=df.columns
)


# ============================================================
# SAVE
# ============================================================

result.to_excel(
    OUTPUT_FILE,
    index=False,
    engine="openpyxl"
)


# ============================================================
# SUMMARY
# ============================================================

print()
print("=" * 50)
print("DONE")
print("=" * 50)

print(f"Original rows          : {len(df):,}")
print(f"Rows with 2+ numbers   : {split_count:,}")
print(f"Final rows             : {len(result):,}")

print()
print("No rows deleted.")
print("No deduplication.")
print("No TELE cleaning.")
print("No TYPE column.")
print()
print(f"Output: {OUTPUT_FILE}")
