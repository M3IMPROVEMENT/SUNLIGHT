def get_digits(value):
    """
    Get digits only.
    Used ONLY for analysis.
    """

    if value is None:
        return ""

    text = str(value).strip()

    # Excel numeric value such as 471123456.0
    if text.endswith(".0"):
        text = text[:-2]

    return re.sub(r"\D", "", text)


def is_belgian_number(digits):
    """
    Valid Belgian number structures for our split logic.

    National:
        9 digits  -> 0 + 8 digits
        10 digits -> 0 + 9 digits

    International:
        32 + 9 digits  = 11 digits
        0032 + 9 digits = 13 digits
    """

    if not digits:
        return False

    # 0032 + 9 digits
    if len(digits) == 13 and digits.startswith("0032"):
        return True

    # 32 + 9 digits
    if len(digits) == 11 and digits.startswith("32"):
        return True

    # National Belgian
    if len(digits) == 9 and digits.startswith("0"):
        return True

    if len(digits) == 10 and digits.startswith("0"):
        return True

    return False


def clean_number(digits):
    """
    Clean AFTER splitting.

    Examples:

    +32 471 12 34 56 -> 471123456
    0032 471123456   -> 471123456
    32 471123456     -> 471123456
    0471123456       -> 471123456
    """

    if not digits:
        return ""

    # 0032XXXXXXXXX
    if digits.startswith("0032"):
        digits = digits[4:]

    # 32XXXXXXXXX
    elif digits.startswith("32"):
        digits = digits[2:]

    # National leading zero
    if digits.startswith("0"):
        digits = digits[1:]

    return digits


# ============================================================
# FIND ALL POSSIBLE PHONE PARTITIONS
# ============================================================

def find_partitions(digits):
    """
    Find every possible way of dividing a digit string into
    valid Belgian phone numbers.

    IMPORTANT:
    We never say:
        "every 9 digits = a phone number"

    We test all allowed lengths instead.
    """

    solutions = []

    def search(position, current):

        if len(solutions) > 20:
            return

        if position == len(digits):

            solutions.append(current.copy())
            return

        # Possible Belgian number lengths
        for length in (9, 10, 11, 13):

            end = position + length

            if end > len(digits):
                continue

            part = digits[position:end]

            if is_belgian_number(part):

                current.append(part)

                search(end, current)

                current.pop()

    search(0, [])

    return solutions


# ============================================================
# SPLIT USING EXPLICIT SEPARATORS
# ============================================================

def split_by_separator(text):
    """
    Try separators such as:
        ;
        |
        comma
        slash
        whitespace

    BUT we do not blindly split every slash or space.

    We first remove formatting and then validate the resulting
    complete numbers.
    """

    # --------------------------------------------------------
    # First: semicolon / pipe are strong separators
    # --------------------------------------------------------

    strong_parts = re.split(r"[;|]", text)

    if len(strong_parts) > 1:

        all_numbers = []
        valid = True

        for part in strong_parts:

            d = get_digits(part)

            if not d:
                continue

            if not is_belgian_number(d):
                valid = False
                break

            all_numbers.append(d)

        if valid and len(all_numbers) >= 2:
            return all_numbers

    # --------------------------------------------------------
    # Slash
    #
    # We try it, but only accept it if BOTH sides are valid.
    #
    # 0475/252328
    # -> whole thing = 0475252328
    # -> therefore NOT split
    #
    # 043822774/0478719289
    # -> both sides valid
    # -> split
    # --------------------------------------------------------

    slash_parts = re.split(r"\s*/\s*", text)

    if len(slash_parts) > 1:

        all_numbers = []
        valid = True

        for part in slash_parts:

            d = get_digits(part)

            if not d or not is_belgian_number(d):
                valid = False
                break

            all_numbers.append(d)

        if valid and len(all_numbers) >= 2:
            return all_numbers

    # --------------------------------------------------------
    # Comma
    # --------------------------------------------------------

    comma_parts = re.split(r"\s*,\s*", text)

    if len(comma_parts) > 1:

        all_numbers = []
        valid = True

        for part in comma_parts:

            d = get_digits(part)

            if not d or not is_belgian_number(d):
                valid = False
                break

            all_numbers.append(d)

        if valid and len(all_numbers) >= 2:
            return all_numbers

    # --------------------------------------------------------
    # Whitespace
    #
    # We cannot simply split every space because:
    #
    # 087 33 47 33
    #
    # is ONE number.
    #
    # So we remove spaces first and then test partitions.
    # --------------------------------------------------------

    digits = get_digits(text)

    return None


# ============================================================
# ANALYZE ONE TELE CELL
# ============================================================

def analyze_tele(value):

    if value is None:
        return {
            "status": "EMPTY",
            "numbers": [],
            "reason": ""
        }

    text = str(value).strip()

    if not text:
        return {
            "status": "EMPTY",
            "numbers": [],
            "reason": ""
        }

    digits = get_digits(text)

    if not digits:
        return {
            "status": "AMBIGUOUS",
            "numbers": [],
            "reason": "No valid digits"
        }

    # --------------------------------------------------------
    # 1. Check explicit separators first
    # --------------------------------------------------------

    separated = split_by_separator(text)

    if separated is not None:

        return {
            "status": "SPLIT",
            "numbers": separated,
            "reason": "Clear separator between valid numbers"
        }

    # --------------------------------------------------------
    # 2. Is the entire value ONE valid number?
    #
    # This must happen BEFORE trying to split.
    #
    # Example:
    # 0032478719289 = ONE number
    # 0475252328    = ONE number
    # --------------------------------------------------------

    if is_belgian_number(digits):

        return {
            "status": "ONE",
            "numbers": [digits],
            "reason": ""
        }

    # --------------------------------------------------------
    # 3. Try concatenated numbers
    #
    # Example:
    #
    # 0438227740478719289
    #
    # 9 + 10 = 19 digits
    # --------------------------------------------------------

    partitions = find_partitions(digits)

    # Remove duplicate solutions
    unique_partitions = []

    seen = set()

    for p in partitions:

        key = tuple(p)

        if key not in seen:

            seen.add(key)
            unique_partitions.append(p)

    # --------------------------------------------------------
    # Exactly ONE interpretation
    # --------------------------------------------------------

    if len(unique_partitions) == 1:

        solution = unique_partitions[0]

        if len(solution) >= 2:

            return {
                "status": "SPLIT",
                "numbers": solution,
                "reason": "Unique valid phone-number split"
            }

    # --------------------------------------------------------
    # Multiple possible interpretations
    # --------------------------------------------------------

    if len(unique_partitions) > 1:

        examples = []

        for p in unique_partitions[:5]:

            examples.append(
                " + ".join(p)
            )

        return {
            "status": "AMBIGUOUS",
            "numbers": [],
            "reason":
                "More than one possible split: "
                + " || ".join(examples)
        }

    # --------------------------------------------------------
    # No valid interpretation
    # --------------------------------------------------------

    return {
        "status": "AMBIGUOUS",
        "numbers": [],
        "reason":
            f"Could not safely identify number(s); "
            f"{len(digits)} digits after formatting removal"
    }


