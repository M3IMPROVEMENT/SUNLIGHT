import pandas as pd
from pathlib import Path

# ============================================================
# 1. INPUT FILE
# ============================================================

input_file = Path(r"C:\YOUR_PATH\YOUR_CURRENT_MASTER_FILE.xlsx")

# Output folder
output_dir = input_file.parent / "GSM_DEDUP_SPLIT"
output_dir.mkdir(exist_ok=True)

# ============================================================
# 2. READ FILE
# ============================================================

df = pd.read_excel(input_file, dtype=str)

# Clean column names
df.columns = df.columns.str.strip()

print("Original rows:", len(df))

# ============================================================
# 3. CLEAN GSM
# ============================================================

df["GSM"] = df["GSM"].fillna("").astype(str).str.strip()

# Remove Excel .0 if present
df["GSM"] = df["GSM"].str.replace(r"\.0$", "", regex=True)

# ============================================================
# 4. REMOVE EMPTY GSM
# ============================================================

df = df[df["GSM"] != ""].copy()

print("Rows with GSM:", len(df))

# ============================================================
# 5. REMOVE DUPLICATE GSM
# ============================================================

before = len(df)

df = df.drop_duplicates(
    subset=["GSM"],
    keep="first"
).copy()

after = len(df)

print("Unique GSM rows:", after)
print("Duplicate GSM removed:", before - after)

# ============================================================
# 6. CLEAN TVA
# ============================================================

df["TVA"] = df["TVA"].fillna("").astype(str).str.strip()

# Treat these as empty TVA
df["TVA"] = df["TVA"].replace(
    ["nan", "NaN", "None", "NONE"],
    ""
)

# ============================================================
# 7. SPLIT WITH TVA / WITHOUT TVA
# ============================================================

with_tva = df[df["TVA"] != ""].copy()

without_tva = df[df["TVA"] == ""].copy()

# ============================================================
# 8. SAVE FILES
# ============================================================

with_tva_file = output_dir / "GSM_UNIQUE_WITH_TVA.xlsx"
without_tva_file = output_dir / "GSM_UNIQUE_WITHOUT_TVA.xlsx"

with_tva.to_excel(with_tva_file, index=False)
without_tva.to_excel(without_tva_file, index=False)

# ============================================================
# 9. SUMMARY
# ============================================================

print("\n====================================")
print("FINAL RESULTS")
print("====================================")

print(f"Original rows       : {len(df) + (before - after):,}")
print(f"Unique GSM          : {len(df):,}")
print(f"With TVA            : {len(with_tva):,}")
print(f"Without TVA         : {len(without_tva):,}")
print(f"Duplicates removed  : {before - after:,}")

print("\nFiles created:")
print(with_tva_file)
print(without_tva_file)
