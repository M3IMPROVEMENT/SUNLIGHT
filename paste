from pathlib import Path
from openpyxl import load_workbook


# ============================================================
# INPUT FILE
# ============================================================

INPUT_FILE = Path(
    r"C:\Users\Sunlight\Desktop\15-09-26\MERIAME15_9\Nouveau dossier\YOUR_FILE.xlsx"
)


# ============================================================
# PHONE COLUMNS
# ============================================================

PHONE_COLUMNS = [
    "GSM",
    "TEL1",
    "TEL2",
    "TEL3"
]


# ============================================================
# OPEN FILE
# ============================================================

wb = load_workbook(
    INPUT_FILE,
    read_only=True,
    data_only=False
)

ws = wb.active


# ============================================================
# READ HEADER
# ============================================================

header = next(ws.iter_rows(values_only=True))

header_map = {
    str(value).strip().upper(): index
    for index, value in enumerate(header)
    if value is not None
}


# ============================================================
# CHECK COLUMNS
# ============================================================

for column in PHONE_COLUMNS:

    if column.upper() not in header_map:
        print(f"❌ Column not found: {column}")


# ============================================================
# COUNT EACH COLUMN
# ============================================================

counts = {
    "GSM": 0,
    "TEL1": 0,
    "TEL2": 0,
    "TEL3": 0
}


for row in ws.iter_rows(
    min_row=2,
    values_only=True
):

    for column in PHONE_COLUMNS:

        value = row[header_map[column.upper()]]

        # Count every non-empty cell
        if value is not None and value != "":
            counts[column] += 1


# ============================================================
# RESULT
# ============================================================

print()
print("=" * 60)
print("PHONE COUNTS READ BY PYTHON")
print("=" * 60)

for column in PHONE_COLUMNS:
    print(f"{column:<10}: {counts[column]:,}")

total = sum(counts.values())

print("-" * 60)
print(f"TOTAL      : {total:,}")
print("=" * 60)

wb.close()
