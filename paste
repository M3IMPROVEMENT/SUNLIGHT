import pandas as pd
from pathlib import Path

# ==========================
# FOLDER CONTAINING YOUR FILES
# ==========================
folder = Path(r"C:\YOUR\FOLDER\PATH")

# Find Excel files
files = list(folder.glob("*.xlsx")) + list(folder.glob("*.xls"))

print(f"Found {len(files)} Excel files\n")

# ==========================
# CHECK EACH FILE
# ==========================
found = False

for file in files:
    try:
        # Read only the header
        df = pd.read_excel(file, nrows=0)

        # Clean column names
        columns = df.columns.astype(str).str.strip()

        # Find duplicated column names
        duplicates = columns[columns.duplicated()].unique().tolist()

        if duplicates:
            found = True

            print("=" * 70)
            print("DUPLICATE COLUMNS FOUND")
            print("File:", file.name)
            print("Path:", file)
            print("Duplicated columns:", duplicates)
            print("=" * 70)

    except Exception as e:
        print(f"ERROR reading: {file.name}")
        print(e)

# ==========================
# FINAL RESULT
# ==========================
if not found:
    print("\n✅ No duplicate column names found in any Excel file.")
else:
    print("\n⚠️ Duplicate columns were found. Check the files listed above.")
