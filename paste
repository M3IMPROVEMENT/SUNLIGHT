import pandas as pd
from pathlib import Path

# ==============================
# 1. YOUR FILE
# ==============================

input_file = r"C:\Users\YOUR_NAME\Desktop\your_file.xlsx"

# ==============================
# 2. READ EXCEL
# ==============================

df = pd.read_excel(input_file, dtype=str)

# ==============================
# 3. CHECK EVERY CELL
# ==============================

results = []

for index, row in df.iterrows():

    excel_row = index + 2  # Excel header = row 1

    for column in df.columns:

        value = row[column]

        if pd.isna(value):
            continue

        value = str(value).strip()

        if value == "":
            continue

        # Remove spaces
        check = value.replace(" ", "")

        # ONLY NUMBERS
        if check.isdigit():

            results.append({
                "Excel_Row": excel_row,
                "Column": column,
                "Value": value,
                "Type": "NUMBERS"
            })

        # CONTAINS LETTERS / CHARACTERS
        elif any(c.isalpha() for c in check):

            results.append({
                "Excel_Row": excel_row,
                "Column": column,
                "Value": value,
                "Type": "CHARACTERS"
            })

# ==============================
# 4. SAVE REPORT
# ==============================

report = pd.DataFrame(results)

output_file = Path(input_file).with_name(
    Path(input_file).stem + "_CHECK.xlsx"
)

report.to_excel(output_file, index=False)

print("================================")
print("CHECK FINISHED")
print("================================")
print("Total detected cells:", len(report))
print("Report:", output_file)
