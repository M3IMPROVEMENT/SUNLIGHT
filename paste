from pathlib import Path
from openpyxl import load_workbook, Workbook


# ============================================================
# CONFIGURATION
# ============================================================

# Folder containing your Excel files
INPUT_FOLDER = Path(r"C:\Users\Sunlight\Desktop\01-10-26\ALL DB\excel_data-PC1_TR")

# Folder where merged files will be saved
OUTPUT_FOLDER = Path(r"C:\Users\Sunlight\Desktop\01-10-26\ALL DB\excel_data-PC1_TR\GSM\MERGED_OUTPUT")

# Maximum DATA rows per output file
MAX_ROWS = 1_000_000


# ============================================================
# CREATE OUTPUT FOLDER
# ============================================================

OUTPUT_FOLDER.mkdir(parents=True, exist_ok=True)


# ============================================================
# GET ALL EXCEL FILES
# ============================================================

excel_files = sorted(
    [
        f for f in INPUT_FOLDER.iterdir()
        if f.is_file()
        and f.suffix.lower() == ".xlsx"
        and not f.name.startswith("~$")
    ]
)


print("=" * 70)
print("EXCEL MERGE")
print("=" * 70)

print(f"Excel files found: {len(excel_files):,}")
print()


# ============================================================
# VARIABLES
# ============================================================

output_number = 0
rows_in_output = 0
total_rows = 0

output_wb = None
output_ws = None
output_path = None


# ============================================================
# CREATE NEW OUTPUT FILE
# ============================================================

def create_output_file(headers):

    global output_number
    global rows_in_output
    global output_wb
    global output_ws
    global output_path

    # Save previous file
    if output_wb is not None:

        output_wb.save(output_path)
        output_wb.close()

        print(
            f"   ✓ Saved: {output_path.name} "
            f"({rows_in_output:,} rows)"
        )

    # New output number
    output_number += 1

    output_path = (
        OUTPUT_FOLDER
        / f"merged_{output_number:03d}.xlsx"
    )

    # Write-only workbook = much lower RAM usage
    output_wb = Workbook(write_only=True)

    output_ws = output_wb.create_sheet("Data")

    # Write header
    output_ws.append(headers)

    rows_in_output = 0

    print()
    print(
        f"📁 Creating {output_path.name}"
    )


# ============================================================
# PROCESS FILES
# ============================================================

for file_number, file_path in enumerate(
    excel_files,
    start=1
):

    print(
        f"[{file_number}/{len(excel_files)}] "
        f"{file_path.name}"
    )

    try:

        # Open source Excel file
        wb = load_workbook(
            file_path,
            read_only=True,
            data_only=True
        )

        ws = wb.active

        # ----------------------------------------------------
        # GET HEADER FROM FIRST ROW
        # ----------------------------------------------------

        rows = ws.iter_rows(
            values_only=True
        )

        try:
            headers = next(rows)

        except StopIteration:
            print("   ⚠ Empty file - skipped")
            wb.close()
            continue

        # ----------------------------------------------------
        # FIRST FILE / FIRST OUTPUT
        # ----------------------------------------------------

        if output_wb is None:

            create_output_file(headers)

        # ----------------------------------------------------
        # READ DATA
        # ----------------------------------------------------

        file_rows = 0

        for row in rows:

            # If current output reached 1 million rows,
            # create a new output file.
            if rows_in_output >= MAX_ROWS:

                create_output_file(headers)

            # Add row
            output_ws.append(row)

            rows_in_output += 1
            total_rows += 1
            file_rows += 1

        wb.close()

        print(
            f"   ✓ {file_rows:,} rows added"
        )

    except Exception as e:

        print()
        print(
            f"   ❌ ERROR: {file_path.name}"
        )
        print(
            f"      {e}"
        )
        print(
            "      Continuing with next file..."
        )


# ============================================================
# SAVE LAST FILE
# ============================================================

if output_wb is not None:

    output_wb.save(output_path)
    output_wb.close()

    print()
    print(
        f"   ✓ Saved: {output_path.name} "
        f"({rows_in_output:,} rows)"
    )


# ============================================================
# FINAL SUMMARY
# ============================================================

print()
print("=" * 70)
print("MERGE FINISHED")
print("=" * 70)

print(
    f"Input files:       {len(excel_files):,}"
)

print(
    f"Total rows:        {total_rows:,}"
)

print(
    f"Output files:      {output_number:,}"
)

print()
print(
    f"Output folder:"
)

print(
    OUTPUT_FOLDER
)

print()
print("=" * 70)
print("DONE")
print("=" * 70)
