import pandas as pd
from pathlib import Path

# Folder containing your Excel files
folder = Path(r"C:\Users\YOUR_NAME\Desktop\FILES")

COLUMN = "COMPLEMENT"

files_with_complement = []

for file in folder.glob("*.xlsx"):

    try:
        df = pd.read_excel(file, dtype=str)

        # Check if column exists
        if COLUMN not in df.columns:
            print(f"⚠️ {file.name} → COMPLEMENT column not found")
            continue

        # Find non-empty COMPLEMENT
        complement = df[COLUMN].fillna("").astype(str).str.strip()

        non_empty = complement != ""
        count = non_empty.sum()

        if count > 0:
            files_with_complement.append({
                "Fichier": file.name,
                "Chemin": str(file),
                "COMPLEMENT non vide": count
            })

            print(f"❌ {file.name} → {count} non-empty COMPLEMENT")

        else:
            print(f"✅ {file.name} → COMPLEMENT empty")

    except Exception as e:
        print(f"⚠️ Error with {file.name}: {e}")


# Save results
if files_with_complement:

    result = pd.DataFrame(files_with_complement)

    output = folder / "files_with_non_empty_COMPLEMENT.xlsx"
    result.to_excel(output, index=False)

    print("\n================================")
    print("FILES WITH NON-EMPTY COMPLEMENT")
    print("================================")
    print(result.to_string(index=False))

    print(f"\n📁 Saved to: {output}")

else:
    print("\n✅ All files have an empty COMPLEMENT column.")
