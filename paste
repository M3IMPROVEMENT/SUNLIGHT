        name = str(name).strip()

        if not name:
            continue

        kbo_names.setdefault(
            tva,
            []
        )

        if name not in kbo_names[tva]:
            kbo_names[tva].append(name)


# ============================================================
# 11. LOAD OFFICIAL ADDRESSES
# ============================================================

print("Reading KBO address.csv...")


kbo_addresses = {}


for chunk in pd.read_csv(
    address_file,
    dtype=str,
    chunksize=200000,
    low_memory=False
):

    if "EntityNumber" not in chunk.columns:
        continue

    chunk["_TVA_CHECK"] = (
        chunk["EntityNumber"]
        .apply(clean_tva)
    )

    chunk = chunk[
        chunk["_TVA_CHECK"].isin(
            valid_kbo_numbers
        )
    ]


    for _, row in chunk.iterrows():

        tva = row["_TVA_CHECK"]


        street_fr = row.get(
            "StreetFR",
            ""
        )

        street_nl = row.get(
            "StreetNL",
            ""
        )

        number = row.get(
            "HouseNumber",
            ""
        )

        box = row.get(
            "Box",
            ""
        )

        cp = row.get(
            "Zipcode",
            ""
        )

        city_fr = row.get(
            "MunicipalityFR",
            ""
        )

        city_nl = row.get(
            "MunicipalityNL",
            ""
        )


        def safe(v):
            if pd.isna(v):
                return ""
            return str(v).strip()


        addresses = []


        # French address
        address_fr = " ".join(
            filter(
                None,
                [
                    safe(street_fr),
                    safe(number),
                    safe(box),
                    safe(cp),
                    safe(city_fr)
                ]
            )
        )


        # Dutch address
        address_nl = " ".join(
            filter(
                None,
                [
                    safe(street_nl),
                    safe(number),
                    safe(box),
                    safe(cp),
                    safe(city_nl)
                ]
            )
        )


        if address_fr:
            addresses.append(
                address_fr
            )

        if (
            address_nl
            and
            address_nl != address_fr
        ):
            addresses.append(
                address_nl
            )


        kbo_addresses.setdefault(
            tva,
            []
        )


        for address in addresses:

            if address not in kbo_addresses[tva]:

                kbo_addresses[
                    tva
                ].append(address)


# ============================================================
# 12. SCORE EACH DUPLICATE ROW
# ============================================================

def best_name_score(
    company_name,
    official_names
):

    if not official_names:
        return 0

    return max(
        similarity(
            company_name,
            official
        )
        for official in official_names
    )


def build_local_address(row):

    parts = [
        row.get("ADRESSE", ""),
        row.get("NUMERO", ""),
        row.get("CP", ""),
        row.get("VILLE", "")
    ]

    clean_parts = []

    for value in parts:

        if pd.isna(value):
            continue

        value = str(value).strip()

        if value:
            clean_parts.append(value)

    return " ".join(
        clean_parts
    )


def best_address_score(
    local_address,
    official_addresses
):

    if not official_addresses:
        return 0

    return max(
        similarity(
            local_address,
            official
        )
        for official in official_addresses
    )


# ============================================================
# 13. GIVE EACH DUPLICATE A KBO SCORE
# ============================================================

df["_KBO_NAME_SCORE"] = 0.0
df["_KBO_ADDRESS_SCORE"] = 0.0
df["_KBO_TOTAL_SCORE"] = 0.0
df["_KBO_STATUS"] = ""


for index in duplicate_df.index:

    tva = df.at[
        index,
        "_TVA_CHECK"
    ]


    # TVA does not exist in current KBO Open Data
    if tva not in valid_kbo_numbers:

        df.at[
            index,
            "_KBO_STATUS"
        ] = "TVA NOT FOUND IN KBO"

        continue


    names = kbo_names.get(
        tva,
        []
    )

    addresses = kbo_addresses.get(
        tva,
        []
    )


    company_name = df.at[
        index,
        "STE"
    ]

    local_address = build_local_address(
        df.loc[index]
    )


    name_score = best_name_score(
        company_name,
        names
    )


    address_score = best_address_score(
        local_address,
        addresses
    )


    # --------------------------------------------
    # SCORE
    #
    # Company name = 60%
    # Address      = 40%
    # --------------------------------------------

    total_score = (
        name_score * 0.60
        +
        address_score * 0.40
    )


    df.at[
        index,
        "_KBO_NAME_SCORE"
    ] = round(
        name_score,
        2
    )


    df.at[
        index,
        "_KBO_ADDRESS_SCORE"
    ] = round(
        address_score,
        2
    )


    df.at[
        index,
        "_KBO_TOTAL_SCORE"
    ] = round(
        total_score,
        2
    )


    df.at[
        index,
        "_KBO_STATUS"
    ] = "FOUND IN KBO"


# ============================================================
# 14. DECIDE WHICH ROW TO KEEP
# ============================================================

rows_to_remove = []

rows_to_review = []


for tva, group in df[
    duplicate_mask
].groupby(
    "_TVA_CHECK"
):


    # --------------------------------------------
    # TVA not found in KBO
    #
    # DO NOT DELETE automatically
    # --------------------------------------------

    if tva not in valid_kbo_numbers:

        rows_to_review.extend(
            group.index.tolist()
        )

        continue


    # --------------------------------------------
    # Sort duplicate rows by KBO score
    # --------------------------------------------

    sorted_group = group.sort_values(
        "_KBO_TOTAL_SCORE",
        ascending=False
    )


    best_index = sorted_group.index[0]

    best_score = df.at[
        best_index,
        "_KBO_TOTAL_SCORE"
    ]


    # --------------------------------------------
    # Safety:
    #
    # If KBO comparison is too weak,
    # DO NOT automatically delete.
    # --------------------------------------------

    if best_score < 40:

        rows_to_review.extend(
            group.index.tolist()
        )

        continue


    # --------------------------------------------
    # Keep best row.
    # Remove the others.
    # --------------------------------------------

    other_indices = [
        idx
        for idx in group.index
        if idx != best_index
    ]


    rows_to_remove.extend(
        other_indices
    )


