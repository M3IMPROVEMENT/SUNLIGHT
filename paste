
from pathlib import Path
import pandas as pd

# ================= CONFIGURATION =================

FOLDER = Path(r"C:\Users\Sunlight\Desktop\NET\B2B")

OUTPUT_FILE = FOLDER / "merged_4_files.xlsx"

# ================= FIND 4 FILES =================

excel_files = sorted(
    [
        f for f in FOLDER.glob("*.xlsx")
        if f.name != OUTPUT_FILE.name
        and not f.name.startswith("~$")
    ]
)[:4]

if len(excel_files) != 4:
    raise ValueError(
        f"Expected 4 Excel files, found {len(excel_files)}"
    )

print("Files selected:")
for file in excel_files:
    print(" -", file.name)

# ================= MERGE =================

dataframes = []

for file in excel_files:
    df = pd.read_excel(file, dtype=str)
    df.columns = df.columns.astype(str).str.strip()
    df["source"] = file.name

    dataframes.append(df)
    print(f"Read {file.name}: {len(df):,} rows")

merged = pd.concat(
    dataframes,
    ignore_index=True,
    sort=False
)

# ================= SAVE =================

merged.to_excel(
    OUTPUT_FILE,
    index=False,
    engine="openpyxl"
)

print("\n========== FINISHED ==========")
print(f"Files merged: {len(excel_files)}")
print(f"Total rows: {len(merged):,}")
print(f"Saved to: {OUTPUT_FILE}")
