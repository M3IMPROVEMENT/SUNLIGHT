import pandas as pd
from pathlib import Path

# ==========================================
# FOLDER CONTAINING YOUR EXCEL FILES
# ==========================================

folder_path = Path(r"C:\PUT\YOUR\FOLDER\PATH\HERE")

# Find Excel files
files = list(folder_path.rglob("*.xlsx")) + list(folder_path.rglob("*.xls"))

print(f"Total Excel files found: {len(files)}")
print("=" * 80)

files_with_duplicates = []

# ==========================================
# CHECK EACH FILE
# ==========================================

for file in files:
    try:
        # Read ONLY the headers
        df = pd.read_excel(file, nrows=0)

        # Clean spaces from column names
        columns = df.columns.astype(str).str.strip()

        # Find duplicated column names
        duplicated_columns = columns[columns.duplicated()].unique().tolist()

        if duplicated_columns:
            files_with_duplicates.append({
                "File": file.name,
                "Full Path": str(file),
                "Duplicate Columns": ", ".join(duplicated_columns)
            })

            print(f"\n❌ DUPLICATE COLUMNS FOUND")
            print(f"File: {file.name}")
            print(f"Duplicate column(s): {duplicated_columns}")

    except Exception as e:
        print(f"\n⚠️ ERROR reading file: {file.name}")
        print(f"Error: {e}")


# ==========================================
# FINAL RESULT
# ==========================================

print("\n" + "=" * 80)

if files_with_duplicates:
    print(f"❌ {len(files_with_duplicates)} FILE(S) HAVE DUPLICATE COLUMN NAMES")

    result = pd.DataFrame(files_with_duplicates)

    # Save the result so you can easily find the files
    output_file = folder_path / "FILES_WITH_DUPLICATE_COLUMNS.xlsx"
    result.to_excel(output_file, index=False)

    print(f"\n✅ Report saved here:")
    print(output_file)

else:
    print("✅ NO DUPLICATE COLUMN NAMES FOUND!")
