from pathlib import Path
import zipfile
import shutil
import os

# ============================================================
# PATHS
# ============================================================

ZIP_FILE = Path(
    r"C:\Users\Sunlight\Downloads\KboOpenData_0485_2026_09_17_Full.zip"
)

WORK_DIR = ZIP_FILE.parent / "KBO_0485_WORK"
EXTRACT_DIR = WORK_DIR / "data"

# ============================================================
# CHECK ZIP
# ============================================================

if not ZIP_FILE.exists():
    raise FileNotFoundError(
        f"ZIP file not found:\n{ZIP_FILE}"
    )

print("ZIP found:")
print(ZIP_FILE)

# ============================================================
# EXTRACT
# ============================================================

if EXTRACT_DIR.exists():
    print("\nExtraction folder already exists.")
else:
    EXTRACT_DIR.mkdir(parents=True, exist_ok=True)

    print("\nExtracting ZIP...")

    with zipfile.ZipFile(ZIP_FILE, "r") as z:
        z.extractall(EXTRACT_DIR)

    print("Extraction completed.")

# ============================================================
# SHOW FILES
# ============================================================

print("\nFiles found:")

for file in EXTRACT_DIR.rglob("*"):
    if file.is_file():
        print(file)

print("\nDone.")
