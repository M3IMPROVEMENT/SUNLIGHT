import pandas as pd
from pathlib import Path
import re

# ==============================
# FILE
# ==============================
file = Path(r"C:\Users\YOUR_NAME\Desktop\your_file.xlsx")

# ==============================
# READ FILE
# ==============================
df = pd.read_excel(file, dtype=str)

# ==============================
# CLEAN TELE
# ==============================
def clean_tele(value):

    if pd.isna(value):
        return ""

    value = str(value).strip()

    if value == "":
        return ""

    # Remove .0 coming from Excel
    value = re.sub(r"\.0$", "", value)

    # Keep only digits
    value = re.sub(r"\D", "", value)

    # Remove Belgian international prefixes
    if value.startswith("0032"):
        value = value[4:]

    elif value.startswith("32"):
        value = value[2:]

    # Add 0 back for Belgian numbers
    if value and not value.startswith("0"):
        value = "0" + value

    return value


df["TELE"] = df["TELE"].apply(clean_tele)

# ==============================
# SAVE
# ==============================
output = file.parent / "TELE_cleaned.xlsx"

df.to_excel(output, index=False)

print("✅ TELE cleaning finished.")
print(f"📁 Saved: {output}")
